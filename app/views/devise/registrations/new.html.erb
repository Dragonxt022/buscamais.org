<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Cadastro - Busca Mais</title>
  <%= csrf_meta_tags %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-indigo-50 flex flex-col">

  <div class="p-6">
    <%= link_to root_path, class: "inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-800 font-medium tracking-wider" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      VOLTAR PARA O INÍCIO
    <% end %>
  </div>

  <div class="flex-1 flex flex-col items-center justify-center px-4 pb-16">
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold">
        <span class="text-gray-900">Busca</span>
        <span class="text-blue-600">Mais</span><span class="text-blue-600 text-base align-super">®</span>
      </h1>
      <p class="text-gray-500 mt-2 text-sm">Crie sua conta e comece a acompanhar as melhores notícias.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 w-full max-w-md p-8">
      <h2 class="text-2xl font-bold text-gray-900 text-center mb-7">Criar Conta</h2>

      <% google_configurado = SiteSetting["google_client_id"].present? && SiteSetting["google_client_secret"].present? %>
      <% if google_configurado %>
        <%= button_to user_google_oauth2_omniauth_authorize_path,
            form: { "data-turbo": "false" },
            class: "w-full flex items-center justify-center gap-2.5 border border-gray-300 rounded-lg py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50 active:bg-gray-100 transition-colors mb-5" do %>
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Cadastrar com Google
        <% end %>

        <div class="relative my-5">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-gray-200"></div>
          </div>
          <div class="relative flex justify-center">
            <span class="px-3 bg-white text-sm text-gray-400">Ou preencha o formulário</span>
          </div>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="mb-5">
          <%= f.label :nome, "NOME COMPLETO",
              class: "block text-xs font-semibold text-gray-500 tracking-wider mb-1.5" %>
          <%= f.text_field :nome, autofocus: true,
              placeholder: "Seu nome completo", class: "input" %>
        </div>

        <div class="mb-5">
          <%= f.label :email, "ENDEREÇO DE E-MAIL",
              class: "block text-xs font-semibold text-gray-500 tracking-wider mb-1.5" %>
          <%= f.email_field :email, autocomplete: "email",
              placeholder: "nome@exemplo.com", class: "input" %>
        </div>

        <div class="mb-5">
          <label class="block text-xs font-semibold text-gray-500 tracking-wider mb-1.5">SENHA
            <% if @minimum_password_length %>
              <span class="font-normal normal-case text-gray-400">(mínimo <%= @minimum_password_length %> caracteres)</span>
            <% end %>
          </label>
          <%= f.password_field :password, autocomplete: "new-password",
              placeholder: "Crie uma senha segura", class: "input" %>
        </div>

        <div class="mb-6">
          <%= f.label :password_confirmation, "CONFIRMAR SENHA",
              class: "block text-xs font-semibold text-gray-500 tracking-wider mb-1.5" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              placeholder: "Repita a senha", class: "input" %>
        </div>

        <%# Honeypot anti-spam — invisível para humanos, bots preenchem automaticamente %>
        <%= invisible_captcha :website %>

        <%= f.submit "CRIAR MINHA CONTA →",
            class: "w-full bg-blue-600 text-white py-3 rounded-lg font-bold text-sm tracking-wider hover:bg-blue-700 transition-colors cursor-pointer" %>
      <% end %>
    </div>

    <p class="mt-6 text-sm text-gray-600">
      Já tem uma conta?
      <%= link_to "Entrar no Busca Mais", new_user_session_path,
          class: "text-blue-600 font-semibold hover:underline" %>
    </p>
  </div>
</body>
</html>
