<% content_for :page_title, "Biblioteca de Mídia" %>
<% content_for :page_subtitle, "Envie e gerencie imagens e arquivos para seus artigos." %>

<div class="flex justify-end mb-4">
  <%= link_to editor_albuns_path, class: "btn-secondary flex items-center gap-2 text-sm" do %>
    <%= lucide_icon "folder", css: "w-4 h-4" %>
    Gerenciar Álbuns
  <% end %>
</div>

<div class="card">
  <%= render "shared/midias_galeria", midias: @midias, pagy: @pagy, ns: "editor", albuns: @albuns %>
</div>
