<% content_for :page_title, "Gerar Matéria com IA" %>

<div class="max-w-3xl">
  <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 mb-6 flex items-start gap-3">
    <%= lucide_icon "sparkles", css: "w-5 h-5 text-blue-600 shrink-0 mt-0.5" %>
    <p class="text-sm text-blue-800 leading-relaxed">
      Descreva o assunto e o ângulo da matéria. A IA escreve o texto completo (título, resumo, conteúdo e tags sugeridas)
      e salva como <strong>rascunho</strong> — a geração roda em segundo plano e você recebe uma notificação quando
      estiver pronta. Depois é só revisar, adicionar a imagem de capa e publicar.
    </p>
  </div>

  <%= form_with url: editor_gerador_ia_path, method: :post, class: "space-y-5" do |f| %>
    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 space-y-5">
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Assunto *</label>
        <p class="text-xs text-gray-400 mb-2">Sobre o que é a matéria — quanto mais específico, melhor o resultado.</p>
        <textarea name="assunto" rows="3" required
                  placeholder="Ex.: Prefeitura de Cujubim abre inscrições para curso profissionalizante gratuito de eletricista, com vagas para maiores de 18 anos"
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"></textarea>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Ângulo / enfoque</label>
        <p class="text-xs text-gray-400 mb-2">Opcional. Que direção a matéria deve seguir, o que priorizar.</p>
        <textarea name="rumo" rows="2"
                  placeholder="Ex.: Focar em quem pode se inscrever, prazos e o que o curso oferece na prática para quem quer entrar no mercado de trabalho"
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"></textarea>
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Categoria principal *</label>
          <select name="categoria_id" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none">
            <option value="">Selecione...</option>
            <% @categorias.each do |cat| %>
              <option value="<%= cat.id %>"><%= cat.nome %></option>
            <% end %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Tamanho</label>
          <select name="tamanho" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none">
            <option value="curto">Curto (~600-900 palavras)</option>
            <option value="medio" selected>Médio (~1000-1600 palavras)</option>
            <option value="longo">Longo (~1800-2800 palavras)</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1.5">Categorias adicionais</label>
        <div class="flex flex-wrap gap-1.5">
          <% @categorias.each do |cat| %>
            <label class="flex items-center gap-1.5 text-xs border border-gray-200 rounded-full px-2.5 py-1 cursor-pointer hover:border-blue-400 has-[:checked]:bg-blue-50 has-[:checked]:border-blue-400 has-[:checked]:text-blue-700">
              <input type="checkbox" name="categorias_extra_ids[]" value="<%= cat.id %>" class="w-3.5 h-3.5">
              <%= cat.nome %>
            </label>
          <% end %>
        </div>
      </div>

      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1.5">Dados de referência</label>
        <p class="text-xs text-gray-400 mb-2">
          Opcional, mas recomendado. A IA <strong>não acessa a internet</strong> — cole aqui qualquer informação real que você já tem
          (texto de comunicado oficial, edital, anotações de apuração, links). Quando preenchido, a IA só usa fatos específicos
          (datas, números, nomes) que estiverem aqui, em vez de generalizar.
        </p>
        <textarea name="dados_referencia" rows="5"
                  placeholder="Cole aqui o texto do comunicado, edital, ou as informações que você apurou..."
                  class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none font-mono text-xs"></textarea>
      </div>

      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Tags sugeridas</label>
          <input type="text" name="tags_sugeridas" placeholder="Ex.: Cujubim, Emprego, Cursos"
                 class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <p class="text-xs text-gray-400 mt-1">Opcional — a IA pode sugerir as próprias tags também.</p>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 mb-1">Palavra-chave de foco</label>
          <input type="text" name="palavra_chave_foco" placeholder="Ex.: curso de eletricista Cujubim"
                 class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <p class="text-xs text-gray-400 mt-1">Opcional — usada na Análise de SEO do rascunho gerado.</p>
        </div>
      </div>
    </div>

    <div class="flex gap-3">
      <%= f.submit "Gerar Matéria", class: "flex-1 sm:flex-none bg-blue-600 text-white py-2.5 px-6 rounded-lg text-sm font-semibold hover:bg-blue-700 cursor-pointer flex items-center justify-center gap-2" %>
      <%= link_to "Cancelar", editor_artigos_path, class: "text-center border border-gray-300 text-gray-700 py-2.5 px-6 rounded-lg text-sm hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
