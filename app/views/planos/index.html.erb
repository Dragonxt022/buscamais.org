<% content_for :title, "Planos e Preços — #{SiteSetting['site_titulo'] || 'Busca Mais'}" %>
<% content_for :meta_description, "Escolha o plano ideal para você e tenha acesso a todos os recursos do portal." %>

<div class="max-w-5xl mx-auto px-4 py-12">
  <%# Header %>
  <div class="text-center mb-12">
    <h1 class="text-4xl font-black text-gray-900 mb-3">Escolha seu Plano</h1>
    <p class="text-lg text-gray-500">Acesse o jornalismo de qualidade no nível certo para você.</p>
  </div>

  <%# Banner promocional global — aparece se algum plano tem promo ativa %>
  <% plano_com_promo = @planos.find { |p| p.promocao_visivel? && (!user_signed_in? || p.elegivel_para_promocao?(current_user)) } %>
  <% if plano_com_promo %>
    <div class="mb-8 bg-gradient-to-r from-orange-500 to-amber-500 text-white rounded-2xl px-6 py-4 flex flex-col sm:flex-row items-start sm:items-center gap-3">
      <div class="text-2xl shrink-0">🏷</div>
      <div class="flex-1">
        <p class="font-black text-base">Oferta especial de lançamento!</p>
        <p class="text-sm text-orange-100">
          Assine o <strong><%= plano_com_promo.nome %></strong> por apenas
          <strong><%= plano_com_promo.preco_promo_formatado %></strong>
          pelos primeiros <strong><%= plano_com_promo.meses_promocionais %> meses</strong>.
          Após esse período, <%= plano_com_promo.preco_formatado %> automaticamente.
          <% if plano_com_promo.apenas_novos_usuarios? %>
            <span class="text-orange-200">· Apenas para novos assinantes.</span>
          <% end %>
        </p>
      </div>
    </div>
  <% end %>

  <%# Cards %>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
    <% @planos.each do |plano| %>
      <% cores    = plano.cor_classes %>
      <% is_atual = @plano_atual&.slug == plano.slug %>
      <% tem_promo = plano.promocao_visivel? && (!user_signed_in? || plano.elegivel_para_promocao?(current_user)) %>

      <div class="relative bg-white rounded-2xl border shadow-sm flex flex-col overflow-hidden
                  <%= plano.destaque? ? "ring-2 #{cores[:ring] || 'ring-blue-300'} shadow-lg scale-105" : 'border-gray-200' %>">

        <% if plano.destaque? && !tem_promo %>
          <div class="<%= cores[:badge] || 'bg-blue-600' %> text-white text-xs font-bold text-center py-2 uppercase tracking-widest">
            ★ Mais Popular
          </div>
        <% end %>

        <% if tem_promo %>
          <div class="bg-gradient-to-r from-orange-500 to-amber-500 text-white text-xs font-bold text-center py-2 uppercase tracking-widest">
            🏷 Oferta Especial
          </div>
        <% end %>

        <div class="p-7 flex-1 flex flex-col">
          <%# Nome e preço %>
          <div class="mb-6">
            <h2 class="text-xl font-black text-gray-900 mb-1"><%= plano.nome %></h2>
            <p class="text-sm text-gray-500 mb-4"><%= plano.descricao %></p>

            <% if tem_promo %>
              <%# Preço promocional com preço normal tachado %>
              <div class="flex items-end gap-2 mb-1">
                <span class="text-4xl font-black text-orange-500">
                  R$ <%= format('%.2f', plano.preco_promocional).gsub('.', ',') %>
                </span>
                <span class="text-sm text-gray-400 mb-1.5">/mês</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-sm text-gray-400 line-through">
                  <%= plano.preco_formatado %>
                </span>
                <span class="text-xs font-bold text-orange-600 bg-orange-50 px-2 py-0.5 rounded-full">
                  pelos primeiros <%= plano.meses_promocionais %> meses
                </span>
              </div>
              <p class="text-xs text-gray-400 mt-1">
                Depois: <%= plano.preco_formatado %> (renovação automática)
              </p>
            <% else %>
              <div class="flex items-end gap-1">
                <span class="text-4xl font-black <%= cores[:text] || 'text-blue-700' %>">
                  <%= plano.gratuito? ? "Grátis" : "R$ #{format('%.2f', plano.preco).gsub('.', ',')}" %>
                </span>
                <% unless plano.gratuito? %>
                  <span class="text-sm text-gray-400 mb-1.5">/mês</span>
                <% end %>
              </div>
            <% end %>
          </div>

          <%# Benefícios %>
          <ul class="space-y-2 flex-1 mb-7">
            <% plano.beneficios.each do |b| %>
              <li class="flex items-start gap-2.5 text-sm text-gray-700">
                <svg class="w-4 h-4 <%= tem_promo ? 'text-orange-500' : (cores[:text] || 'text-blue-500') %> mt-0.5 shrink-0"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                <%= b %>
              </li>
            <% end %>
          </ul>

          <%# CTA %>
          <% if is_atual %>
            <div class="w-full text-center py-2.5 rounded-xl bg-gray-100 text-gray-500 text-sm font-semibold">
              Plano atual
            </div>
          <% elsif user_signed_in? %>
            <% if plano.gratuito? %>
              <div class="w-full text-center py-2.5 rounded-xl bg-gray-100 text-gray-500 text-sm font-semibold">
                Disponível gratuitamente
              </div>
            <% else %>
              <%= button_to checkout_usuario_assinatura_path(plan_id: plano.id),
                  method: :post, data: { turbo: false },
                  class: "w-full py-3 rounded-xl text-white text-sm font-bold transition-colors #{tem_promo ? 'bg-gradient-to-r from-orange-500 to-amber-500 hover:opacity-90 shadow-sm' : plano.destaque? ? (cores[:badge] || 'bg-blue-600') + ' hover:opacity-90' : 'bg-gray-800 hover:bg-gray-700'}" do %>
                <%= tem_promo ? "Aproveitar oferta →" : "Assinar #{plano.nome}" %>
              <% end %>
            <% end %>
          <% else %>
            <%= link_to plano.gratuito? ? new_user_registration_path : new_user_session_path,
                class: "block w-full text-center py-3 rounded-xl text-white text-sm font-bold transition-colors #{tem_promo ? 'bg-gradient-to-r from-orange-500 to-amber-500 hover:opacity-90' : plano.destaque? ? (cores[:badge] || 'bg-blue-600') + ' hover:opacity-90' : 'bg-gray-800 hover:bg-gray-700'}" do %>
              <%= plano.gratuito? ? "Criar conta grátis" : (tem_promo ? "Aproveitar oferta →" : "Começar agora") %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-12 text-center text-sm text-gray-400">
    Cancelamento a qualquer momento, sem multa. ·
    <%= link_to "Dúvidas? Fale conosco", contato_path, class: "text-blue-600 hover:underline" %>
  </div>
</div>

<%# ── Exit-intent modal (desktop only) ── %>
<% _plano_destaque = @planos.find { |p| p.destaque? && !p.gratuito? } || @planos.reject(&:gratuito?).first %>
<% _tem_promo_exit = _plano_destaque&.promocao_visivel? && (!user_signed_in? || _plano_destaque&.elegivel_para_promocao?(current_user)) %>
<% _preco_exit = _tem_promo_exit ? format('%.2f', _plano_destaque&.preco_promocional).gsub('.', ',') : format('%.2f', _plano_destaque&.preco.to_f).gsub('.', ',') if _plano_destaque %>

<div id="exit-intent-overlay"
     class="hidden fixed inset-0 z-[9999] flex items-center justify-center p-6"
     style="background: rgba(0,0,0,0.6); backdrop-filter: blur(3px)">

  <div id="exit-intent-modal"
       class="relative w-full max-w-[460px] bg-white rounded-2xl overflow-hidden"
       style="box-shadow: 0 25px 60px rgba(0,0,0,0.25); animation: exitModalIn 0.35s cubic-bezier(0.22,1,0.36,1)">

    <%# Botão fechar discreto %>
    <button id="exit-intent-dismiss"
            class="absolute top-4 right-4 z-10 w-8 h-8 flex items-center justify-center rounded-full text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition-colors"
            aria-label="Fechar">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <%# Topo — identidade visual do portal %>
    <div class="px-8 pt-8 pb-6 border-b border-gray-100 text-center">
      <%# Logo ou nome do portal %>
      <% _branding_exit = SiteBranding.instance rescue nil %>
      <div class="flex justify-center mb-5">
        <% if _branding_exit&.logo&.attached? %>
          <img src="<%= _branding_exit.logo_url %>" alt="Logo" class="h-8 w-auto object-contain">
        <% else %>
          <span class="text-lg font-black text-gray-900">
            <%= SiteSetting['site_titulo'] || 'Busca Mais' %>
          </span>
        <% end %>
      </div>

      <h2 class="text-[22px] font-bold text-gray-900 leading-snug mb-2">
        Continue bem informado.<br>
        <span class="text-blue-600">Sem paywall. Sem anúncios.</span>
      </h2>
      <p class="text-sm text-gray-500 leading-relaxed">
        Milhares de leitores confiam no <%= SiteSetting['site_titulo'] || 'Busca Mais' %> para se manter atualizados.<br>
        Sua assinatura mantém esse jornalismo vivo e independente.
      </p>
    </div>

    <%# Benefícios — lista limpa com checks %>
    <div class="px-8 py-5">
      <ul class="space-y-3">
        <% [
          "Acesso ilimitado a todos os artigos, sem paywall",
          "Experiência completamente sem anúncios",
          "Apoio ao jornalismo local e independente",
          "Comentários com destaque e sem fila de moderação",
        ].each do |b| %>
          <li class="flex items-start gap-3 text-sm text-gray-700">
            <svg class="w-5 h-5 text-blue-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
            </svg>
            <%= b %>
          </li>
        <% end %>
      </ul>
    </div>

    <%# CTA principal %>
    <div class="px-8 pb-7 space-y-3">
      <% if _plano_destaque %>
        <% if user_signed_in? %>
          <%= button_to checkout_usuario_assinatura_path(plan_id: _plano_destaque.id), method: :post,
              data: { turbo: false },
              class: "w-full py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm transition-colors shadow-sm" do %>
            Assinar por R$ <%= _preco_exit %>/mês →
          <% end %>
        <% else %>
          <%= link_to "Assinar por R$ #{_preco_exit}/mês →", new_user_session_path,
              class: "block w-full text-center py-3.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-sm transition-colors shadow-sm" %>
        <% end %>
        <% if _tem_promo_exit %>
          <p class="text-center text-xs text-orange-600 font-medium">
            🏷 Oferta especial: primeiros <%= _plano_destaque.meses_promocionais %> meses por R$ <%= _preco_exit %> · depois <%= _plano_destaque.preco_formatado %>
          </p>
        <% end %>
      <% end %>

      <%# Confiança %>
      <div class="flex items-center justify-center gap-4 pt-1">
        <span class="flex items-center gap-1.5 text-xs text-gray-400">
          <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          Pagamento seguro
        </span>
        <span class="text-gray-200">·</span>
        <span class="text-xs text-gray-400">Cancele a qualquer momento</span>
        <span class="text-gray-200">·</span>
        <span class="text-xs text-gray-400">Sem contratos</span>
      </div>

      <%# Dismiss %>
      <div class="text-center pt-2">
        <button type="button" id="exit-intent-dismiss-2"
                class="text-xs text-gray-400 hover:text-gray-600 transition-colors">
          Não, obrigado — continuar sem assinar
        </button>
      </div>
    </div>

  </div>
</div>

<style>
  @keyframes exitModalIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
(function() {
  // Apenas desktop
  if (window.innerWidth < 1024) return;

  // Não repetir na mesma sessão
  if (sessionStorage.getItem('exitIntentShown')) return;

  var overlay  = document.getElementById('exit-intent-overlay');
  var dismiss  = document.getElementById('exit-intent-dismiss');
  var dismiss2 = document.getElementById('exit-intent-dismiss-2');
  var fired    = false;
  var delay    = null;

  function show() {
    if (fired) return;
    fired = true;
    sessionStorage.setItem('exitIntentShown', '1');
    overlay.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function hide() {
    overlay.classList.add('hidden');
    document.body.style.overflow = '';
  }

  // Trigger: mouse sai pelo topo da janela (dentro dos primeiros 10px)
  document.addEventListener('mouseleave', function(e) {
    if (e.clientY <= 5) {
      // Pequeno delay para evitar falso positivo em scroll rápido
      delay = setTimeout(show, 200);
    }
  });

  document.addEventListener('mouseenter', function() {
    clearTimeout(delay);
  });

  // Fechar ao clicar no backdrop
  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) hide();
  });

  // Fechar ao clicar nos botões de dismiss
  if (dismiss)  dismiss.addEventListener('click', hide);
  if (dismiss2) dismiss2.addEventListener('click', hide);

  // Fechar com Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') hide();
  });

  // Após 45 segundos na página, mostrar mesmo sem exit-intent (se não mostrou ainda)
  setTimeout(function() {
    if (!fired) show();
  }, 45000);
})();
</script>
