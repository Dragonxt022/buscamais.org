<nav class="bg-white border-b border-gray-200 sticky top-0 z-40 relative"
     data-controller="mega-menu navbar hero-navbar">

  <%# ── Top bar ── %>
  <div class="nav-topbar max-w-7xl mx-auto px-4 flex items-center justify-between h-14">

    <%# Logo %>
    <div class="flex items-center gap-8">
      <% _branding_nav = SiteBranding.instance rescue nil %>
      <%= link_to root_path, class: "flex-shrink-0 hover:opacity-80 transition-opacity" do %>
        <% if _branding_nav&.logo&.attached? %>
          <img src="<%= _branding_nav.logo_url %>" alt="Logo" class="h-9 w-auto object-contain">
        <% else %>
          <span class="nav-logo-dark text-xl font-bold text-gray-900">Busca</span><span class="nav-logo-accent text-xl font-bold text-blue-600">Mais</span><span class="nav-logo-accent text-blue-600 text-xs align-super">®</span>
        <% end %>
      <% end %>

      <%# Category triggers (desktop) %>
      <div class="hidden md:flex items-center gap-1">
        <%= link_to "Início", root_path,
            class: "text-sm text-gray-600 hover:text-blue-600 font-medium px-3 py-2 rounded-lg hover:bg-gray-50 transition-colors" %>

        <% @categorias_menu&.first(6)&.each do |item| %>
          <% cat = item.is_a?(Hash) ? item[:categoria] : item %>
          <%= link_to categoria_path(cat.slug),
              data: { category_id: cat.id, action: "mouseenter->mega-menu#show mouseleave->mega-menu#hide focus->mega-menu#show blur->mega-menu#hide" },
              class: "text-sm text-gray-600 hover:text-blue-600 px-3 py-2 rounded-lg hover:bg-gray-50 transition-colors flex items-center gap-1" do %>
            <%= cat.nome %>
            <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# Right side actions %>
    <div class="flex items-center gap-2 md:gap-3">
      <% if user_signed_in? %>
        <% if current_user.administrador? || current_user.editor? %>
          <%= link_to "Painel", current_user.administrador? ? admin_root_path : editor_root_path,
              class: "text-sm text-gray-600 hover:text-blue-600 hidden sm:inline" %>
        <% else %>
          <%= link_to "Minha Conta", usuario_root_path,
              class: "text-sm text-gray-600 hover:text-blue-600 hidden sm:inline" %>
        <% end %>

        <%# Notification bell %>
        <div class="relative" data-controller="notification" data-notification-target="wrapper">
          <button type="button"
                  data-action="click->notification#toggle"
                  data-notification-target="bell"
                  class="relative p-1.5 text-gray-500 hover:text-blue-600 transition-colors"
                  aria-label="Notificações">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
            </svg>
            <% if @notificacoes_nao_lidas_count.to_i > 0 %>
              <span class="absolute -top-0.5 -right-0.5 bg-red-500 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center leading-none">
                <%= @notificacoes_nao_lidas_count > 9 ? "9+" : @notificacoes_nao_lidas_count %>
              </span>
            <% end %>
          </button>

          <%# Dropdown panel %>
          <div data-notification-target="dropdown"
               class="hidden absolute right-0 top-full mt-2 w-80 bg-white rounded-xl shadow-xl border border-gray-100 z-50 overflow-hidden">
            <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100">
              <h4 class="text-sm font-bold text-gray-900">Notificações</h4>
              <% if @notificacoes_nao_lidas_count.to_i > 0 %>
                <%= button_to marcar_todas_lidas_usuario_notificacoes_path, method: :patch,
                    class: "text-xs text-blue-600 hover:text-blue-700 font-medium bg-transparent border-none cursor-pointer" do %>
                  Ler todas
                <% end %>
              <% end %>
            </div>
            <div class="max-h-72 overflow-y-auto">
              <% if @notificacoes_recentes&.any? %>
                <% @notificacoes_recentes.each do |n| %>
                  <a href="<%= n.link %>"
                     class="flex items-start gap-3 px-4 py-3 hover:bg-gray-50 transition-colors border-b border-gray-50 <%= n.lida? ? 'opacity-60' : '' %>">
                    <span class="text-lg shrink-0 mt-0.5"><%= n.icone %></span>
                    <div class="flex-1 min-w-0">
                      <p class="text-xs text-gray-800 leading-relaxed line-clamp-2"><%= n.mensagem %></p>
                      <p class="text-[11px] text-gray-400 mt-0.5"><%= time_ago_in_words(n.created_at) %> atrás</p>
                    </div>
                    <% unless n.lida? %>
                      <span class="w-2 h-2 rounded-full bg-blue-500 shrink-0 mt-1.5"></span>
                    <% end %>
                  </a>
                <% end %>
              <% else %>
                <div class="py-10 text-center">
                  <p class="text-sm text-gray-400">Nenhuma notificação</p>
                </div>
              <% end %>
            </div>
            <div class="px-4 py-2.5 border-t border-gray-100 text-center">
              <%= link_to "Ver todas as notificações →", usuario_notificacoes_path,
                  class: "text-xs text-blue-600 hover:text-blue-700 font-medium" %>
            </div>
          </div>
        </div>

        <%= button_to "Sair", destroy_user_session_path, method: :delete,
            class: "text-sm text-gray-500 hover:text-red-600 bg-transparent border-none cursor-pointer hidden sm:inline" %>
      <% else %>
        <%= link_to "Entrar", new_user_session_path,
            class: "text-sm text-gray-600 hover:text-blue-600 font-medium hidden sm:inline" %>
        <%= link_to "Cadastre-se", new_user_registration_path,
            class: "nav-btn-solid text-sm bg-blue-600 text-white px-4 py-1.5 rounded-lg hover:bg-blue-700 transition-colors hidden sm:inline" %>
      <% end %>

      <%# Busca expansível %>
      <%= form_with url: busca_path, method: :get, local: true, class: "flex items-center gap-1" do |f| %>
        <%= f.text_field :q,
            placeholder: "Buscar notícias...",
            "aria-label": "Buscar notícias",
            autocomplete: "off",
            class: "hidden w-44 text-sm bg-white/10 border-b border-current placeholder-current/60 outline-none px-2 py-0.5 transition-all",
            data: { navbar_target: "searchInput", action: "keydown->navbar#searchKeydown" } %>
        <button type="button"
                data-action="click->navbar#toggleSearch"
                class="p-1.5 text-gray-500 hover:text-gray-800"
                aria-label="Abrir busca">
          <svg data-navbar-target="searchIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/>
          </svg>
          <svg data-navbar-target="searchClose" class="hidden w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      <% end %>

      <%# Hamburger (mobile only) %>
      <button type="button"
              data-action="click->navbar#toggleMobile"
              class="md:hidden p-1.5 text-gray-500 hover:text-gray-800 transition-colors"
              aria-label="Menu">
        <svg data-navbar-target="hamburgerOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg data-navbar-target="hamburgerClose" class="hidden w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <%# ── Mega menu panels (desktop) ── %>
  <% @categorias_menu&.first(6)&.each do |item| %>
    <% cat     = item.is_a?(Hash) ? item[:categoria] : item %>
    <% artigos = item.is_a?(Hash) ? item[:artigos]   : [] %>

    <div data-mega-menu-target="panel"
         data-category-id="<%= cat.id %>"
         data-action="mouseenter->mega-menu#keepOpen mouseleave->mega-menu#hide focusin->mega-menu#keepOpen focusout->mega-menu#hide"
         class="hidden absolute top-full left-0 right-0 bg-white border-t border-gray-100 shadow-xl z-50">
      <div class="max-w-7xl mx-auto px-4 py-6">

        <div class="flex items-center justify-between mb-5">
          <h3 class="font-bold text-gray-900 text-base"><%= cat.nome %></h3>
          <%= link_to "Ver todas →", categoria_path(cat.slug),
              class: "text-sm text-blue-600 hover:underline font-medium" %>
        </div>

        <% if artigos.any? %>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
            <% artigos.each do |artigo| %>
              <%= link_to noticia_path(artigo.slug),
                  class: "group flex flex-col gap-2 hover:no-underline" do %>
                <div class="aspect-[16/9] rounded-lg overflow-hidden bg-gradient-to-br from-blue-50 to-gray-100">
                  <% if artigo.imagem_capa_file.attached? %>
                    <%= image_tag url_for(artigo.imagem_capa_file.variant(resize_to_limit: [400, 225], format: :webp)),
                        class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300",
                        alt: artigo.titulo, loading: "lazy" %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center">
                      <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                    </div>
                  <% end %>
                </div>
                <p class="text-sm font-medium text-gray-800 line-clamp-2 group-hover:text-blue-600 transition-colors leading-snug">
                  <%= artigo.titulo %>
                </p>
                <span class="text-xs text-gray-400">
                  <%= l artigo.publicado_em, format: :short %>
                </span>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-400 py-4">Nenhuma notícia nesta categoria ainda.</p>
        <% end %>

      </div>
    </div>
  <% end %>

  <%# ── Mobile menu ── %>
  <div data-navbar-target="mobileMenu"
       class="hidden fixed inset-x-0 top-14 z-50 bg-white border-t border-gray-100 shadow-xl overflow-y-auto md:hidden"
       style="max-height: calc(100vh - 3.5rem);">
    <div class="px-4 py-5 space-y-1">

      <%= link_to "Início", root_path,
          class: "flex items-center px-3 py-2.5 rounded-lg text-gray-800 font-semibold hover:bg-gray-50",
          data: { action: "click->navbar#closeMobile" } %>

      <% @categorias_menu&.each do |item| %>
        <% cat = item.is_a?(Hash) ? item[:categoria] : item %>
        <%= link_to cat.nome, categoria_path(cat.slug),
            class: "flex items-center px-3 py-2.5 rounded-lg text-gray-700 hover:bg-gray-50",
            data: { action: "click->navbar#closeMobile" } %>
      <% end %>

      <div class="pt-4 mt-2 border-t border-gray-100 space-y-1">
        <% if user_signed_in? %>
          <% if current_user.administrador? || current_user.editor? %>
            <%= link_to (current_user.administrador? ? admin_root_path : editor_root_path),
                class: "flex items-center px-3 py-2.5 rounded-lg text-gray-700 hover:bg-gray-50",
                data: { action: "click->navbar#closeMobile" } do %>
              Painel
            <% end %>
          <% end %>
          <%= link_to "Minha Conta", current_user.administrador? ? admin_root_path : (current_user.editor? ? editor_root_path : usuario_root_path),
              class: "flex items-center px-3 py-2.5 rounded-lg text-gray-700 hover:bg-gray-50",
              data: { action: "click->navbar#closeMobile" } %>
          <%= link_to usuario_notificacoes_path,
              class: "flex items-center justify-between px-3 py-2.5 rounded-lg text-gray-700 hover:bg-gray-50",
              data: { action: "click->navbar#closeMobile" } do %>
            <span>Notificações</span>
            <% if @notificacoes_nao_lidas_count.to_i > 0 %>
              <span class="bg-red-500 text-white text-xs font-bold px-1.5 py-0.5 rounded-full leading-none">
                <%= @notificacoes_nao_lidas_count %>
              </span>
            <% end %>
          <% end %>
          <%= button_to "Sair", destroy_user_session_path, method: :delete,
              class: "w-full flex items-center px-3 py-2.5 rounded-lg text-red-600 hover:bg-red-50 text-sm font-medium",
              form: { class: "w-full" } %>
        <% else %>
          <%= link_to "Entrar", new_user_session_path,
              class: "flex items-center px-3 py-2.5 rounded-lg text-gray-700 hover:bg-gray-50 font-medium",
              data: { action: "click->navbar#closeMobile" } %>
          <%= link_to "Cadastre-se", new_user_registration_path,
              class: "flex items-center justify-center px-3 py-2.5 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 text-center",
              data: { action: "click->navbar#closeMobile" } %>
        <% end %>
      </div>

    </div>
  </div>

</nav>
