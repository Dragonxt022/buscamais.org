<footer class="bg-gray-100 border-t border-gray-200 mt-16">
  <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-4 gap-8">
    <div>
      <p class="text-lg font-bold mb-2">
        <span class="text-gray-900">Busca</span>
        <span class="text-blue-600">Mais</span><span class="text-blue-600 text-xs align-super">®</span>
      </p>
      <p class="text-sm text-gray-500">A Verdade, Esclarecida. Integridade jornalística de alta autoridade para a mente analítica moderna.</p>
    </div>
    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Categorias</p>
      <ul class="space-y-2">
        <% @categorias_menu&.each do |item| %>
          <% cat = item.is_a?(Hash) ? item[:categoria] : item %>
          <li><%= link_to cat.nome, categoria_path(cat.slug), class: "text-sm text-gray-600 hover:text-blue-600" %></li>
        <% end %>
      </ul>
    </div>
    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Empresa</p>
      <ul class="space-y-2 text-sm text-gray-600">
        <li><%= link_to "Sobre Nós",           sobre_nos_path,  class: "hover:text-blue-600" %></li>
        <li><%= link_to "Carreiras",           carreiras_path,  class: "hover:text-blue-600" %></li>
        <li><%= link_to "Contato",             contato_path,    class: "hover:text-blue-600" %></li>
        <li><%= link_to "Boletim Informativo", boletim_path,    class: "hover:text-blue-600" %></li>
      </ul>
    </div>
    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Legal</p>
      <ul class="space-y-2 text-sm text-gray-600">
        <li><%= link_to "Política de Privacidade", privacidade_path, class: "hover:text-blue-600" %></li>
        <li><%= link_to "Termos de Serviço",       termos_path,      class: "hover:text-blue-600" %></li>
        <li><%= link_to "Mapa do Site",            mapa_site_path,   class: "hover:text-blue-600" %></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-gray-200 text-center py-4 text-xs text-gray-400">
    © <%= Date.current.year %> Busca Mais. Todos os direitos reservados.
  </div>
</footer>
