<%# locals: (user:) %>
<% badge = user.badge_plano %>
<% if badge == "max" %>
  <span class="inline-flex items-center gap-0.5 text-[10px] font-black text-purple-700 bg-purple-100 px-1.5 py-0.5 rounded-full leading-none uppercase tracking-wide">
    <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
    </svg>
    MAX
  </span>
<% elsif badge == "plus" %>
  <span class="inline-flex items-center gap-0.5 text-[10px] font-bold text-blue-700 bg-blue-100 px-1.5 py-0.5 rounded-full leading-none uppercase tracking-wide">
    <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
    </svg>
    Plus
  </span>
<% end %>
