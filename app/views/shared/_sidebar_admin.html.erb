<%
  is_admin  = current_user.administrador?
  ns        = controller.class.name.start_with?("Admin::") ? :admin : :editor

  root_path_ns       = ns == :admin ? admin_root_path       : editor_root_path
  artigos_path_ns    = ns == :admin ? admin_artigos_path    : editor_artigos_path
  new_artigo_path_ns = ns == :admin ? new_admin_artigo_path : new_editor_artigo_path
  midias_path_ns     = ns == :admin ? admin_midias_path     : editor_midias_path
  albuns_path_ns      = ns == :admin ? admin_albuns_path     : editor_albuns_path

  in_artigos    = controller_name == "artigos"
  in_categorias = controller_name == "categorias" && ns == :admin
  in_tags       = controller_name == "tags"       && ns == :admin
  in_conteudo   = in_artigos || in_categorias || in_tags
%>

<aside class="w-60 bg-white border-r border-gray-200 flex flex-col min-h-screen shrink-0 overflow-hidden"
       data-controller="sidebar">

  <%# ── Brand / Toggle ── %>
  <% _branding = SiteBranding.instance rescue nil %>
  <div class="sidebar-header flex items-center justify-between px-4 py-3 border-b border-gray-200 min-h-[72px] gap-2">
    <a href="<%= root_path %>" target="_blank" rel="noopener"
       class="flex flex-col justify-center min-w-0 flex-1 hover:opacity-80 transition-opacity overflow-hidden"
       title="Ver site público">
      <% if _branding&.logo&.attached? %>
        <img src="<%= _branding.logo_url %>" alt="Logo"
             class="h-9 w-auto object-contain object-left max-w-[140px]"
             data-sidebar-target="brandText">
        <span class="text-[10px] text-gray-400 mt-0.5 truncate" data-sidebar-target="brandText">
          <%= is_admin ? "Administração" : "Editor" %>
        </span>
      <% else %>
        <div class="flex items-center gap-2 min-w-0">
          <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center shrink-0">
            <span class="text-white font-black text-sm select-none">B</span>
          </div>
          <div class="min-w-0" data-sidebar-target="brandText">
            <p class="text-sm font-bold text-gray-800 truncate leading-tight">Busca Mais</p>
            <p class="text-[10px] text-gray-400 truncate"><%= is_admin ? "Administração" : "Editor" %></p>
          </div>
        </div>
      <% end %>
    </a>
    <button type="button"
            data-action="click->sidebar#toggle"
            class="p-1.5 rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-600 shrink-0 transition-colors"
            title="Recolher / expandir menu">
      <%= lucide_icon "chevrons-left", css: "w-4 h-4 transition-transform duration-200", "data-sidebar-target": "toggleIcon" %>
    </button>
  </div>

  <%# ── Navegação ── %>
  <nav class="flex-1 px-3 py-4 space-y-5 overflow-y-auto overflow-x-hidden sidebar-scroll">

    <%# GERAL %>
    <div>
      <p class="px-2 mb-1.5 text-[10px] font-bold uppercase tracking-widest text-gray-400 whitespace-nowrap select-none"
         data-sidebar-target="groupLabel">Geral</p>
      <div class="space-y-0.5">

        <%= link_to root_path_ns, title: "Dashboard",
            class: "sidebar-link flex items-center gap-3 px-2 py-2 rounded-lg text-sm transition-colors #{current_page?(root_path_ns) ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
          <%= lucide_icon "home" %>
          <span class="truncate whitespace-nowrap" data-sidebar-target="label">Dashboard</span>
        <% end %>

        <% if is_admin %>
          <%= link_to admin_analise_path, title: "Análise",
              class: "sidebar-link flex items-center gap-3 px-2 py-2 rounded-lg text-sm transition-colors #{current_page?(admin_analise_path) ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
            <%= lucide_icon "bar-chart-2" %>
            <span class="truncate whitespace-nowrap" data-sidebar-target="label">Análise</span>
          <% end %>
        <% end %>

      </div>
    </div>

    <%# CONTEÚDO %>
    <div>
      <p class="px-2 mb-1.5 text-[10px] font-bold uppercase tracking-widest text-gray-400 whitespace-nowrap select-none"
         data-sidebar-target="groupLabel">Conteúdo</p>
      <div class="space-y-0.5">

        <%# Artigos com submenu %>
        <div>
          <button type="button"
                  data-action="click->sidebar#toggleSubmenu"
                  data-submenu="artigos"
                  title="Artigos"
                  class="sidebar-link w-full flex items-center gap-3 px-2 py-2 rounded-lg text-sm transition-colors
                         <%= in_conteudo ? 'bg-blue-50 text-blue-700' : 'text-gray-600 hover:bg-gray-100' %>">
            <%= lucide_icon "file-text" %>
            <span class="flex-1 min-w-0 text-left truncate whitespace-nowrap" data-sidebar-target="label">Artigos</span>
            <%= lucide_icon "chevron-down", css: "w-3.5 h-3.5 transition-transform duration-200 #{in_conteudo ? 'rotate-180' : ''}", "data-sidebar-target": "submenuArrow" %>
          </button>

          <div data-sidebar-target="submenu" data-id="artigos"
               class="mt-0.5 ml-4 pl-3 border-l-2 border-gray-100 space-y-0.5 <%= in_conteudo ? '' : 'hidden' %>">

            <%= link_to artigos_path_ns,
                class: "flex items-center gap-2 px-2 py-1.5 rounded-lg text-sm transition-colors
                        #{in_artigos && !in_categorias && !in_tags ? 'submenu-active text-blue-700 font-semibold bg-blue-50' : 'text-gray-500 hover:text-gray-800 hover:bg-gray-100'}" do %>
              <%= lucide_icon "list", css: "w-4 h-4 opacity-60" %>
              Todos os Artigos
            <% end %>

            <% if is_admin %>
              <%= link_to admin_categorias_path,
                  class: "flex items-center gap-2 px-2 py-1.5 rounded-lg text-sm transition-colors
                          #{in_categorias ? 'submenu-active text-blue-700 font-semibold bg-blue-50' : 'text-gray-500 hover:text-gray-800 hover:bg-gray-100'}" do %>
                <%= lucide_icon "folder", css: "w-4 h-4 opacity-60" %>
                Categorias
              <% end %>

              <%= link_to admin_tags_path,
                  class: "flex items-center gap-2 px-2 py-1.5 rounded-lg text-sm transition-colors
                          #{in_tags ? 'submenu-active text-blue-700 font-semibold bg-blue-50' : 'text-gray-500 hover:text-gray-800 hover:bg-gray-100'}" do %>
                <%= lucide_icon "tag", css: "w-4 h-4 opacity-60" %>
                Tags
              <% end %>
            <% end %>

            <div class="pt-1.5 border-t border-gray-100">
              <%= link_to new_artigo_path_ns,
                  class: "flex items-center gap-2 px-2 py-1.5 rounded-lg text-sm font-semibold text-blue-600 hover:bg-blue-50 transition-colors" do %>
                <%= lucide_icon "plus", css: "w-4 h-4" %>
                Novo Artigo
              <% end %>
            </div>
          </div>
        </div>

        <% if is_admin %>
          <%# Comentários com badge de pendentes %>
          <% pendentes_count = Comment.pendentes.count rescue 0 %>
          <% denuncias_count = Comment.joins(:comment_reports).distinct.where(comment_reports: { resolvido: false }).count rescue 0 %>
          <%= link_to admin_comentarios_path, title: "Comentários",
              class: "sidebar-link flex items-center gap-3 px-2 py-2 rounded-lg text-sm transition-colors #{controller_name == 'comentarios' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
            <%= lucide_icon "message-square" %>
            <span class="flex-1 min-w-0 truncate whitespace-nowrap" data-sidebar-target="label">Comentários</span>
            <% if pendentes_count > 0 %>
              <span class="text-xs font-bold bg-amber-100 text-amber-600 px-1.5 py-0.5 rounded-full leading-none shrink-0" data-sidebar-target="label">
                <%= pendentes_count %>
              </span>
            <% end %>
          <% end %>

          <%# Denúncias com badge vermelho %>
          <%= link_to admin_comentarios_path(denunciados: "1"), title: "Denúncias",
              class: "sidebar-link flex items-center gap-3 px-2 py-2 rounded-lg text-sm transition-colors #{controller_name == 'comentarios' && params[:denunciados].present? ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
            <%= lucide_icon "flag" %>
            <span class="flex-1 min-w-0 truncate whitespace-nowrap" data-sidebar-target="label">Denúncias</span>
            <% if denuncias_count > 0 %>
              <span class="text-xs font-bold bg-red-100 text-red-600 px-1.5 py-0.5 rounded-full leading-none shrink-0" data-sidebar-target="label">
                <%= denuncias_count %>
              </span>
            <% end %>
          <% end %>

          <%# Mensagens (Fale Conosco) %>
          <% mensagens_nao_lidas = ContactMessage.nao_lidas.count rescue 0 %>
          <%= link_to admin_mensagens_path, title: "Mensagens",
              class: "sidebar-link flex items-center gap-3 px-2 py-2 rounded-lg text-sm transition-colors #{controller_name == 'mensagens' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
            <%= lucide_icon "mail" %>
            <span class="flex-1 min-w-0 truncate whitespace-nowrap" data-sidebar-target="label">Mensagens</span>
            <% if mensagens_nao_lidas > 0 %>
              <span class="text-xs font-bold bg-blue-100 text-blue-600 px-1.5 py-0.5 rounded-full leading-none shrink-0" data-sidebar-target="label">
                <%= mensagens_nao_lidas %>
              </span>
            <% end %>
          <% end %>
        <% end %>

      </div>
    </div>

    <%# MÍDIA %>
    <div>
      <p class="px-2 mb-1.5 text-[10px] font-bold uppercase tracking-widest text-gray-400 whitespace-nowrap select-none"
         data-sidebar-target="groupLabel">Mídia</p>
      <div class="space-y-0.5">

        <%= link_to midias_path_ns, title: "Biblioteca de Mídia",
            class: "sidebar-link flex items-center gap-3 px-2 py-2 rounded-lg text-sm transition-colors #{controller_name == 'midias' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
          <%= lucide_icon "image" %>
          <span class="truncate whitespace-nowrap" data-sidebar-target="label">Biblioteca de Mídia</span>
        <% end %>

        <%= link_to albuns_path_ns, title: "Álbuns",
            class: "sidebar-link flex items-center gap-3 px-2 py-2 rounded-lg text-sm transition-colors #{controller_name == 'albuns' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
          <%= lucide_icon "folder" %>
          <span class="truncate whitespace-nowrap" data-sidebar-target="label">Álbuns</span>
        <% end %>

      </div>
    </div>

    <% if is_admin %>
      <%# USUÁRIOS %>
      <div>
        <p class="px-2 mb-1.5 text-[10px] font-bold uppercase tracking-widest text-gray-400 whitespace-nowrap select-none"
           data-sidebar-target="groupLabel">Usuários</p>
        <div class="space-y-0.5">

          <%= link_to admin_usuarios_path, title: "Usuários",
              class: "sidebar-link flex items-center gap-3 px-2 py-2 rounded-lg text-sm transition-colors #{controller_name == 'usuarios' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
            <%= lucide_icon "users" %>
            <span class="truncate whitespace-nowrap" data-sidebar-target="label">Usuários</span>
          <% end %>

          <%= link_to admin_planos_path, title: "Planos de Assinatura",
              class: "sidebar-link flex items-center gap-3 px-2 py-2 rounded-lg text-sm transition-colors #{controller_name == 'planos' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
            <%= lucide_icon "credit-card" %>
            <span class="truncate whitespace-nowrap" data-sidebar-target="label">Planos</span>
          <% end %>

          <%= link_to admin_assinaturas_path, title: "Assinaturas",
              class: "sidebar-link flex items-center gap-3 px-2 py-2 rounded-lg text-sm transition-colors #{controller_name == 'assinaturas' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
            <%= lucide_icon "receipt" %>
            <span class="truncate whitespace-nowrap" data-sidebar-target="label">Assinaturas</span>
          <% end %>

          <%= link_to admin_anuncios_path, title: "Anúncios",
              class: "sidebar-link flex items-center gap-3 px-2 py-2 rounded-lg text-sm transition-colors #{controller_name == 'anuncios' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
            <%= lucide_icon "megaphone" %>
            <span class="truncate whitespace-nowrap" data-sidebar-target="label">Anúncios</span>
          <% end %>

        </div>
      </div>

      <%# CONFIGURAÇÕES %>
      <div>
        <p class="px-2 mb-1.5 text-[10px] font-bold uppercase tracking-widest text-gray-400 whitespace-nowrap select-none"
           data-sidebar-target="groupLabel">Sistema</p>
        <div class="space-y-0.5">

          <%= link_to admin_notificacoes_path, title: "Notificações",
              class: "sidebar-link flex items-center gap-3 px-2 py-2 rounded-lg text-sm transition-colors #{controller_name == 'notificacoes' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
            <div class="relative shrink-0">
              <%= lucide_icon "bell", css: "w-5 h-5" %>
              <% if @notificacoes_nao_lidas_count.to_i > 0 %>
                <span class="absolute -top-1 -right-1 w-2 h-2 bg-red-500 rounded-full"></span>
              <% end %>
            </div>
            <span class="flex-1 min-w-0 truncate whitespace-nowrap" data-sidebar-target="label">Notificações</span>
            <% if @notificacoes_nao_lidas_count.to_i > 0 %>
              <span class="text-xs font-bold bg-red-100 text-red-600 px-1.5 py-0.5 rounded-full leading-none shrink-0" data-sidebar-target="label">
                <%= @notificacoes_nao_lidas_count %>
              </span>
            <% end %>
          <% end %>

          <%= link_to admin_configuracoes_path, title: "Configurações",
              class: "sidebar-link flex items-center gap-3 px-2 py-2 rounded-lg text-sm transition-colors #{controller_name == 'configuracoes' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
            <%= lucide_icon "settings" %>
            <span class="truncate whitespace-nowrap" data-sidebar-target="label">Configurações</span>
          <% end %>

        </div>
      </div>
    <% end %>

  </nav>

  <%# ── Rodapé ── %>
  <div class="px-3 py-4 border-t border-gray-200">
    <%= button_to destroy_user_session_path, method: :delete,
        class: "sidebar-link w-full flex items-center gap-3 px-2 py-2 rounded-lg text-sm text-gray-500 hover:text-red-600 hover:bg-red-50 transition-colors",
        title: "Sair",
        form: { style: "width:100%" } do %>
      <%= lucide_icon "log-out" %>
      <span class="truncate whitespace-nowrap" data-sidebar-target="label">Sair da conta</span>
    <% end %>
  </div>

</aside>
