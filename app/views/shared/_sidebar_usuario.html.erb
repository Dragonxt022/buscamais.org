<aside id="sidebar-usuario"
       class="fixed inset-y-0 left-0 z-40 w-64 bg-white border-r border-gray-200 flex flex-col -translate-x-full md:translate-x-0 md:static md:w-60 md:z-auto transition-transform duration-200 ease-in-out">

  <%# ── Logo ── %>
  <div class="px-5 py-4 border-b border-gray-100 min-h-[72px] flex flex-col justify-center">
    <% _branding_u = SiteBranding.instance rescue nil %>
    <%= link_to root_path, target: "_blank", rel: "noopener",
        class: "block hover:opacity-80 transition-opacity", title: "Ver site público" do %>
      <% if _branding_u&.logo&.attached? %>
        <img src="<%= _branding_u.logo_url %>" alt="Logo" class="h-9 w-auto object-contain object-left max-w-[160px]">
        <span class="block text-[10px] text-gray-400 mt-0.5">Área do Assinante</span>
      <% else %>
        <span class="text-xl font-bold text-gray-900">Busca</span><span class="text-xl font-bold text-blue-600">Mais</span><span class="text-blue-600 text-xs align-super">®</span>
        <span class="block text-[10px] text-gray-400 mt-0.5">Área do Assinante</span>
      <% end %>
    <% end %>
  </div>

  <%# ── Navegação agrupada ── %>
  <nav class="flex-1 px-3 py-4 space-y-5 overflow-y-auto sidebar-scroll">

    <%# GERAL %>
    <div>
      <p class="px-2 mb-1.5 text-[10px] font-bold uppercase tracking-widest text-gray-400 select-none">Geral</p>
      <div class="space-y-0.5">
        <%= link_to usuario_root_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{current_page?(usuario_root_path) ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
          Dashboard
        <% end %>
      </div>
    </div>

    <%# CONTEÚDO %>
    <div>
      <p class="px-2 mb-1.5 text-[10px] font-bold uppercase tracking-widest text-gray-400 select-none">Conteúdo</p>
      <div class="space-y-0.5">
        <%= link_to usuario_salvos_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{controller_name == 'salvos' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
          Artigos Salvos
        <% end %>
        <%= link_to usuario_comentarios_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{controller_name == 'comentarios' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          Meus Comentários
        <% end %>
      </div>
    </div>

    <%# CONTA %>
    <div>
      <p class="px-2 mb-1.5 text-[10px] font-bold uppercase tracking-widest text-gray-400 select-none">Conta</p>
      <div class="space-y-0.5">
        <%= link_to usuario_perfil_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{controller_name == 'perfils' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
          Meu Perfil
        <% end %>
        <%= link_to usuario_notificacoes_path, class: "flex items-center justify-between gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{controller_name == 'notificacoes' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
          <span class="flex items-center gap-3">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
            Notificações
          </span>
          <% if @notificacoes_nao_lidas_count.to_i > 0 %>
            <span class="bg-red-500 text-white text-xs font-bold px-1.5 py-0.5 rounded-full leading-none shrink-0">
              <%= @notificacoes_nao_lidas_count %>
            </span>
          <% end %>
        <% end %>
        <%= link_to usuario_assinatura_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{controller_name == 'assinaturas' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
          Assinatura
        <% end %>
        <%= link_to usuario_configuracoes_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors #{controller_name == 'configuracoes' ? 'bg-blue-600 text-white' : 'text-gray-600 hover:bg-gray-100'}" do %>
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Configurações
        <% end %>
      </div>
    </div>

  </nav>

  <%# ── Rodapé do sidebar: avatar + nome + sair ── %>
  <div class="p-4 border-t border-gray-100">
    <%= link_to usuario_perfil_path, class: "flex items-center gap-3 mb-3 hover:bg-gray-50 rounded-lg px-2 py-1.5 transition-colors" do %>
      <%= render "shared/user_avatar", user: current_user, size: "md" %>
      <div class="min-w-0">
        <p class="text-sm font-semibold text-gray-900 truncate"><%= current_user.nome %></p>
        <p class="text-xs text-gray-400 truncate"><%= current_user.subscription&.premium? ? "Membro Premium" : "Membro Gratuito" %></p>
      </div>
    <% end %>
    <%= button_to destroy_user_session_path, method: :delete,
        class: "w-full flex items-center gap-2 text-sm text-gray-500 hover:text-red-600 px-2 py-1.5 rounded-lg hover:bg-red-50 transition-colors" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
      </svg>
      Sair
    <% end %>
  </div>

</aside>
