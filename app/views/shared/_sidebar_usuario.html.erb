<aside class="w-56 bg-white border-r border-gray-200 flex flex-col min-h-screen">
  <div class="p-5">
    <%= link_to root_path, class: "text-xl font-bold" do %>
      <span class="text-gray-900">Busca</span>
      <span class="text-blue-600">Mais</span><span class="text-blue-600 text-xs align-super">®</span>
    <% end %>
  </div>
  <nav class="flex-1 px-4 space-y-1">
    <%= link_to usuario_root_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{current_page?(usuario_root_path) ? 'bg-blue-50 text-blue-700 font-medium' : 'text-gray-600 hover:bg-gray-100'}" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
      Dashboard
    <% end %>
    <%= link_to usuario_perfil_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{controller_name == 'perfils' ? 'bg-blue-50 text-blue-700 font-medium' : 'text-gray-600 hover:bg-gray-100'}" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      Perfil
    <% end %>
    <%= link_to usuario_comentarios_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{controller_name == 'comentarios' ? 'bg-blue-50 text-blue-700 font-medium' : 'text-gray-600 hover:bg-gray-100'}" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      Meus Comentários
    <% end %>
    <%= link_to usuario_salvos_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{controller_name == 'salvos' ? 'bg-blue-50 text-blue-700 font-medium' : 'text-gray-600 hover:bg-gray-100'}" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/></svg>
      Artigos Salvos
    <% end %>
    <%= link_to usuario_configuracoes_path, class: "flex items-center gap-3 px-3 py-2 rounded-lg text-sm #{controller_name == 'configuracoes' ? 'bg-blue-50 text-blue-700 font-medium' : 'text-gray-600 hover:bg-gray-100'}" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      Configurações
    <% end %>
  </nav>
  <div class="p-4 border-t border-gray-200">
    <div class="flex items-center gap-3 mb-3">
      <div class="w-9 h-9 rounded-full bg-blue-600 flex items-center justify-center text-white text-sm font-bold">
        <%= current_user.nome.first.upcase %>
      </div>
      <div>
        <p class="text-sm font-medium text-gray-900"><%= current_user.nome %></p>
        <p class="text-xs text-gray-500"><%= current_user.subscription&.premium? ? "Membro Premium" : "Membro Gratuito" %></p>
      </div>
    </div>
    <%= button_to "Sair", destroy_user_session_path, method: :delete,
        class: "flex items-center gap-2 text-sm text-gray-500 hover:text-red-600" %>
  </div>
</aside>
