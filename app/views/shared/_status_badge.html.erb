<% cores = {
  "publicado"          => "bg-green-100 text-green-700",
  "rascunho"           => "bg-gray-100 text-gray-600",
  "agendado"           => "bg-blue-100 text-blue-700",
  "aguardando_revisao" => "bg-yellow-100 text-yellow-700",
  "arquivado"          => "bg-red-100 text-red-600",
  "aprovado"           => "bg-green-100 text-green-700",
  "pendente"           => "bg-yellow-100 text-yellow-700",
  "rejeitado"          => "bg-red-100 text-red-600"
} %>
<span class="text-xs font-semibold px-2 py-0.5 rounded-full <%= cores[status] || 'bg-gray-100 text-gray-600' %>">
  <%= status.humanize %>
</span>
