<%# locals: (anuncio:) %>
<%
  limite_por_formato = { "quadrado" => [280, 280], "retangular" => [500, 280], "vertical" => [300, 600] }
  limite = limite_por_formato[anuncio.formato] || [500, 280]
%>
<div class="anuncio-wrapper text-center my-6 overflow-hidden">
  <p class="text-[10px] uppercase tracking-widest text-gray-300 mb-1 select-none">Publicidade</p>
  <%= link_to anuncio_clique_path(anuncio), target: "_blank", rel: "sponsored noopener" do %>
    <%= image_tag url_for(anuncio.imagem.variant(resize_to_limit: limite, format: :webp)),
        class: "mx-auto rounded-lg max-w-full h-auto object-contain",
        alt: anuncio.titulo %>
  <% end %>
</div>
