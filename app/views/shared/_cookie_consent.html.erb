<% if cookie_consent_pendente? %>
<div id="cookie-banner"
     data-controller="cookie-consent"
     class="fixed bottom-0 left-0 right-0 z-[9999] translate-y-full transition-transform duration-500 ease-out"
     aria-live="polite"
     aria-label="Aviso de cookies">

  <%# Backdrop shadow overlay %>
  <div class="absolute inset-0 pointer-events-none"
       style="box-shadow: 0 -8px 40px 0 rgba(0,0,0,0.13);"></div>

  <div class="relative bg-white border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-5">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6">

        <%# Icon + texto %>
        <div class="flex items-start gap-3 flex-1 min-w-0">
          <div class="shrink-0 w-9 h-9 rounded-full bg-blue-50 flex items-center justify-center text-lg select-none">
            🍪
          </div>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-gray-900 mb-0.5">Sua privacidade importa para nós</p>
            <p class="text-sm text-gray-500 leading-relaxed">
              Utilizamos cookies essenciais para o funcionamento do site e, com sua permissão,
              cookies analíticos para entender como você navega e melhorar sua experiência.
              Consulte nossa
              <%= link_to "Política de Privacidade", privacidade_path,
                  class: "text-blue-600 hover:text-blue-700 underline-offset-2 hover:underline font-medium" %>.
            </p>
          </div>
        </div>

        <%# Botões %>
        <div class="flex items-center gap-2 w-full sm:w-auto shrink-0">
          <button type="button"
                  data-action="click->cookie-consent#reject"
                  class="flex-1 sm:flex-none px-4 py-2.5 text-sm font-medium text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-gray-400">
            Apenas essenciais
          </button>
          <button type="button"
                  data-action="click->cookie-consent#accept"
                  class="flex-1 sm:flex-none px-5 py-2.5 text-sm font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
            Aceitar todos
          </button>
        </div>

      </div>
    </div>
  </div>
</div>
<% end %>
