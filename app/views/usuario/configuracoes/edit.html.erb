<div class="max-w-2xl mx-auto space-y-6">
  <div class="card">
    <div class="card-header">
      <h3 class="font-semibold text-gray-800">Tópicos de Interesse</h3>
    </div>
    <div class="card-body">
      <p class="text-sm text-gray-500 mb-5">Selecione os tópicos que você quer acompanhar para receber recomendações personalizadas.</p>
      <%= form_with url: usuario_configuracoes_path, method: :patch, class: "space-y-5" do |f| %>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
          <% @topicos_disponiveis.each do |cat| %>
            <label class="flex items-center gap-3 p-3 border rounded-lg cursor-pointer hover:border-blue-400 transition-colors
                          <%= @topicos_seguidos.include?(cat.id) ? 'border-blue-500 bg-blue-50' : 'border-gray-200' %>">
              <input type="checkbox" name="category_ids[]" value="<%= cat.id %>"
                     <%= 'checked' if @topicos_seguidos.include?(cat.id) %>
                     class="w-4 h-4 text-blue-600 border-gray-300 rounded">
              <div>
                <% if cat.cor %>
                  <div class="w-2.5 h-2.5 rounded-full mb-1" style="background:<%= cat.cor %>"></div>
                <% end %>
                <span class="text-sm font-medium text-gray-800"><%= cat.nome %></span>
              </div>
            </label>
          <% end %>
        </div>

        <%= f.submit "Salvar Preferências", class: "btn-primary cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h3 class="font-semibold text-gray-800">Conta</h3>
    </div>
    <div class="card-body space-y-3">
      <div class="flex items-center justify-between py-2 border-b border-gray-100">
        <div>
          <p class="text-sm font-medium text-gray-800">Alterar senha</p>
          <p class="text-xs text-gray-400">Atualize sua senha de acesso</p>
        </div>
        <%= link_to "Alterar", edit_user_password_path, class: "text-sm text-blue-600 hover:underline" %>
      </div>
      <div class="flex items-center justify-between py-2">
        <div>
          <p class="text-sm font-medium text-gray-800">Editar perfil</p>
          <p class="text-xs text-gray-400">Nome, bio e foto</p>
        </div>
        <%= link_to "Editar", edit_usuario_perfil_path, class: "text-sm text-blue-600 hover:underline" %>
      </div>
    </div>
  </div>
</div>
