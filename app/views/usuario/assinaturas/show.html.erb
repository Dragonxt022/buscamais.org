<% content_for :title, "Minha Assinatura" %>

<div class="max-w-2xl space-y-6">
  <%# Status atual %>
  <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">
    <h2 class="text-lg font-bold text-gray-900 mb-5">Plano Atual</h2>

    <% if @plano_atual %>
      <% cores = @plano_atual.cor_classes %>
      <div class="flex items-center gap-4 p-4 rounded-xl border <%= cores[:ring] || 'border-gray-200' %> <%= cores[:bg] || 'bg-gray-50' %>">
        <div class="w-12 h-12 rounded-xl <%= cores[:badge] || 'bg-gray-600' %> flex items-center justify-center text-white">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
          </svg>
        </div>
        <div class="flex-1">
          <p class="font-bold text-gray-900 text-lg"><%= @plano_atual.nome %></p>
          <p class="text-sm text-gray-500"><%= @plano_atual.preco_formatado %></p>
        </div>
        <% if @subscription&.ativa? && !@plano_atual.gratuito? %>
          <span class="text-xs font-semibold text-green-700 bg-green-50 px-2.5 py-1 rounded-full">Ativa</span>
        <% end %>
      </div>

      <% if @subscription&.prox_cobranca %>
        <p class="text-sm text-gray-500 mt-3">
          Próxima cobrança: <strong><%= l @subscription.prox_cobranca, format: :long %></strong>
        </p>
      <% end %>

      <% if @subscription&.ativa? && !@plano_atual.gratuito? %>
        <%= button_to usuario_assinatura_path, method: :patch,
            data: { turbo_confirm: "Cancelar sua assinatura #{@plano_atual.nome}? Você perderá os benefícios no fim do período." },
            class: "mt-4 text-sm text-red-500 hover:text-red-700 hover:underline" do %>
          Cancelar assinatura
        <% end %>
      <% end %>
    <% else %>
      <p class="text-gray-500 text-sm">Nenhuma assinatura ativa. Explore nossos planos abaixo.</p>
    <% end %>
  </div>

  <%# Upgrade options %>
  <div>
    <h3 class="font-bold text-gray-900 mb-4">Alterar Plano</h3>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <% @planos.each do |plano| %>
        <% cores = plano.cor_classes %>
        <% is_atual = @plano_atual&.slug == plano.slug %>
        <div class="bg-white rounded-xl border p-4 flex flex-col
                    <%= plano.destaque? ? "ring-2 #{cores[:ring] || 'ring-blue-300'}" : 'border-gray-200' %>
                    <%= is_atual ? 'opacity-60' : '' %>">
          <p class="font-bold text-gray-900 mb-1"><%= plano.nome %></p>
          <p class="text-lg font-black <%= cores[:text] || 'text-gray-700' %> mb-3">
            <%= plano.preco_formatado %>
          </p>
          <% if is_atual %>
            <span class="text-xs text-center text-gray-400 bg-gray-50 rounded-lg py-1.5 font-medium">Plano atual</span>
          <% elsif plano.gratuito? %>
            <span class="text-xs text-center text-gray-400 bg-gray-50 rounded-lg py-1.5 font-medium">Disponível grátis</span>
          <% elsif plano.stripe_price_id.blank? %>
            <span class="text-xs text-center text-gray-400 bg-gray-50 rounded-lg py-1.5 font-medium">Em breve</span>
          <% else %>
            <% tem_promo = plano.elegivel_para_promocao?(current_user) %>
            <% if tem_promo %>
              <div class="mb-2 text-center">
                <p class="text-base font-black text-orange-500">
                  R$ <%= format('%.2f', plano.preco_promocional).gsub('.', ',') %>/mês
                </p>
                <p class="text-[10px] text-gray-400">
                  por <%= plano.meses_promocionais %> meses · depois <%= plano.preco_formatado %>
                </p>
              </div>
            <% end %>
            <%= button_to checkout_usuario_assinatura_path(plan_id: plano.id), method: :post,
                class: "w-full text-sm font-bold text-white py-2 rounded-lg transition-colors hover:opacity-90 #{tem_promo ? 'bg-gradient-to-r from-orange-500 to-amber-500' : (cores[:badge] || 'bg-gray-700')}" do %>
              <%= tem_promo ? "🏷 Aproveitar oferta" : "Assinar" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
    <%= link_to "Ver todos os detalhes →", planos_publicos_path, class: "text-sm text-blue-600 hover:underline mt-3 inline-block" %>
  </div>
</div>
