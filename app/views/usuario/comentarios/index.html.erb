<div class="max-w-3xl mx-auto space-y-5">
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-bold text-gray-900">Meus Comentários</h2>
    <span class="text-sm text-gray-500"><%= @pagy.count %> comentários</span>
  </div>

  <% if @comentarios.any? %>
    <div class="space-y-3">
      <% @comentarios.each do |comentario| %>
        <div class="card">
          <div class="card-body">
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <% if comentario.article %>
                  <p class="text-xs text-gray-400 mb-1">Em:</p>
                  <%= link_to comentario.article.titulo.truncate(80), noticia_path(comentario.article.slug),
                      class: "text-sm font-medium text-blue-600 hover:underline line-clamp-1" %>
                <% end %>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                <%= render "shared/status_badge", status: comentario.status %>
                <span class="text-xs text-gray-400"><%= l comentario.created_at, format: :short %></span>
              </div>
            </div>
            <p class="text-sm text-gray-700 leading-relaxed"><%= comentario.conteudo %></p>
          </div>
        </div>
      <% end %>
    </div>
    <div class="flex justify-center mt-4">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <div class="card">
      <div class="card-body text-center py-16">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
        <p class="text-gray-400 font-medium">Você ainda não fez nenhum comentário.</p>
        <%= link_to "Ler notícias", root_path, class: "btn-primary mt-4 inline-flex" %>
      </div>
    </div>
  <% end %>
</div>
