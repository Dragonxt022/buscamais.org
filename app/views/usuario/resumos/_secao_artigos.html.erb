<% titulo ||= nil %>
<% if titulo %>
  <h2 class="text-lg font-bold text-gray-900 mb-4"><%= titulo %></h2>
<% end %>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
  <% artigos.each do |artigo| %>
    <% ja_lido = lidos.include?(artigo.id) %>
    <article class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 flex flex-col transition-shadow hover:shadow-md <%= ja_lido ? 'opacity-75' : '' %>">

      <%# Imagem %>
      <% if artigo.imagem_capa_file.attached? %>
        <div class="relative aspect-video overflow-hidden">
          <%= image_tag rails_blob_path(artigo.imagem_capa_file.blob, only_path: true),
              alt: artigo.titulo,
              class: "w-full h-full object-cover",
              loading: "lazy" %>
          <% if ja_lido %>
            <div class="absolute top-2 right-2 bg-green-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
              Lido
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="relative aspect-video bg-gradient-to-br from-blue-50 to-gray-100 flex items-center justify-center">
          <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <% if ja_lido %>
            <div class="absolute top-2 right-2 bg-green-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full">
              Lido
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="p-4 flex flex-col flex-1">
        <%# Categoria + tempo %>
        <div class="flex items-center gap-2 mb-2">
          <% if artigo.category %>
            <span class="text-xs font-bold text-blue-600 uppercase"><%= artigo.category.nome %></span>
            <span class="text-gray-200">•</span>
          <% end %>
          <span class="text-xs text-gray-400"><%= artigo.tempo_leitura %> min</span>
          <% if artigo.premium? %>
            <span class="ml-auto text-[10px] font-bold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded-full">Premium</span>
          <% end %>
        </div>

        <%# Título %>
        <h3 class="font-bold text-gray-900 text-sm leading-snug mb-1 line-clamp-3 flex-1">
          <%= link_to artigo.titulo, noticia_path(artigo.slug), class: "hover:text-blue-600" %>
        </h3>

        <%# Horário de publicação %>
        <p class="text-[11px] text-gray-400 mb-3">
          <%= artigo.publicado_em.strftime("%H:%M") %>
        </p>

        <%# Ações %>
        <div class="flex items-center justify-between mt-auto pt-3 border-t border-gray-50">
          <%= link_to ja_lido ? "Reler →" : "Ler →", noticia_path(artigo.slug),
              class: "text-xs font-semibold #{ja_lido ? 'text-gray-400 hover:text-gray-600' : 'text-blue-600 hover:text-blue-800'}" %>
          <%= button_to usuario_salvos_path(article_id: artigo.id), method: :post,
              class: "text-gray-300 hover:text-blue-600 transition-colors", title: "Salvar artigo" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
            </svg>
          <% end %>
        </div>
      </div>
    </article>
  <% end %>
</div>
