<div class="max-w-3xl mx-auto space-y-5">
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-bold text-gray-900">Artigos Salvos</h2>
    <span class="text-sm text-gray-500"><%= @pagy.count %> artigos salvos</span>
  </div>

  <% if @salvos.any? %>
    <div class="space-y-4">
      <% @salvos.each do |salvo| %>
        <% artigo = salvo.article %>
        <div class="card hover:shadow-md transition-shadow">
          <div class="card-body flex gap-4">
            <div class="w-20 h-16 rounded-lg bg-gradient-to-br from-blue-50 to-gray-100 flex-shrink-0 flex items-center justify-center">
              <svg class="w-6 h-6 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <% if artigo.category %>
                    <span class="text-xs text-blue-600 font-semibold uppercase tracking-wide"><%= artigo.category.nome %></span>
                  <% end %>
                  <h3 class="font-semibold text-gray-900 text-sm mt-0.5 line-clamp-2">
                    <%= link_to artigo.titulo, noticia_path(artigo.slug), class: "hover:text-blue-600" %>
                  </h3>
                  <p class="text-xs text-gray-400 mt-1">
                    Salvo em <%= l salvo.created_at, format: :short %>
                  </p>
                </div>
                <%= button_to usuario_salvo_path(salvo), method: :delete,
                    data: { turbo_confirm: "Remover dos salvos?" },
                    class: "text-gray-300 hover:text-red-500 flex-shrink-0" do %>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="flex justify-center mt-4">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <div class="card">
      <div class="card-body text-center py-16">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
        </svg>
        <p class="text-gray-400 font-medium">Nenhum artigo salvo ainda.</p>
        <p class="text-gray-400 text-sm mt-1">Salve artigos para lê-los depois.</p>
        <%= link_to "Explorar notícias", root_path, class: "btn-primary mt-4 inline-flex" %>
      </div>
    </div>
  <% end %>
</div>
