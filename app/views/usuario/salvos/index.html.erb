<div class="max-w-3xl mx-auto space-y-5">
  <div class="flex items-center justify-between">
    <h2 class="text-xl font-bold text-gray-900">Artigos Salvos</h2>
    <span class="text-sm text-gray-500"><%= @pagy.count %> artigo<%= @pagy.count == 1 ? "" : "s" %> salvo<%= @pagy.count == 1 ? "" : "s" %></span>
  </div>

  <% if @salvos.any? %>
    <div class="space-y-3">
      <% @salvos.each do |salvo| %>
        <% artigo = salvo.article %>
        <div class="bg-white rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex gap-4 p-4">

            <%# Thumbnail %>
            <div class="w-24 h-18 rounded-lg overflow-hidden shrink-0 bg-gradient-to-br from-blue-50 to-gray-100 self-start
                        <%= artigo.imagem_capa_file.attached? ? 'shimmer' : '' %>"
                 <%= "data-controller=shimmer" if artigo.imagem_capa_file.attached? %>
                 style="width:5rem;height:4rem">
              <% if artigo.imagem_capa_file.attached? %>
                <%= image_tag rails_blob_path(artigo.imagem_capa_file.blob, only_path: true),
                    class: "w-full h-full object-cover",
                    alt: artigo.titulo,
                    loading: "lazy" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
              <% end %>
            </div>

            <%# Conteúdo %>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <% if artigo.category %>
                    <span class="text-xs font-bold uppercase tracking-wide"
                          style="color: <%= artigo.category.cor %>">
                      <%= artigo.category.nome %>
                    </span>
                  <% end %>
                  <h3 class="font-semibold text-gray-900 text-sm mt-0.5 line-clamp-2 leading-snug">
                    <%= link_to artigo.titulo, noticia_path(artigo.slug), class: "hover:text-blue-600" %>
                  </h3>
                  <div class="flex items-center gap-3 mt-1.5 text-xs text-gray-400">
                    <span><%= artigo.author.nome %></span>
                    <span>·</span>
                    <span>Salvo em <%= l salvo.created_at, format: :short %></span>
                    <% if artigo.tempo_leitura %>
                      <span>·</span>
                      <span><%= artigo.tempo_leitura %> min</span>
                    <% end %>
                  </div>
                </div>
                <%= button_to usuario_salvo_path(salvo), method: :delete,
                    data: { turbo_confirm: "Remover dos salvos?" },
                    class: "shrink-0 p-1.5 text-gray-300 hover:text-red-500 rounded-lg hover:bg-red-50 transition-colors",
                    title: "Remover" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                <% end %>
              </div>
            </div>

          </div>
        </div>
      <% end %>
    </div>

    <div class="flex justify-center mt-4">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm">
      <div class="text-center py-16 px-6">
        <svg class="w-12 h-12 text-gray-200 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
        </svg>
        <p class="text-gray-500 font-medium">Nenhum artigo salvo ainda.</p>
        <p class="text-gray-400 text-sm mt-1">Salve artigos para lê-los depois.</p>
        <%= link_to "Explorar notícias", root_path, class: "btn-primary mt-5 inline-flex" %>
      </div>
    </div>
  <% end %>
</div>
