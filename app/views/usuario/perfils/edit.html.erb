<div class="max-w-xl mx-auto">
  <div class="card">
    <div class="card-header">
      <h3 class="font-semibold text-gray-800">Editar Perfil</h3>
    </div>
    <div class="card-body">
      <%= form_with model: [:usuario, @usuario], url: usuario_perfil_path, method: :patch,
          multipart: true, class: "space-y-5" do |f| %>
        <% if @usuario.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4">
            <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
              <% @usuario.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= f.label :nome, "Nome completo", class: "label" %>
          <%= f.text_field :nome, class: "input" %>
        </div>

        <div>
          <%= f.label :bio, "Sobre você", class: "label" %>
          <%= f.text_area :bio, rows: 4, class: "input resize-none",
              placeholder: "Uma breve descrição sobre você..." %>
        </div>

        <div>
          <%= f.label :avatar_image, "Foto de perfil", class: "label" %>
          <%= f.file_field :avatar_image, class: "block text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100",
              accept: "image/*" %>
        </div>

        <div class="flex gap-3 pt-2">
          <%= f.submit "Salvar Perfil", class: "btn-primary cursor-pointer" %>
          <%= link_to "Cancelar", usuario_perfil_path, class: "btn-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
