<% content_for :title, "Meu Perfil — #{@usuario.nome}" %>

<div class="max-w-3xl mx-auto space-y-5">

  <%# Card principal do perfil %>
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">

    <%# Banner / capa %>
    <div class="h-24 bg-gradient-to-r from-blue-600 to-indigo-600"></div>

    <%# Avatar + info %>
    <div class="px-6 pb-6">
      <div class="flex items-end justify-between -mt-10 mb-4">
        <div class="ring-4 ring-white rounded-full">
          <%= render "shared/user_avatar", user: @usuario, size: "xl" %>
        </div>
        <%= link_to edit_usuario_perfil_path,
            class: "flex items-center gap-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-semibold px-4 py-2 rounded-lg transition-colors self-end mb-1" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
          Editar perfil
        <% end %>
      </div>

      <div class="mb-4">
        <div class="flex items-center gap-3 flex-wrap">
          <h1 class="text-xl font-bold text-gray-900"><%= @usuario.nome %></h1>
          <% badge_cls = { "administrador" => "bg-purple-100 text-purple-700", "editor" => "bg-blue-100 text-blue-700", "usuario" => "bg-gray-100 text-gray-600" } %>
          <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full <%= badge_cls[@usuario.role] %>">
            <%= @usuario.role.humanize %>
          </span>
          <% if @usuario.subscription&.premium? %>
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 bg-amber-50 px-2.5 py-0.5 rounded-full">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              Premium
            </span>
          <% end %>
        </div>
        <p class="text-sm text-gray-500 mt-0.5"><%= @usuario.email %></p>
      </div>

      <% if @usuario.bio.present? %>
        <p class="text-sm text-gray-700 leading-relaxed"><%= @usuario.bio %></p>
      <% end %>
    </div>

    <%# Stats %>
    <div class="border-t border-gray-100 grid grid-cols-3 divide-x divide-gray-100">
      <div class="py-4 text-center">
        <p class="text-2xl font-bold text-gray-900"><%= @usuario.articles.publicados.count %></p>
        <p class="text-xs text-gray-500 mt-0.5">Artigos</p>
      </div>
      <div class="py-4 text-center">
        <p class="text-2xl font-bold text-gray-900"><%= @usuario.comments.count %></p>
        <p class="text-xs text-gray-500 mt-0.5">Comentários</p>
      </div>
      <div class="py-4 text-center">
        <p class="text-2xl font-bold text-gray-900"><%= @usuario.saved_articles.count %></p>
        <p class="text-xs text-gray-500 mt-0.5">Artigos Salvos</p>
      </div>
    </div>
  </div>

  <%# Info adicional %>
  <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
    <div class="flex items-center gap-3 text-gray-600">
      <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      Membro desde <%= l @usuario.created_at, format: :long rescue @usuario.created_at.strftime("%B de %Y") %>
    </div>
    <% if @usuario.provider.present? %>
      <div class="flex items-center gap-3 text-gray-600">
        <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
        </svg>
        Login via <span class="font-medium capitalize ml-1"><%= @usuario.provider %></span>
      </div>
    <% end %>
  </div>

</div>
