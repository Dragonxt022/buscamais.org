<div class="max-w-2xl mx-auto space-y-6">
  <div class="card">
    <div class="card-body">
      <div class="flex items-center gap-5 mb-6">
        <div class="w-20 h-20 rounded-full bg-blue-600 flex items-center justify-center text-white text-3xl font-bold flex-shrink-0">
          <%= @usuario.nome.first.upcase %>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-gray-900"><%= @usuario.nome %></h2>
          <p class="text-gray-500 text-sm"><%= @usuario.email %></p>
          <span class="text-xs bg-blue-100 text-blue-700 px-2.5 py-0.5 rounded-full font-semibold mt-1 inline-block">
            <%= @usuario.role.humanize %>
          </span>
        </div>
      </div>

      <% if @usuario.bio.present? %>
        <p class="text-gray-700 text-sm leading-relaxed border-t border-gray-100 pt-4"><%= @usuario.bio %></p>
      <% end %>

      <div class="border-t border-gray-100 pt-4 mt-4 flex gap-6 text-center">
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= @usuario.articles.publicados.count %></p>
          <p class="text-xs text-gray-500">Artigos</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= @usuario.comments.count %></p>
          <p class="text-xs text-gray-500">Comentários</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-gray-900"><%= @usuario.saved_articles.count %></p>
          <p class="text-xs text-gray-500">Salvos</p>
        </div>
      </div>
    </div>
  </div>

  <div class="flex justify-end">
    <%= link_to "Editar Perfil", edit_usuario_perfil_path, class: "btn-primary" %>
  </div>
</div>
