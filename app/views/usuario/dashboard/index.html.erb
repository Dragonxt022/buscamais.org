<% content_for :title, "Dashboard - Busca Mais" %>

<div class="space-y-6">
  <%# Banner de upgrade — só para plano gratuito %>
  <% if current_user.plano_atual&.gratuito? %>
    <% _proximo_plano = SubscriptionPlan.ativos.ordenados.find { |p| !p.gratuito? } %>
    <% if _proximo_plano %>
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 bg-gradient-to-r from-indigo-600 to-purple-600 text-white rounded-xl px-5 py-4">
        <div class="flex-1 min-w-0">
          <p class="font-bold text-sm">Você está no plano gratuito</p>
          <p class="text-xs text-indigo-200 mt-0.5">
            Assine o <strong><%= _proximo_plano.nome %></strong> por <%= _proximo_plano.preco_formatado %> e desbloqueie
            <%= _proximo_plano.beneficios.first(2).join(", ").downcase %> e muito mais.
          </p>
        </div>
        <button onclick="window.abrirUpsell()"
                class="shrink-0 bg-white text-indigo-700 font-bold text-sm px-5 py-2 rounded-lg hover:bg-indigo-50 transition-colors whitespace-nowrap">
          Ver planos →
        </button>
      </div>
    <% end %>
  <% end %>

  <%# Hero de boas-vindas %>
  <div class="bg-blue-900 text-white rounded-2xl p-6 sm:p-8">
    <h2 class="text-2xl sm:text-3xl font-bold mb-2">Bem-vindo de volta, <%= current_user.nome.split.first %>.</h2>
    <p class="text-blue-200 mb-5 text-sm sm:text-base">
      Seu resumo diário está pronto.
      <% if @topicos.any? %>
        Selecionamos novos artigos baseados no seu interesse em <%= @topicos.map(&:nome).to_sentence %>.
      <% end %>
    </p>
    <div class="flex flex-wrap gap-3">
      <%= link_to "Ler Resumo", usuario_root_path,
          class: "bg-white text-blue-900 px-5 py-2 rounded-lg text-sm font-semibold hover:bg-blue-50" %>
      <%= link_to "Gerenciar Tópicos", usuario_configuracoes_path,
          class: "border border-white text-white px-5 py-2 rounded-lg text-sm hover:bg-white/10" %>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
    <%# Coluna principal %>
    <div class="xl:col-span-2 space-y-6">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h3 class="font-bold text-gray-900">Recomendado para Você</h3>
            <p class="text-sm text-gray-500">Baseado em sua atividade recente e preferências</p>
          </div>
          <%= link_to "Ver Tudo", noticias_path, class: "text-sm text-blue-600 hover:underline shrink-0" %>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @recomendados.each do |artigo| %>
            <article class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow border border-gray-100 flex flex-col">
              <%# Imagem de capa %>
              <% if artigo.imagem_capa_file.attached? %>
                <div class="aspect-video overflow-hidden shimmer" data-controller="shimmer">
                  <%= image_tag rails_blob_path(artigo.imagem_capa_file.blob, only_path: true),
                      alt: artigo.titulo,
                      class: "w-full h-full object-cover",
                      loading: "lazy" %>
                </div>
              <% else %>
                <div class="aspect-video bg-gradient-to-br from-blue-50 to-gray-100 flex items-center justify-center">
                  <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
              <% end %>
              <div class="p-4 flex flex-col flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <% if artigo.category %>
                    <span class="text-xs font-bold text-blue-600 uppercase"><%= artigo.category.nome %></span>
                    <span class="text-gray-200">•</span>
                  <% end %>
                  <span class="text-xs text-gray-400"><%= artigo.tempo_leitura %> min</span>
                </div>
                <h4 class="font-bold text-gray-900 text-sm leading-snug mb-2 line-clamp-3 flex-1">
                  <%= link_to artigo.titulo, noticia_path(artigo.slug), class: "hover:text-blue-600" %>
                </h4>
                <div class="flex items-center justify-between mt-auto pt-3 border-t border-gray-50">
                  <%= link_to "Ler Mais →", noticia_path(artigo.slug),
                      class: "text-xs text-blue-600 hover:underline font-medium" %>
                  <%= button_to usuario_salvos_path(article_id: artigo.id), method: :post,
                      class: "text-gray-300 hover:text-blue-600 transition-colors", title: "Salvar" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                    </svg>
                  <% end %>
                </div>
              </div>
            </article>
          <% end %>
          <% if @recomendados.empty? %>
            <div class="sm:col-span-2 lg:col-span-3 text-center py-12 text-gray-400">
              <svg class="w-12 h-12 mx-auto mb-3 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-.586-1.414l-4.5-4.5A2 2 0 0013.5 3H5"/>
              </svg>
              <p class="text-sm">Nenhuma recomendação por enquanto.</p>
              <p class="text-xs mt-1">Configure seus tópicos de interesse para receber sugestões.</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Sidebar %>
    <div class="space-y-4">
      <%# Estatísticas %>
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Sequência de Leitura</p>
        <p class="text-5xl font-bold text-blue-600 my-2"><%= @sequencia %> <span class="text-2xl font-normal text-gray-400">dias</span></p>
        <div class="flex justify-around mt-4 pt-4 border-t border-gray-100">
          <div>
            <p class="text-xl font-bold text-gray-900"><%= @total_lidos %></p>
            <p class="text-xs text-gray-500">Artigos Lidos</p>
          </div>
          <div class="w-px bg-gray-100"></div>
          <div>
            <p class="text-xl font-bold text-gray-900"><%= current_user.subscription&.premium? ? "Premium" : "Gratuito" %></p>
            <p class="text-xs text-gray-500">Plano Atual</p>
          </div>
        </div>
      </div>

      <%# Assinatura %>
      <% if current_user.subscription %>
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Assinatura</p>
          <div class="flex items-center gap-2 mb-3">
            <% if current_user.subscription.premium? %>
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 bg-amber-50 px-2.5 py-1 rounded-full">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
                Premium
              </span>
            <% else %>
              <span class="text-sm font-medium text-gray-700">Plano Gratuito</span>
            <% end %>
          </div>
          <% if current_user.subscription.premium? %>
            <ul class="space-y-2 mb-4">
              <li class="flex items-center gap-2 text-xs text-gray-600">
                <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Acesso ilimitado ao arquivo
              </li>
              <li class="flex items-center gap-2 text-xs text-gray-600">
                <svg class="w-4 h-4 text-green-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Experiência sem anúncios
              </li>
            </ul>
            <% if current_user.subscription.prox_cobranca %>
              <p class="text-xs text-gray-400 mb-3">
                Próxima cobrança: <span class="font-medium text-gray-600"><%= l current_user.subscription.prox_cobranca, format: :long %></span>
              </p>
            <% end %>
          <% end %>
          <%= link_to "Gerenciar Assinatura", usuario_assinatura_path,
              class: "block text-center bg-blue-600 text-white py-2 rounded-lg text-sm font-semibold hover:bg-blue-700 transition-colors" %>
        </div>
      <% end %>

      <%# Ações rápidas %>
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Ações Rápidas</p>
        <div class="space-y-2">
          <%= link_to usuario_salvos_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition-colors group" do %>
            <svg class="w-5 h-5 text-gray-400 group-hover:text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
            </svg>
            <span class="text-sm text-gray-700 group-hover:text-blue-600">Artigos Salvos</span>
          <% end %>
          <%= link_to usuario_configuracoes_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-gray-50 transition-colors group" do %>
            <svg class="w-5 h-5 text-gray-400 group-hover:text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="text-sm text-gray-700 group-hover:text-blue-600">Configurações</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
