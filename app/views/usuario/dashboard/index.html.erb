<% content_for :title, "Dashboard - Busca Mais" %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <div class="lg:col-span-2 space-y-6">
    <div class="bg-blue-900 text-white rounded-2xl p-7">
      <h2 class="text-3xl font-bold mb-2">Bem-vindo de volta, <%= current_user.nome.split.first %>.</h2>
      <p class="text-blue-200 mb-5">
        Seu resumo diário está pronto.
        <% if @topicos.any? %>
          Selecionamos novos artigos baseados no seu interesse em <%= @topicos.map(&:nome).to_sentence %>.
        <% end %>
      </p>
      <div class="flex gap-3">
        <%= link_to "Ler Resumo", usuario_root_path,
            class: "bg-white text-blue-900 px-5 py-2 rounded-lg text-sm font-semibold hover:bg-blue-50" %>
        <%= link_to "Gerenciar Tópicos", usuario_configuracoes_path,
            class: "border border-white text-white px-5 py-2 rounded-lg text-sm hover:bg-white/10" %>
      </div>
    </div>

    <div>
      <div class="flex items-center justify-between mb-4">
        <div>
          <h3 class="font-bold text-gray-900">Recomendado para Você</h3>
          <p class="text-sm text-gray-500">Baseado em sua atividade recente e preferências</p>
        </div>
        <%= link_to "Ver Tudo", noticias_path, class: "text-sm text-blue-600 hover:underline" %>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <% @recomendados.each do |artigo| %>
          <article class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <div class="aspect-video bg-gray-200"></div>
            <div class="p-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="text-xs font-bold text-blue-600 uppercase"><%= artigo.category&.nome %></span>
                <span class="text-xs text-gray-400"><%= artigo.tempo_leitura %> min de leitura</span>
              </div>
              <h4 class="font-bold text-gray-900 text-sm leading-snug mb-2 line-clamp-3">
                <%= link_to artigo.titulo, noticia_path(artigo.slug), class: "hover:text-blue-600" %>
              </h4>
              <p class="text-xs text-gray-500 line-clamp-2"><%= artigo.resumo %></p>
              <div class="flex items-center justify-between mt-3">
                <%= link_to "Ler Mais →", noticia_path(artigo.slug),
                    class: "text-xs text-blue-600 hover:underline" %>
                <%= button_to usuario_salvos_path(article_id: artigo.id), method: :post,
                    class: "text-gray-400 hover:text-blue-600", title: "Salvar" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                  </svg>
                <% end %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    </div>
  </div>

  <div class="space-y-6">
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 text-center">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Sequência de Leitura</p>
      <p class="text-5xl font-bold text-blue-600 my-2"><%= @sequencia %> <span class="text-2xl">Dias</span></p>
      <div class="flex justify-around mt-4 pt-4 border-t border-gray-100">
        <div>
          <p class="text-lg font-bold text-gray-900"><%= @total_lidos %></p>
          <p class="text-xs text-gray-500">Artigos Lidos</p>
        </div>
        <div>
          <p class="text-lg font-bold text-gray-900"><%= current_user.subscription&.premium? ? "Premium" : "Gratuito" %></p>
          <p class="text-xs text-gray-500">Plano Atual</p>
        </div>
      </div>
    </div>

    <% if current_user.subscription %>
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Assinaturas</p>
        <p class="font-bold text-gray-900 mb-2">
          Assinatura <%= current_user.subscription.premium? ? "Premium" : "Gratuita" %>
        </p>
        <% if current_user.subscription.premium? %>
          <ul class="space-y-1.5 mb-4">
            <li class="flex items-center gap-2 text-sm text-gray-600">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Acesso ilimitado ao arquivo
            </li>
            <li class="flex items-center gap-2 text-sm text-gray-600">
              <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Experiência sem anúncios
            </li>
          </ul>
          <% if current_user.subscription.prox_cobranca %>
            <p class="text-xs text-gray-500">
              Próxima cobrança: <strong><%= l current_user.subscription.prox_cobranca, format: :long %></strong>
            </p>
          <% end %>
        <% end %>
        <%= link_to "Gerenciar Assinatura", usuario_assinatura_path,
            class: "mt-3 block text-center bg-blue-600 text-white py-2 rounded-lg text-sm font-semibold hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</div>
