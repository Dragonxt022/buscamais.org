<div class="max-w-3xl mx-auto space-y-5" data-controller="table-select"
     data-table-select-confirm-message-value="Remover {count} notificação(ões)?">

  <div class="flex items-center justify-between flex-wrap gap-3">
    <h2 class="text-xl font-bold text-gray-900">Notificações</h2>
    <div class="flex items-center gap-2">
      <% if @notificacoes.any? %>
        <%= button_to marcar_todas_lidas_usuario_notificacoes_path, method: :patch,
            class: "btn-secondary text-sm flex items-center gap-1.5" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Ler todas
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Bulk action bar %>
  <div data-table-select-target="bulkBar"
       class="hidden bg-blue-50 border border-blue-100 rounded-xl px-4 py-2.5 flex items-center gap-4">
    <span class="text-sm font-semibold text-blue-700" data-table-select-target="selectedCount"></span>
    <button type="button"
            data-action="click->table-select#deleteSelected"
            class="flex items-center gap-1.5 text-sm font-semibold text-red-600 hover:text-red-700 bg-white border border-red-200 px-3 py-1.5 rounded-lg hover:bg-red-50 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
      </svg>
      Excluir selecionadas
    </button>
    <button type="button" data-action="click->table-select#cancelSelection"
            class="text-sm text-gray-500 hover:text-gray-700">Cancelar</button>

    <form data-table-select-target="bulkForm"
          action="<%= bulk_destroy_usuario_notificacoes_path %>"
          method="post" class="hidden">
      <%= hidden_field_tag "_method", "delete" %>
      <%= hidden_field_tag "authenticity_token", form_authenticity_token %>
    </form>
  </div>

  <% if @notificacoes.any? %>
    <div class="space-y-2">
      <%# Select all header %>
      <label class="flex items-center gap-2 text-xs text-gray-500 cursor-pointer px-1">
        <input type="checkbox"
               data-table-select-target="checkbox"
               data-action="change->table-select#onSelectAll"
               data-select-all
               class="w-4 h-4 rounded border-gray-300 text-blue-600 cursor-pointer">
        Selecionar todas
      </label>

      <% @notificacoes.each do |n| %>
        <div class="card <%= n.lida? ? 'opacity-70' : 'border-l-4 border-l-blue-500' %>">
          <div class="card-body flex items-start gap-3">
            <input type="checkbox"
                   value="<%= n.id %>"
                   data-table-select-target="checkbox"
                   data-action="change->table-select#onSelect"
                   class="w-4 h-4 rounded border-gray-300 text-blue-600 cursor-pointer mt-1 flex-shrink-0">

            <span class="text-xl shrink-0"><%= n.icone %></span>

            <a href="<%= n.link %>" class="flex-1 min-w-0 hover:no-underline">
              <p class="text-sm text-gray-800 leading-relaxed"><%= n.mensagem %></p>
              <p class="text-xs text-gray-400 mt-0.5"><%= time_ago_in_words(n.created_at) %> atrás</p>
            </a>

            <% unless n.lida? %>
              <span class="w-2.5 h-2.5 rounded-full bg-blue-500 flex-shrink-0 mt-1.5" title="Não lida"></span>
            <% end %>

            <%= button_to usuario_notificacao_path(n), method: :delete,
                class: "p-1.5 rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50 transition-colors flex-shrink-0",
                title: "Remover",
                form: { "data-turbo": "false" } do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="flex justify-center mt-4">
      <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  <% else %>
    <div class="card">
      <div class="card-body text-center py-16">
        <svg class="w-12 h-12 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
        </svg>
        <p class="text-gray-400 font-medium">Você não tem notificações.</p>
      </div>
    </div>
  <% end %>
</div>
