<% content_for :title, "Contato - Busca Mais" %>

<div class="max-w-5xl mx-auto px-4 py-16">
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-3">Fale Conosco</h1>
    <p class="text-gray-500 text-lg">Dúvidas, sugestões, denúncias ou parcerias — estamos aqui.</p>
  </div>

  <div class="grid md:grid-cols-3 gap-8">

    <%# Formulário %>
    <div class="md:col-span-2">
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8">
        <h2 class="text-lg font-bold text-gray-900 mb-6">Enviar mensagem</h2>

        <%= form_with url: contato_path, method: :post, class: "space-y-5" do |f| %>
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Nome completo *</label>
              <%= text_field_tag :nome, nil,
                  required: true,
                  placeholder: "Seu nome",
                  class: "input" %>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">E-mail *</label>
              <%= email_field_tag :email, nil,
                  required: true,
                  placeholder: "seu@email.com",
                  class: "input" %>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Assunto *</label>
            <%= select_tag :assunto,
                options_for_select([
                  ["Selecione um assunto...", ""],
                  ["Dúvida geral", "duvida"],
                  ["Sugestão de pauta", "pauta"],
                  ["Denúncia / correção", "correcao"],
                  ["Parceria comercial", "parceria"],
                  ["Currículo espontâneo", "curriculo"],
                  ["Outro", "outro"]
                ]),
                required: true,
                class: "input" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Mensagem *</label>
            <%= text_area_tag :mensagem, nil,
                required: true,
                rows: 6,
                placeholder: "Descreva sua mensagem com detalhes...",
                class: "input resize-none" %>
          </div>
          <button type="submit"
                  class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg transition-colors">
            Enviar Mensagem →
          </button>
          <p class="text-xs text-gray-400 text-center">
            Respondemos em até 2 dias úteis. Campos marcados com * são obrigatórios.
          </p>
        <% end %>
      </div>
    </div>

    <%# Informações de contato %>
    <div class="space-y-4">
      <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 bg-blue-100 rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">E-mail</p>
            <p class="text-sm text-gray-700 mt-0.5">contato@buscamais.org</p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 bg-green-100 rounded-lg flex items-center justify-center shrink-0">
            <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Horário</p>
            <p class="text-sm text-gray-700 mt-0.5">Seg–Sex, 9h–18h</p>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Denúncias e correções</p>
        <p class="text-sm text-gray-500 leading-relaxed">
          Para denunciar erros editoriais ou informações incorretas em nossas matérias, selecione o assunto <strong>"Denúncia / correção"</strong> no formulário ao lado.
        </p>
      </div>

      <div class="bg-blue-50 rounded-xl border border-blue-100 p-5">
        <p class="text-xs font-semibold text-blue-500 uppercase tracking-wider mb-2">Boletim informativo</p>
        <p class="text-sm text-gray-600 mb-3">Receba as principais notícias diretamente no seu e-mail.</p>
        <%= link_to "Assinar gratuitamente →", boletim_path,
            class: "text-sm text-blue-600 font-semibold hover:underline" %>
      </div>
    </div>
  </div>
</div>
