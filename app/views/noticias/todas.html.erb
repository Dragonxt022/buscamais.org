<% content_for :title, "Todas as Notícias - Busca Mais" %>
<% content_for :meta_description, "Todas as notícias publicadas pelo Busca Mais, da mais recente para a mais antiga." %>
<% content_for :canonical, noticias_url %>

<div class="max-w-7xl mx-auto px-4 py-10">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900">Todas as Notícias</h1>
  </div>

  <% if @artigos.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      <% @artigos.each do |artigo| %>
        <article class="article-card">
          <div class="article-card-img">
            <% if artigo.imagem_capa_file.attached? %>
              <%= image_tag url_for(artigo.imagem_capa_file.variant(resize_to_limit: [600, 340], format: :webp)),
                  class: "w-full h-full object-cover hover:scale-105 transition-transform duration-300",
                  alt: artigo.titulo, loading: "lazy" %>
            <% end %>
          </div>
          <div class="p-5">
            <div class="flex items-center gap-2 mb-2">
              <% if artigo.category %>
                <span class="text-xs font-bold uppercase tracking-wider" style="color: <%= artigo.category.cor %>">
                  <%= artigo.category.nome %>
                </span>
              <% end %>
              <span class="text-xs text-gray-400"><%= artigo.tempo_leitura %> min</span>
            </div>
            <h3 class="font-bold text-gray-900 mb-2 leading-snug line-clamp-2">
              <%= link_to artigo.titulo, noticia_path(artigo.slug), class: "hover:text-blue-600" %>
            </h3>
            <p class="text-sm text-gray-500 line-clamp-2 mb-3"><%= artigo.resumo %></p>
            <div class="flex items-center justify-between text-xs text-gray-400 pt-3 border-t border-gray-100">
              <span><%= artigo.author.nome %></span>
              <span><%= l artigo.publicado_em, format: :short if artigo.publicado_em %></span>
            </div>
          </div>
        </article>
      <% end %>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="flex justify-center">
        <%== pagy_nav(@pagy) %>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-20">
      <p class="text-gray-400 text-lg">Nenhuma notícia publicada ainda.</p>
      <%= link_to "← Voltar para o início", root_path, class: "text-blue-600 hover:underline text-sm mt-2 inline-block" %>
    </div>
  <% end %>
</div>
