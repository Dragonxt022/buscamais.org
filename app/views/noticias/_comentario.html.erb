<%# locals: (comentario:, artigo:, nivel:) %>
<% curtido = user_signed_in? && comentario.curtido_por?(current_user) %>

<% if nivel == 0 %>
  <%# ═══════════════════════════════════════════════════════════════════
      COMENTÁRIO PRINCIPAL — card branco com sombra suave
      ══════════════════════════════════════════════════════════════════ %>
  <div id="comentario-<%= comentario.id %>" class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">

    <div class="flex gap-3">
      <%# Avatar %>
      <div class="w-9 h-9 rounded-full bg-blue-600 flex-shrink-0 flex items-center justify-center text-white text-sm font-bold">
        <%= comentario.user.nome.first.upcase %>
      </div>

      <div class="flex-1 min-w-0">
        <%# Header %>
        <div class="flex items-center justify-between gap-2 mb-1.5">
          <p class="text-sm font-semibold text-gray-900"><%= comentario.user.nome %></p>
          <p class="text-xs text-gray-400 shrink-0"><%= l comentario.created_at, format: :short %></p>
        </div>

        <%# Conteúdo %>
        <p class="text-sm text-gray-700 leading-relaxed"><%= comentario.conteudo %></p>

        <%# Ações %>
        <div class="flex items-center gap-4 mt-2.5">
          <%# Like %>
          <% if user_signed_in? %>
            <button type="button"
                    class="flex items-center gap-1 text-xs font-medium transition-colors <%= curtido ? 'text-blue-600' : 'text-gray-400 hover:text-blue-500' %>"
                    data-controller="like"
                    data-like-url-value="<%= curtir_comentario_path(comentario) %>"
                    data-like-liked-value="<%= curtido %>"
                    data-action="click->like#toggle">
              <svg class="w-3.5 h-3.5 transition-all" fill="<%= curtido ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24" data-like-target="icon">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
              <span data-like-target="count"><%= comentario.likes_count %></span>
            </button>
          <% else %>
            <span class="flex items-center gap-1 text-xs text-gray-400">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
              <%= comentario.likes_count %>
            </span>
          <% end %>
        </div>

        <%# Botão Responder + Formulário %>
        <% if user_signed_in? %>
          <div data-controller="comment-reply">
            <button type="button"
                    class="flex items-center gap-1 text-xs text-gray-400 hover:text-blue-600 font-medium transition-colors mt-2"
                    data-action="click->comment-reply#toggle">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
              </svg>
              Responder
            </button>

            <div data-comment-reply-target="form" class="hidden mt-3">
              <%= form_with url: comentarios_publicos_path, method: :post, class: "flex gap-2" do |f| %>
                <%= hidden_field_tag :article_id, artigo.slug %>
                <%= f.hidden_field :parent_id, value: comentario.id %>
                <div class="w-7 h-7 rounded-full bg-blue-600 flex-shrink-0 flex items-center justify-center text-white text-xs font-bold mt-0.5">
                  <%= current_user.nome.first.upcase %>
                </div>
                <div class="flex-1">
                  <textarea name="comment[conteudo]" rows="2"
                      placeholder="Responder a <%= comentario.user.nome %>..."
                      class="input resize-none text-sm mb-2"></textarea>
                  <div class="flex gap-2">
                    <button type="submit" class="bg-blue-600 text-white px-3 py-1 rounded-lg text-xs font-semibold hover:bg-blue-700 transition-colors">
                      Enviar
                    </button>
                    <button type="button" data-action="click->comment-reply#toggle"
                        class="text-xs text-gray-500 hover:text-gray-700 px-2 py-1 rounded-lg hover:bg-gray-100 transition-colors">
                      Cancelar
                    </button>
                  </div>
                </div>
              <% end %>
            </div>
          </div><%# /comment-reply %>
        <% end %>
      </div>
    </div>

    <%# ── Respostas colapsadas ──────────────────────────────────────────── %>
    <% replies = comentario.replies.aprovados.recentes %>
    <% if replies.any? %>
      <div class="mt-3 pl-12"
           data-controller="comment-thread"
           data-comment-thread-count-value="<%= replies.count %>">

        <%# Botão toggle %>
        <button type="button"
                class="flex items-center gap-1.5 text-xs font-semibold text-blue-600 hover:text-blue-800 transition-colors mb-3"
                data-action="click->comment-thread#toggle">
          <svg class="w-3.5 h-3.5 transition-transform duration-200" data-comment-thread-target="icon"
               fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
          </svg>
          <span data-comment-thread-target="label">
            Ver <%= replies.count %> <%= replies.count == 1 ? "resposta" : "respostas" %>
          </span>
        </button>

        <%# Lista de respostas (colapsada por padrão) %>
        <div data-comment-thread-target="replies" class="hidden space-y-2">
          <% replies.each do |reply| %>
            <%= render "noticias/comentario", comentario: reply, artigo: artigo, nivel: 1 %>
          <% end %>
        </div>
      </div>
    <% end %>

  </div><%# /card comentário principal %>

<% else %>
  <%# ═══════════════════════════════════════════════════════════════════
      RESPOSTA — visual diferenciado: fundo azul claro + borda lateral
      ══════════════════════════════════════════════════════════════════ %>
  <div id="comentario-<%= comentario.id %>" class="flex gap-2.5">

    <%# Linha conectora + avatar pequeno %>
    <div class="flex flex-col items-center shrink-0">
      <div class="w-7 h-7 rounded-full bg-indigo-500 flex items-center justify-center text-white text-xs font-bold">
        <%= comentario.user.nome.first.upcase %>
      </div>
    </div>

    <%# Balão de resposta %>
    <div class="flex-1 min-w-0 bg-blue-50 border border-blue-100 rounded-xl px-3.5 py-2.5">
      <%# "Em resposta a" badge %>
      <% if comentario.parent %>
        <p class="text-[10px] font-semibold text-blue-400 uppercase tracking-wide mb-1 flex items-center gap-1">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
          </svg>
          Em resposta a <span class="text-blue-600"><%= comentario.parent.user.nome %></span>
        </p>
      <% end %>

      <%# Header %>
      <div class="flex items-center justify-between gap-2 mb-1">
        <p class="text-xs font-semibold text-gray-800"><%= comentario.user.nome %></p>
        <p class="text-[10px] text-gray-400 shrink-0"><%= l comentario.created_at, format: :short %></p>
      </div>

      <%# Conteúdo %>
      <p class="text-sm text-gray-700 leading-relaxed"><%= comentario.conteudo %></p>

      <%# Ações %>
      <div class="flex items-center gap-3 mt-2">
        <%# Like %>
        <% if user_signed_in? %>
          <button type="button"
                  class="flex items-center gap-1 text-xs font-medium transition-colors <%= curtido ? 'text-blue-600' : 'text-gray-400 hover:text-blue-500' %>"
                  data-controller="like"
                  data-like-url-value="<%= curtir_comentario_path(comentario) %>"
                  data-like-liked-value="<%= curtido %>"
                  data-action="click->like#toggle">
            <svg class="w-3.5 h-3.5 transition-all" fill="<%= curtido ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24" data-like-target="icon">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
            <span data-like-target="count"><%= comentario.likes_count %></span>
          </button>
        <% else %>
          <span class="flex items-center gap-1 text-xs text-gray-400">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
            <%= comentario.likes_count %>
          </span>
        <% end %>

        <%# Responder (nível 1 pode ter resposta de nível 2) %>
        <% if user_signed_in? && nivel < 2 %>
          <div data-controller="comment-reply">
            <button type="button"
                    class="flex items-center gap-1 text-xs text-gray-400 hover:text-blue-600 font-medium transition-colors"
                    data-action="click->comment-reply#toggle">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
              </svg>
              Responder
            </button>

            <div data-comment-reply-target="form" class="hidden mt-2">
              <%= form_with url: comentarios_publicos_path, method: :post, class: "flex gap-2" do |f| %>
                <%= hidden_field_tag :article_id, artigo.slug %>
                <%= f.hidden_field :parent_id, value: comentario.id %>
                <div class="flex-1">
                  <textarea name="comment[conteudo]" rows="2"
                      placeholder="Responder a <%= comentario.user.nome %>..."
                      class="input resize-none text-xs mb-1.5"></textarea>
                  <div class="flex gap-2">
                    <button type="submit" class="bg-blue-600 text-white px-2.5 py-1 rounded-lg text-xs font-semibold hover:bg-blue-700 transition-colors">
                      Enviar
                    </button>
                    <button type="button" data-action="click->comment-reply#toggle"
                        class="text-xs text-gray-400 hover:text-gray-600 px-2 py-1 rounded-lg hover:bg-blue-100 transition-colors">
                      Cancelar
                    </button>
                  </div>
                </div>
              <% end %>
            </div>
          </div><%# /comment-reply %>
        <% end %>
      </div>

      <%# Sub-respostas do nivel 1 (nivel 2 — exibidas direto, sem colapso) %>
      <% sub_replies = comentario.replies.aprovados.recentes %>
      <% if sub_replies.any? %>
        <div class="mt-3 space-y-2 border-t border-blue-100 pt-3">
          <% sub_replies.each do |sub| %>
            <%= render "noticias/comentario", comentario: sub, artigo: artigo, nivel: 2 %>
          <% end %>
        </div>
      <% end %>
    </div>

  </div><%# /resposta %>
<% end %>
