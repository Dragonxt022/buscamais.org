<% content_for :title, "#{@artigo.titulo} - Busca Mais" %>
<% content_for :meta_description, @artigo.resumo %>

<% content_for :head do %>
  <meta property="og:type"        content="article">
  <meta property="og:site_name"   content="Busca Mais">
  <meta property="og:title"       content="<%= @artigo.titulo %>">
  <meta property="og:description" content="<%= strip_tags(@artigo.resumo.to_s) %>">
  <meta property="og:url"         content="<%= request.url %>">
  <% if @artigo.imagem_capa_file.attached? %>
    <% og_image_url = request.base_url + rails_blob_path(@artigo.imagem_capa_file.blob) %>
    <meta property="og:image"        content="<%= og_image_url %>">
    <meta property="og:image:width"  content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:image"       content="<%= og_image_url %>">
  <% end %>
  <meta property="article:published_time" content="<%= @artigo.publicado_em&.iso8601 %>">
  <meta property="article:author"         content="<%= @artigo.author.nome %>">
  <meta name="twitter:card"        content="summary_large_image">
  <meta name="twitter:title"       content="<%= @artigo.titulo %>">
  <meta name="twitter:description" content="<%= strip_tags(@artigo.resumo.to_s) %>">
<% end %>

<div class="max-w-4xl mx-auto px-4 py-10">
  <div class="mb-6">
    <div class="flex items-center gap-2 mb-4">
      <% if @artigo.category %>
        <%= link_to @artigo.category.nome, categoria_path(@artigo.category.slug),
            class: "text-xs font-bold uppercase tracking-wider px-3 py-1 rounded text-white",
            style: "background-color: #{@artigo.category.cor}" %>
      <% end %>
      <span class="text-xs text-gray-400">
        <%= @artigo.tempo_leitura %> min de leitura
      </span>
    </div>

    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 leading-tight mb-4">
      <%= @artigo.titulo %>
    </h1>

    <% if @artigo.resumo.present? %>
      <p class="text-lg text-gray-500 leading-relaxed mb-5"><%= @artigo.resumo %></p>
    <% end %>

    <div class="flex items-center justify-between py-4 border-t border-b border-gray-100">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold">
          <%= @artigo.author.nome.first.upcase %>
        </div>
        <div>
          <p class="text-sm font-semibold text-gray-900"><%= @artigo.author.nome %></p>
          <p class="text-xs text-gray-400">
            <%= l @artigo.publicado_em, format: :long if @artigo.publicado_em %>
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3 text-xs text-gray-400">
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
          <%= number_with_delimiter(@artigo.visualizacoes) %> leituras
        </span>
        <% if user_signed_in? %>
          <%= button_to usuario_salvos_path(article_id: @artigo.id), method: :post,
              class: "flex items-center gap-1 text-gray-400 hover:text-blue-600 transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
            </svg>
            Salvar
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @artigo.tags.any? %>
    <div class="flex flex-wrap gap-2 mb-6">
      <% @artigo.tags.each do |tag| %>
        <span class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full">#<%= tag.nome %></span>
      <% end %>
    </div>
  <% end %>

  <% if @artigo.imagem_capa_file.attached? %>
    <div class="mb-8 rounded-xl overflow-hidden shimmer" data-controller="shimmer">
      <%= image_tag url_for(@artigo.imagem_capa_file),
          class: "w-full max-h-[480px] object-cover",
          alt: @artigo.titulo %>
    </div>
  <% end %>

  <div class="prose prose-lg max-w-none text-gray-800 leading-relaxed mb-8">
    <%= @artigo.conteudo %>
  </div>

  <%# Social sharing %>
  <div class="border-t border-b border-gray-100 py-5 mb-10">
    <p class="text-sm font-semibold text-gray-500 mb-3">Compartilhar:</p>
    <div class="flex items-center gap-3 flex-wrap">
      <% share_url  = request.original_url %>
      <% share_text = @artigo.titulo %>

      <%# Facebook %>
      <%= link_to "https://www.facebook.com/sharer/sharer.php?u=#{CGI.escape(share_url)}",
          target: "_blank", rel: "noopener",
          class: "flex items-center gap-2 bg-[#1877F2] hover:bg-[#166fe5] text-white text-xs font-semibold px-4 py-2 rounded-lg transition-colors" do %>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
        Facebook
      <% end %>

      <%# Twitter/X %>
      <%= link_to "https://twitter.com/intent/tweet?url=#{CGI.escape(share_url)}&text=#{CGI.escape(share_text)}",
          target: "_blank", rel: "noopener",
          class: "flex items-center gap-2 bg-black hover:bg-gray-800 text-white text-xs font-semibold px-4 py-2 rounded-lg transition-colors" do %>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        X (Twitter)
      <% end %>

      <%# WhatsApp %>
      <%= link_to "https://api.whatsapp.com/send?text=#{CGI.escape(share_text + ' ' + share_url)}",
          target: "_blank", rel: "noopener",
          class: "flex items-center gap-2 bg-[#25D366] hover:bg-[#20bd5c] text-white text-xs font-semibold px-4 py-2 rounded-lg transition-colors" do %>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp
      <% end %>

      <%# Copy link %>
      <button type="button"
              data-action="click->share#copyLink"
              data-share-url="<%= share_url %>"
              data-controller="share"
              class="flex items-center gap-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold px-4 py-2 rounded-lg transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
        <span data-share-target="label">Copiar link</span>
      </button>
    </div>
  </div>

  <%# Related articles %>
  <% if @artigos_relacionados.any? %>
    <section class="border-t border-gray-100 pt-10 mb-12">
      <h3 class="text-lg font-bold text-gray-900 mb-5">Artigos Relacionados</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <% @artigos_relacionados.each do |artigo| %>
          <article class="article-card">
            <div class="article-card-img <%= artigo.imagem_capa_file.attached? ? 'shimmer' : '' %>"
                 <%= "data-controller=shimmer" if artigo.imagem_capa_file.attached? %>>
              <% if artigo.imagem_capa_file.attached? %>
                <%= image_tag url_for(artigo.imagem_capa_file),
                    class: "w-full h-full object-cover",
                    alt: artigo.titulo %>
              <% end %>
            </div>
            <div class="p-4">
              <h4 class="font-semibold text-gray-900 text-sm leading-snug mb-2 line-clamp-2">
                <%= link_to artigo.titulo, noticia_path(artigo.slug), class: "hover:text-blue-600" %>
              </h4>
              <p class="text-xs text-gray-400"><%= l artigo.publicado_em, format: :short if artigo.publicado_em %></p>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# Comments section %>
  <section id="secao-comentarios" class="border-t border-gray-100 pt-10">
    <h3 class="text-lg font-bold text-gray-900 mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
      </svg>
      Comentários (<%= @comentarios.sum { |c| 1 + c.replies.size + c.replies.sum { |r| r.replies.size } } %>)
    </h3>

    <%# New comment form %>
    <% if user_signed_in? %>
      <div class="bg-white rounded-xl border border-gray-200 p-4 mb-8">
        <div class="flex gap-3">
          <div class="w-9 h-9 rounded-full bg-blue-600 flex-shrink-0 flex items-center justify-center text-white text-sm font-bold">
            <%= current_user.nome.first.upcase %>
          </div>
          <%= form_with url: comentarios_publicos_path, method: :post, class: "flex-1" do |f| %>
            <%= hidden_field_tag :article_id, @artigo.slug %>
            <textarea name="comment[conteudo]" rows="3" placeholder="Escreva um comentário..."
                class="input resize-none mb-3 text-sm"></textarea>
            <div class="flex items-center justify-between">
              <p class="text-xs text-gray-400">Seu comentário será publicado após aprovação.</p>
              <button type="submit"
                  class="bg-blue-600 text-white px-4 py-1.5 rounded-lg text-sm font-semibold hover:bg-blue-700 transition-colors flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                </svg>
                Comentar
              </button>
            </div>
          <% end %>
        </div>
      </div>
    <% else %>
      <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 mb-8 text-center">
        <p class="text-sm text-blue-700">
          <%= link_to "Entre", new_user_session_path, class: "font-semibold underline hover:no-underline" %>
          ou
          <%= link_to "cadastre-se", new_user_registration_path, class: "font-semibold underline hover:no-underline" %>
          para deixar um comentário.
        </p>
      </div>
    <% end %>

    <%# Mensagem inline após envio — sem toast %>
    <% if flash[:comentario_pendente] %>
      <div class="flex items-start gap-3 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 mb-6">
        <svg class="w-4 h-4 text-amber-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="text-sm text-amber-800 font-medium">Comentário enviado — aguardando aprovação.</p>
      </div>
    <% end %>

    <%# Thread of comments %>
    <div class="space-y-4" id="comentarios">
      <% @comentarios.each do |comentario| %>
        <%= render "noticias/comentario", comentario: comentario, artigo: @artigo, nivel: 0 %>
      <% end %>
    </div>
  </section>
</div>
