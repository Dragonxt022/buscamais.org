<% content_for :title, "#{@artigo.titulo} - Busca Mais" %>
<% content_for :meta_description, @artigo.resumo %>
<% content_for :canonical, noticia_url(@artigo.slug) %>

<% content_for :head do %>
  <meta property="og:type"        content="article">
  <meta property="og:site_name"   content="Busca Mais">
  <meta property="og:title"       content="<%= @artigo.titulo %>">
  <meta property="og:description" content="<%= strip_tags(@artigo.resumo.to_s) %>">
  <meta property="og:url"         content="<%= noticia_url(@artigo.slug) %>">
  <% _img_url = @artigo.imagem_capa_file.attached? ? request.base_url + rails_blob_path(@artigo.imagem_capa_file.blob) : nil %>
  <% if _img_url %>
    <meta property="og:image"        content="<%= _img_url %>">
    <meta property="og:image:width"  content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:image"       content="<%= _img_url %>">
  <% end %>
  <meta property="article:published_time" content="<%= @artigo.publicado_em&.iso8601 %>">
  <meta property="article:author"         content="<%= @artigo.author.nome %>">
  <meta name="twitter:card"        content="summary_large_image">
  <meta name="twitter:title"       content="<%= @artigo.titulo %>">
  <meta name="twitter:description" content="<%= strip_tags(@artigo.resumo.to_s) %>">

  <%# JSON-LD NewsArticle %>
  <% _site_nome = SiteSetting["site_titulo"].presence || "Busca Mais" %>
  <% _logo_url  = SiteBranding.instance.logo.attached? ? request.base_url + rails_blob_path(SiteBranding.instance.logo.blob) : nil %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    "headline": <%= @artigo.titulo.to_json %>,
    "description": <%= strip_tags(@artigo.resumo.to_s).to_json %>,
    "url": <%= noticia_url(@artigo.slug).to_json %>,
    "datePublished": <%= @artigo.publicado_em&.iso8601.to_json %>,
    "dateModified": <%= @artigo.updated_at.iso8601.to_json %>,
    <% if _img_url %>
    "image": {
      "@type": "ImageObject",
      "url": <%= _img_url.to_json %>
    },
    <% end %>
    "author": {
      "@type": "Person",
      "name": <%= @artigo.author.nome.to_json %>,
      "url": <%= autor_url(@artigo.author.slug).to_json %>
    },
    "publisher": {
      "@type": "Organization",
      "name": <%= _site_nome.to_json %>
      <% if _logo_url %>
      ,"logo": {
        "@type": "ImageObject",
        "url": <%= _logo_url.to_json %>
      }
      <% end %>
    }
  }
  </script>
<% end %>

<div class="max-w-4xl mx-auto px-4 py-10">
  <div class="mb-6">
    <div class="flex items-center gap-2 mb-4">
      <% if @artigo.category %>
        <%= link_to @artigo.category.nome, categoria_path(@artigo.category.slug),
            class: "text-xs font-bold uppercase tracking-wider px-3 py-1 rounded text-white",
            style: "background-color: #{@artigo.category.cor}" %>
      <% end %>
      <% if @artigo.premium? %>
        <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded bg-amber-500 text-white flex items-center gap-1">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          Premium
        </span>
      <% end %>
      <span class="text-xs text-gray-400">
        <%= @artigo.tempo_leitura %> min de leitura
      </span>
    </div>

    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 leading-tight mb-4">
      <%= @artigo.titulo %>
    </h1>

    <% if @artigo.resumo.present? %>
      <p class="text-lg text-gray-500 leading-relaxed mb-5"><%= @artigo.resumo %></p>
    <% end %>

    <div class="flex items-center justify-between py-4 border-t border-b border-gray-100">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold">
          <%= @artigo.author.nome.first.upcase %>
        </div>
        <div>
          <p class="text-sm font-semibold text-gray-900"><%= @artigo.author.nome %></p>
          <p class="text-xs text-gray-400">
            <%= l @artigo.publicado_em, format: :long if @artigo.publicado_em %>
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3 text-xs text-gray-400">
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
          <%= number_with_delimiter(@artigo.visualizacoes) %> leituras
        </span>
        <% if user_signed_in? %>
          <%= button_to usuario_salvos_path(article_id: @artigo.id), method: :post,
              class: "flex items-center gap-1 text-gray-400 hover:text-blue-600 transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
            </svg>
            Salvar
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @artigo.tags.any? %>
    <div class="flex flex-wrap gap-2 mb-6">
      <% @artigo.tags.each do |tag| %>
        <span class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full">#<%= tag.nome %></span>
      <% end %>
    </div>
  <% end %>

  <% if @artigo.imagem_capa_file.attached? %>
    <div class="mb-8 rounded-xl overflow-hidden shimmer" data-controller="shimmer">
      <%= image_tag url_for(@artigo.imagem_capa_file),
          class: "w-full max-h-[480px] object-cover",
          alt: @artigo.titulo %>
    </div>
  <% end %>

  <% if @acesso_completo %>
    <div class="prose prose-lg max-w-none text-gray-800 leading-relaxed mb-8">
      <%= @artigo.conteudo %>
    </div>
  <% else %>
    <%# Conteúdo truncado com fade-out %>
    <div class="relative mb-2" style="max-height: 320px; overflow: hidden;">
      <div class="prose prose-lg max-w-none text-gray-800 leading-relaxed">
        <%= @artigo.conteudo %>
      </div>
      <%# Gradiente de fade %>
      <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-white via-white/90 to-transparent pointer-events-none"></div>
    </div>

    <%# Paywall gate %>
    <%= render "shared/paywall_gate",
               artigos_premium_restantes: @artigos_premium_restantes.to_i,
               plano_com_promo: @plano_com_promo,
               plano_pago: @plano_pago %>
  <% end %>

  <% unless @acesso_completo %><%# Não mostra sharing/comments sem acesso %><% end %>
  <% if @acesso_completo %>
  <%# Social sharing %>
  <div class="border-t border-b border-gray-100 py-5 mb-10">
    <p class="text-sm font-semibold text-gray-500 mb-3">Compartilhar:</p>
    <div class="flex items-center gap-3 flex-wrap">
      <% share_url  = request.original_url %>
      <% share_text = @artigo.titulo %>

      <%# Facebook %>
      <%= link_to "https://www.facebook.com/sharer/sharer.php?u=#{CGI.escape(share_url)}",
          target: "_blank", rel: "noopener",
          class: "flex items-center gap-2 bg-[#1877F2] hover:bg-[#166fe5] text-white text-xs font-semibold px-4 py-2 rounded-lg transition-colors" do %>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
        </svg>
        Facebook
      <% end %>

      <%# Twitter/X %>
      <%= link_to "https://twitter.com/intent/tweet?url=#{CGI.escape(share_url)}&text=#{CGI.escape(share_text)}",
          target: "_blank", rel: "noopener",
          class: "flex items-center gap-2 bg-black hover:bg-gray-800 text-white text-xs font-semibold px-4 py-2 rounded-lg transition-colors" do %>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        X (Twitter)
      <% end %>

      <%# WhatsApp %>
      <%= link_to "https://api.whatsapp.com/send?text=#{CGI.escape(share_text + ' ' + share_url)}",
          target: "_blank", rel: "noopener",
          class: "flex items-center gap-2 bg-[#25D366] hover:bg-[#20bd5c] text-white text-xs font-semibold px-4 py-2 rounded-lg transition-colors" do %>
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp
      <% end %>

      <%# Copy link %>
      <button type="button"
              data-action="click->share#copyLink"
              data-share-url="<%= share_url %>"
              data-controller="share"
              class="flex items-center gap-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold px-4 py-2 rounded-lg transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
        <span data-share-target="label">Copiar link</span>
      </button>
    </div>
  </div>

  <%# Related articles %>
  <% if @artigos_relacionados.any? %>
    <section class="border-t border-gray-100 pt-10 mb-12">
      <h3 class="text-lg font-bold text-gray-900 mb-5">Artigos Relacionados</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <% @artigos_relacionados.each do |artigo| %>
          <article class="article-card">
            <div class="article-card-img <%= artigo.imagem_capa_file.attached? ? 'shimmer' : '' %>"
                 <%= "data-controller=shimmer" if artigo.imagem_capa_file.attached? %>>
              <% if artigo.imagem_capa_file.attached? %>
                <%= image_tag url_for(artigo.imagem_capa_file),
                    class: "w-full h-full object-cover",
                    alt: artigo.titulo %>
              <% end %>
            </div>
            <div class="p-4">
              <h4 class="font-semibold text-gray-900 text-sm leading-snug mb-2 line-clamp-2">
                <%= link_to artigo.titulo, noticia_path(artigo.slug), class: "hover:text-blue-600" %>
              </h4>
              <p class="text-xs text-gray-400"><%= l artigo.publicado_em, format: :short if artigo.publicado_em %></p>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# Comments section %>
  <section id="secao-comentarios" class="border-t border-gray-100 pt-10">
    <% total_comentarios = @comentarios.sum { |c| 1 + c.replies.size + c.replies.sum { |r| r.replies.size } } %>
    <div class="flex items-center justify-between mb-5">
      <h3 class="text-base font-bold text-gray-900 flex items-center gap-2">
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
        <%= total_comentarios %> comentário<%= total_comentarios == 1 ? "" : "s" %>
      </h3>
      <%# Sort top/novo %>
      <div class="flex items-center gap-1 bg-gray-100 rounded-full p-0.5 text-xs font-bold">
        <%= link_to noticia_path(@artigo.slug, anchor: "secao-comentarios", sort: "top"),
            class: "px-3 py-1 rounded-full transition-colors #{@sort_comentarios == 'top' ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-500 hover:text-gray-700'}" do %>
          ↑ Top
        <% end %>
        <%= link_to noticia_path(@artigo.slug, anchor: "secao-comentarios", sort: "novo"),
            class: "px-3 py-1 rounded-full transition-colors #{@sort_comentarios == 'novo' ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-500 hover:text-gray-700'}" do %>
          🕐 Novo
        <% end %>
      </div>
    </div>

    <%# Formulário de novo comentário — estilo Reddit %>
    <% if user_signed_in? %>
      <div class="mb-6">
        <div class="flex gap-3 items-start">
          <div class="w-8 h-8 rounded-full bg-blue-600 shrink-0 flex items-center justify-center text-white text-xs font-bold mt-1">
            <%= current_user.nome.first.upcase %>
          </div>
          <%= form_with url: comentarios_publicos_path, method: :post, class: "flex-1" do |f| %>
            <%= hidden_field_tag :article_id, @artigo.slug %>
            <div class="border border-gray-200 rounded-xl overflow-hidden focus-within:ring-2 focus-within:ring-blue-300 focus-within:border-blue-400 transition-all bg-white shadow-sm">
              <textarea name="comment[conteudo]" rows="4" placeholder="O que você acha? Compartilhe sua opinião…"
                  class="w-full px-4 pt-4 pb-2 text-sm text-gray-800 placeholder-gray-400 resize-none outline-none bg-transparent leading-relaxed"
                  style="min-height: 100px"></textarea>
              <div class="flex items-center justify-between px-4 py-2.5 bg-gray-50 border-t border-gray-100">
                <p class="text-xs text-gray-400">Será publicado após aprovação.</p>
                <button type="submit"
                    class="bg-blue-600 text-white px-5 py-1.5 rounded-full text-sm font-bold hover:bg-blue-700 transition-colors flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                  </svg>
                  Comentar
                </button>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Visitantes não logados %>
    <% unless user_signed_in? %>
      <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 mb-6 text-center">
        <p class="text-sm text-blue-700">
          <%= link_to "Entre", new_user_session_path, class: "font-semibold underline hover:no-underline" %>
          ou
          <%= link_to "cadastre-se", new_user_registration_path, class: "font-semibold underline hover:no-underline" %>
          para participar da conversa.
        </p>
      </div>
    <% end %>

    <%# Mensagem de comentário pendente %>
    <% if flash[:comentario_pendente] %>
      <div class="flex items-start gap-3 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 mb-5">
        <svg class="w-4 h-4 text-amber-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="text-sm text-amber-800 font-medium">Comentário enviado — aguardando aprovação.</p>
      </div>
    <% end %>

    <%# Threads de comentários estilo Reddit %>
    <div class="space-y-3" id="comentarios">
      <% @comentarios.each do |comentario| %>
        <%= render "noticias/comentario", comentario: comentario, artigo: @artigo, nivel: 0 %>
      <% end %>
      <% if @comentarios.empty? %>
        <p class="text-gray-400 text-sm py-8 text-center">Seja o primeiro a comentar.</p>
      <% end %>
    </div>
  </section>
  <% end %><%# /if @acesso_completo %>
</div>
