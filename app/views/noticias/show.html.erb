<% content_for :title, "#{@artigo.titulo} - Busca Mais" %>
<% content_for :meta_description, @artigo.resumo %>

<div class="max-w-4xl mx-auto px-4 py-10">
  <div class="mb-6">
    <div class="flex items-center gap-2 mb-4">
      <% if @artigo.category %>
        <%= link_to @artigo.category.nome, categoria_path(@artigo.category.slug),
            class: "text-xs font-bold uppercase tracking-wider px-3 py-1 rounded text-white",
            style: "background-color: #{@artigo.category.cor}" %>
      <% end %>
      <span class="text-xs text-gray-400">
        <%= @artigo.tempo_leitura %> min de leitura
      </span>
    </div>

    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 leading-tight mb-4">
      <%= @artigo.titulo %>
    </h1>

    <% if @artigo.resumo.present? %>
      <p class="text-lg text-gray-500 leading-relaxed mb-5"><%= @artigo.resumo %></p>
    <% end %>

    <div class="flex items-center justify-between py-4 border-t border-b border-gray-100">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold">
          <%= @artigo.author.nome.first.upcase %>
        </div>
        <div>
          <p class="text-sm font-semibold text-gray-900"><%= @artigo.author.nome %></p>
          <p class="text-xs text-gray-400">
            <%= l @artigo.publicado_em, format: :long if @artigo.publicado_em %>
          </p>
        </div>
      </div>
      <div class="flex items-center gap-4 text-xs text-gray-400">
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
          <%= number_with_delimiter(@artigo.visualizacoes) %> leituras
        </span>
        <% if user_signed_in? %>
          <%= button_to usuario_salvos_path(article_id: @artigo.id), method: :post,
              class: "flex items-center gap-1 text-gray-400 hover:text-blue-600 transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
            </svg>
            Salvar
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @artigo.tags.any? %>
    <div class="flex flex-wrap gap-2 mb-6">
      <% @artigo.tags.each do |tag| %>
        <span class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full">#<%= tag.nome %></span>
      <% end %>
    </div>
  <% end %>

  <% if @artigo.imagem_capa_file.attached? %>
    <div class="mb-8 rounded-xl overflow-hidden">
      <%= image_tag url_for(@artigo.imagem_capa_file),
          class: "w-full max-h-[480px] object-cover",
          alt: @artigo.titulo %>
    </div>
  <% end %>

  <div class="prose prose-lg max-w-none text-gray-800 leading-relaxed mb-12">
    <%= @artigo.conteudo %>
  </div>

  <% if @artigos_relacionados.any? %>
    <section class="border-t border-gray-100 pt-10 mb-12">
      <h3 class="text-lg font-bold text-gray-900 mb-5">Artigos Relacionados</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <% @artigos_relacionados.each do |artigo| %>
          <article class="article-card">
            <div class="article-card-img">
              <% if artigo.imagem_capa_file.attached? %>
                <%= image_tag url_for(artigo.imagem_capa_file),
                    class: "w-full h-full object-cover",
                    alt: artigo.titulo %>
              <% end %>
            </div>
            <div class="p-4">
              <h4 class="font-semibold text-gray-900 text-sm leading-snug mb-2 line-clamp-2">
                <%= link_to artigo.titulo, noticia_path(artigo.slug), class: "hover:text-blue-600" %>
              </h4>
              <p class="text-xs text-gray-400"><%= l artigo.publicado_em, format: :short if artigo.publicado_em %></p>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="border-t border-gray-100 pt-10">
    <h3 class="text-lg font-bold text-gray-900 mb-6">
      Comentários (<%= @comentarios.count %>)
    </h3>

    <% if user_signed_in? %>
      <%= form_with url: comentarios_publicos_path, method: :post, class: "mb-8" do |f| %>
        <%= hidden_field_tag :article_id, @artigo.slug %>
        <div class="flex gap-3">
          <div class="w-9 h-9 rounded-full bg-blue-600 flex-shrink-0 flex items-center justify-center text-white text-sm font-bold">
            <%= current_user.nome.first.upcase %>
          </div>
          <div class="flex-1">
            <textarea name="comment[conteudo]" rows="3" placeholder="Escreva um comentário..."
                class="input resize-none mb-2"></textarea>
            <button type="submit"
                class="bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-blue-700">
              Enviar Comentário
            </button>
            <p class="text-xs text-gray-400 mt-1">Seu comentário será publicado após aprovação.</p>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-sm text-gray-500 mb-6">
        <%= link_to "Entre", new_user_session_path, class: "text-blue-600 hover:underline" %>
        para deixar um comentário.
      </p>
    <% end %>

    <div class="space-y-5">
      <% @comentarios.each do |comentario| %>
        <div class="flex gap-3">
          <div class="w-9 h-9 rounded-full bg-gray-300 flex-shrink-0 flex items-center justify-center text-gray-600 text-sm font-bold">
            <%= comentario.user.nome.first.upcase %>
          </div>
          <div class="flex-1 bg-gray-50 rounded-xl p-4">
            <div class="flex items-center justify-between mb-1">
              <p class="text-sm font-semibold text-gray-900"><%= comentario.user.nome %></p>
              <p class="text-xs text-gray-400"><%= l comentario.created_at, format: :short %></p>
            </div>
            <p class="text-sm text-gray-700 leading-relaxed"><%= comentario.conteudo %></p>
          </div>
        </div>
      <% end %>
    </div>
  </section>
</div>
