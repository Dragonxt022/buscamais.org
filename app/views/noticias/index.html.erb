<% content_for :title, "Busca Mais - Notícias" %>

<style>
  @keyframes ticker-slide {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .ticker-track {
    display: flex;
    animation: ticker-slide 35s linear infinite;
    width: max-content;
  }
  .ticker-track:hover { animation-play-state: paused; }
</style>

<%# ── Hero gigante (começa atrás do nav transparente) ───────── %>
<% if @artigo_destaque %>
  <section id="hero-section"
           class="relative text-white overflow-hidden"
           style="height: 100vh; min-height: 520px; margin-top: -3.5rem;">
    <% if @artigo_destaque.imagem_capa_file.attached? %>
      <%= image_tag url_for(@artigo_destaque.imagem_capa_file),
          class: "absolute inset-0 w-full h-full object-cover",
          alt: @artigo_destaque.titulo %>
    <% else %>
      <div class="absolute inset-0 bg-gradient-to-br from-gray-800 to-gray-900"></div>
    <% end %>
    <%# Gradiente: faixa escura no topo (nav), claro no meio, escuro na base (texto) %>
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(0,0,0,0.62) 0%, rgba(0,0,0,0.28) 20%, rgba(0,0,0,0.1) 40%, rgba(0,0,0,0.55) 65%, rgba(0,0,0,0.92) 100%);"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 flex flex-col justify-end h-full" style="padding-top: 5rem; padding-bottom: 4rem;">
      <div class="max-w-3xl">
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-4 leading-tight drop-shadow-lg">
          <%= link_to @artigo_destaque.titulo, noticia_path(@artigo_destaque.slug), class: "hover:underline" %>
        </h1>

        <% if @artigo_destaque.resumo.present? %>
          <p class="text-gray-200 text-base md:text-lg mb-6 leading-relaxed max-w-2xl line-clamp-3"><%= @artigo_destaque.resumo %></p>
        <% end %>

        <div class="flex items-center gap-4 text-sm text-gray-300 mb-6">
          <span class="font-medium"><%= @artigo_destaque.author.nome %></span>
          <span>·</span>
          <span><%= l @artigo_destaque.publicado_em, format: :short if @artigo_destaque.publicado_em %></span>
        </div>

        <%= link_to "LER ARTIGO COMPLETO →", noticia_path(@artigo_destaque.slug),
            class: "inline-flex items-center bg-white text-gray-900 px-6 py-3 rounded font-bold text-sm hover:bg-gray-100 transition-colors shadow-lg" %>
      </div>
    </div>
  </section>
<% end %>

<%# ── Ticker ──────────────────────────────────────────────────── %>
<% if @ultimas.any? %>
  <div class="bg-blue-800 text-white text-xs overflow-hidden">
    <div class="max-w-7xl mx-auto flex items-stretch">
      <div class="bg-red-600 font-black text-[11px] uppercase tracking-widest px-4 py-2 flex items-center shrink-0 gap-1.5">
        <svg class="w-3 h-3 animate-pulse" fill="currentColor" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/></svg>
        ÚLTIMAS
      </div>
      <div class="overflow-hidden flex-1 py-2">
        <div class="ticker-track">
          <% (@ultimas.to_a * 2).each do |a| %>
            <span class="px-5 whitespace-nowrap">
              <%= link_to a.titulo, noticia_path(a.slug), class: "hover:underline opacity-90 hover:opacity-100" %>
              <span class="mx-4 opacity-30">◆</span>
            </span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%# ── Seção de notícias: secundárias + mais lidos ─────────────── %>
<div class="max-w-7xl mx-auto px-4 pt-6 pb-2">
  <div class="grid grid-cols-12 gap-5">

    <%# Secundárias ── 9 colunas %>
    <div class="col-span-12 lg:col-span-9">
      <div class="border-t-2 border-gray-900 pt-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-0">
        <% @secundarias.each_with_index do |artigo, i| %>
          <article class="flex gap-3 group py-4 <%= i.even? && i < @secundarias.length - 1 ? 'border-b border-gray-100 lg:border-b-0 lg:border-r lg:pr-5' : '' %> <%= i.odd? && i < @secundarias.length - 1 ? 'border-b border-gray-100 lg:pl-5' : '' %> <%= i.odd? ? 'lg:pl-5' : '' %>">
            <a href="<%= noticia_path(artigo.slug) %>" class="shrink-0 w-24 h-[68px] rounded overflow-hidden bg-gray-100 relative block">
              <% if artigo.imagem_capa_file.attached? %>
                <%= image_tag url_for(artigo.imagem_capa_file),
                    class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300",
                    alt: artigo.titulo %>
              <% end %>
            </a>
            <div class="flex-1 min-w-0">
              <% if artigo.category %>
                <span class="text-[10px] font-bold text-blue-600 uppercase tracking-wider block mb-0.5"><%= artigo.category.nome %></span>
              <% end %>
              <h3 class="text-sm font-bold text-gray-900 leading-snug line-clamp-3 group-hover:text-blue-700 transition-colors">
                <%= link_to artigo.titulo, noticia_path(artigo.slug) %>
              </h3>
              <span class="text-[11px] text-gray-400 mt-1 block"><%= l artigo.publicado_em, format: :short if artigo.publicado_em %></span>
            </div>
          </article>
        <% end %>
      </div>
    </div>

    <%# Sidebar Mais Lidos ── 3 colunas %>
    <div class="col-span-12 lg:col-span-3">
      <div class="border-t-2 border-gray-900 pt-3">
        <h3 class="text-[11px] font-black uppercase tracking-widest text-gray-900 mb-4">Mais Lidos</h3>
        <ol class="space-y-4">
          <% @mais_lidos.each_with_index do |artigo, i| %>
            <li class="flex gap-3 group">
              <span class="text-4xl font-black leading-none text-gray-100 w-8 shrink-0 select-none"><%= i + 1 %></span>
              <div class="min-w-0">
                <% if artigo.category %>
                  <span class="text-[10px] font-bold text-blue-600 uppercase tracking-wider block mb-0.5"><%= artigo.category.nome %></span>
                <% end %>
                <h4 class="text-sm font-semibold text-gray-800 leading-snug line-clamp-3 group-hover:text-blue-700 transition-colors">
                  <%= link_to artigo.titulo, noticia_path(artigo.slug) %>
                </h4>
              </div>
            </li>
          <% end %>
        </ol>
      </div>
    </div>

  </div>
</div>

<%# ── Anúncio: banner entre o bloco de secundárias e as categorias ── %>
<%= render "shared/anuncio", formato: :horizontal %>

<%# ── Seções por categoria ────────────────────────────────────── %>
<% @por_categoria.each_with_index do |(categoria, artigos), idx| %>
  <div class="bg-white border-t-4 border-t-gray-900 py-8 mt-2">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <span class="w-1.5 h-7 rounded-sm bg-blue-600 shrink-0"></span>
          <h2 class="text-lg font-black uppercase tracking-widest text-gray-900"><%= categoria.nome %></h2>
        </div>
        <%= link_to "Ver todos →", categoria_path(categoria.slug), class: "text-xs font-semibold text-blue-600 hover:text-blue-800 border border-blue-200 px-3 py-1 rounded hover:bg-blue-50 transition-colors" %>
      </div>

      <div class="grid grid-cols-12 gap-5">
        <%# Primeiro artigo — grande %>
        <% if artigos.first %>
          <% a = artigos.first %>
          <article class="col-span-12 md:col-span-5 group">
            <a href="<%= noticia_path(a.slug) %>" class="block aspect-video overflow-hidden rounded mb-2 bg-gray-100 relative">
              <% if a.imagem_capa_file.attached? %>
                <%= image_tag url_for(a.imagem_capa_file),
                    class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300",
                    alt: a.titulo %>
              <% end %>
              <% if a.premium? %>
                <span class="absolute top-2 left-2 bg-amber-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow">★ Premium</span>
              <% end %>
            </a>
            <h3 class="font-bold text-gray-900 text-base leading-snug group-hover:text-blue-700 transition-colors line-clamp-3 mb-1">
              <%= link_to a.titulo, noticia_path(a.slug) %>
            </h3>
            <% if a.resumo.present? %>
              <p class="text-sm text-gray-500 line-clamp-2 mb-1"><%= a.resumo %></p>
            <% end %>
            <span class="text-xs text-gray-400"><%= a.author.nome %> · <%= l a.publicado_em, format: :short if a.publicado_em %></span>
          </article>
        <% end %>

        <%# Demais artigos — compactos em 3 colunas %>
        <div class="col-span-12 md:col-span-7 grid grid-cols-3 gap-4">
          <% artigos.drop(1).first(3).each do |a| %>
            <article class="group">
              <a href="<%= noticia_path(a.slug) %>" class="block aspect-video overflow-hidden rounded mb-2 bg-gray-100 relative">
                <% if a.imagem_capa_file.attached? %>
                  <%= image_tag url_for(a.imagem_capa_file),
                      class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300",
                      alt: a.titulo %>
                <% end %>
                <% if a.premium? %>
                  <span class="absolute top-1.5 left-1.5 bg-amber-500 text-white text-[9px] font-bold px-1.5 py-0.5 rounded-full">★</span>
                <% end %>
              </a>
              <h4 class="text-sm font-bold text-gray-900 leading-snug group-hover:text-blue-700 transition-colors line-clamp-3 mb-1">
                <%= link_to a.titulo, noticia_path(a.slug) %>
              </h4>
              <span class="text-[11px] text-gray-400"><%= l a.publicado_em, format: :short if a.publicado_em %></span>
            </article>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <%# Anúncio após cada 2ª seção de categoria %>
  <% if idx.odd? %>
    <div class="max-w-7xl mx-auto px-4">
      <%= render "shared/anuncio", formato: :horizontal %>
    </div>
  <% end %>
<% end %>

<%# ── Mais Notícias ───────────────────────────────────────────── %>
<div class="border-t-2 border-gray-900 py-6">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center gap-3 mb-5">
      <span class="w-1 h-5 rounded bg-blue-600 shrink-0"></span>
      <h2 class="text-sm font-black uppercase tracking-widest text-gray-900">Mais Notícias</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
      <% @ultimas.each do |artigo| %>
        <article class="bg-white rounded-lg overflow-hidden shadow-sm hover:shadow-md transition-shadow flex flex-col group">
          <a href="<%= noticia_path(artigo.slug) %>" class="block aspect-video overflow-hidden relative bg-gray-100">
            <% if artigo.imagem_capa_file.attached? %>
              <%= image_tag url_for(artigo.imagem_capa_file),
                  class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-300",
                  alt: artigo.titulo %>
            <% end %>
            <% if artigo.premium? %>
              <span class="absolute top-2 left-2 bg-amber-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow">★ Premium</span>
            <% else %>
              <span class="absolute top-2 left-2 bg-green-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow">✓ Grátis</span>
            <% end %>
          </a>
          <div class="p-3 flex flex-col flex-1">
            <% if artigo.category %>
              <span class="text-[11px] font-bold uppercase tracking-wider text-blue-600 mb-1"><%= artigo.category.nome %></span>
            <% end %>
            <h3 class="font-bold text-gray-900 text-sm leading-snug line-clamp-3 flex-1 group-hover:text-blue-700 transition-colors">
              <%= link_to artigo.titulo, noticia_path(artigo.slug) %>
            </h3>
            <div class="flex items-center justify-between text-[11px] text-gray-400 mt-2 pt-2 border-t border-gray-100">
              <span><%= artigo.author.nome %></span>
              <span><%= l artigo.publicado_em, format: :short if artigo.publicado_em %></span>
            </div>
          </div>
        </article>
      <% end %>
    </div>

    <% if @ultimas.empty? && @artigo_destaque.nil? %>
      <div class="py-20 text-center text-gray-400">
        <p>Nenhuma notícia publicada ainda.</p>
      </div>
    <% end %>

    <% if @pagy.pages > 1 %>
      <div class="mt-10 flex justify-center">
        <%== pagy_nav(@pagy) %>
      </div>
    <% end %>
  </div>
</div>
