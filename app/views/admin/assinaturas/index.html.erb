<% content_for :page_title, "Assinaturas" %>
<% content_for :page_subtitle, "Gerencie e crie assinaturas manualmente." %>

<%# Filtros %>
<div class="card mb-5">
  <div class="card-body">
    <%= form_with url: admin_assinaturas_path, method: :get, class: "flex flex-wrap gap-3 items-end" do |f| %>
      <div class="flex-1 min-w-40">
        <%= f.text_field :q, value: params[:q], placeholder: "Buscar por nome ou e-mail…",
            class: "input text-sm w-full" %>
      </div>
      <div>
        <%= f.select :status,
            [["Todos os status", ""], ["Ativa", "ativa"], ["Cancelada", "cancelada"], ["Expirada", "expirada"]],
            { selected: params[:status] }, class: "input text-sm" %>
      </div>
      <div>
        <%= f.select :plan,
            [["Todos os planos", ""]] + @planos.map { |p| [p.nome, p.id] },
            { selected: params[:plan] }, class: "input text-sm" %>
      </div>
      <%= f.submit "Filtrar", class: "btn-primary text-sm" %>
      <% if params[:q].present? || params[:status].present? || params[:plan].present? %>
        <%= link_to "Limpar", admin_assinaturas_path, class: "text-sm text-gray-500 hover:underline" %>
      <% end %>
    <% end %>
  </div>
</div>

<%# Tabela %>
<div class="card">
  <div class="card-header flex items-center justify-between">
    <h3 class="font-semibold text-gray-800">
      <%= @pagy.count %> assinatura<%= @pagy.count == 1 ? "" : "s" %>
    </h3>
    <%= link_to new_admin_assinatura_path,
        class: "btn-primary text-sm flex items-center gap-1.5" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Nova assinatura
    <% end %>
  </div>

  <table class="table-admin">
    <thead>
      <tr>
        <th>Usuário</th>
        <th>Plano</th>
        <th>Status</th>
        <th>Próx. cobrança</th>
        <th>Stripe</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @assinaturas.each do |sub| %>
        <% cores = sub.plan&.cor_classes || {} %>
        <tr>
          <td>
            <div>
              <p class="text-sm font-medium text-gray-900"><%= sub.user.nome %></p>
              <p class="text-xs text-gray-400"><%= sub.user.email %></p>
            </div>
          </td>
          <td>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold
                         <%= cores[:badge] ? "#{cores[:badge]} text-white" : 'bg-gray-100 text-gray-700' %>">
              <%= sub.plan&.nome || sub.nome_plano %>
            </span>
          </td>
          <td>
            <% status_classes = { "ativa" => "bg-green-100 text-green-700",
                                  "cancelada" => "bg-red-100 text-red-700",
                                  "expirada" => "bg-gray-100 text-gray-500" } %>
            <span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-semibold
                         <%= status_classes[sub.status] || 'bg-gray-100 text-gray-500' %>">
              <%= sub.status.humanize %>
            </span>
          </td>
          <td class="text-sm text-gray-500">
            <%= sub.prox_cobranca ? l(sub.prox_cobranca, format: :short) : "—" %>
          </td>
          <td>
            <% if sub.stripe_subscription_id.present? %>
              <span class="text-xs font-mono text-gray-400 truncate max-w-28 block" title="<%= sub.stripe_subscription_id %>">
                <%= sub.stripe_subscription_id.truncate(18) %>
              </span>
            <% else %>
              <span class="text-xs text-gray-300">—</span>
            <% end %>
          </td>
          <td>
            <div class="flex items-center gap-2">
              <%= link_to edit_admin_assinatura_path(sub),
                  class: "p-1.5 text-gray-400 hover:text-blue-600 rounded transition-colors",
                  title: "Editar" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
              <% end %>
              <%= button_to admin_assinatura_path(sub), method: :delete,
                  class: "p-1.5 text-gray-400 hover:text-red-600 rounded transition-colors",
                  title: "Remover",
                  data: { turbo_confirm: "Remover esta assinatura?" } do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @assinaturas.empty? %>
        <tr>
          <td colspan="6" class="text-center text-gray-400 py-10">Nenhuma assinatura encontrada.</td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% if @pagy.pages > 1 %>
    <div class="flex justify-center py-4 border-t border-gray-100">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>
