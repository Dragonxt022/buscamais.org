<% content_for :page_title, "Análise" %>
<% content_for :page_subtitle, "Métricas de leitura, usuários e engajamento do portal." %>

<%# KPIs rápidos %>
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Novos usuários (30d)</p>
    <p class="text-2xl font-black text-blue-600"><%= @novos_usuarios_30d %></p>
  </div>
  <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Total de leituras</p>
    <p class="text-2xl font-black text-gray-900"><%= number_with_delimiter(Article.sum(:visualizacoes)) %></p>
  </div>
  <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Artigos publicados</p>
    <p class="text-2xl font-black text-gray-900"><%= Article.publicados.count %></p>
  </div>
  <div class="bg-white rounded-xl p-4 border border-gray-100 shadow-sm">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Comentários aprovados</p>
    <p class="text-2xl font-black text-gray-900"><%= Comment.aprovados.count %></p>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <%# Artigos mais lidos %>
  <div class="card">
    <div class="card-header">
      <h3 class="font-semibold text-gray-800">Artigos Mais Lidos</h3>
    </div>
    <table class="table-admin">
      <thead>
        <tr><th>#</th><th>Título</th><th>Visualizações</th></tr>
      </thead>
      <tbody>
        <% @artigos_mais_lidos.each_with_index do |artigo, i| %>
          <tr>
            <td class="text-gray-400 font-mono text-xs w-8"><%= i + 1 %></td>
            <td>
              <%= link_to artigo.titulo.truncate(50), admin_artigo_path(artigo),
                  class: "text-blue-600 hover:underline text-sm" %>
            </td>
            <td>
              <div class="flex items-center gap-2">
                <div class="h-1.5 rounded-full bg-blue-100 flex-1 max-w-20">
                  <% max = @artigos_mais_lidos.first.visualizacoes.to_i %>
                  <div class="h-1.5 rounded-full bg-blue-500"
                       style="width:<%= max > 0 ? (artigo.visualizacoes.to_i * 100 / max) : 0 %>%"></div>
                </div>
                <span class="text-sm font-semibold text-gray-700 tabular-nums"><%= number_with_delimiter(artigo.visualizacoes.to_i) %></span>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @artigos_mais_lidos.empty? %>
          <tr><td colspan="3" class="text-center text-gray-400 py-8">Nenhum dado ainda.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Leituras por mês %>
  <div class="card">
    <div class="card-header">
      <h3 class="font-semibold text-gray-800">Leituras por Mês</h3>
    </div>
    <div class="p-5">
      <% if @leituras_por_mes.any? %>
        <%= column_chart @leituras_por_mes, colors: ["#2563eb"], height: "220px" %>
      <% else %>
        <p class="text-center text-gray-400 py-8 text-sm">Nenhuma leitura registrada ainda.</p>
      <% end %>
    </div>
  </div>

  <%# Usuários por plano %>
  <div class="card">
    <div class="card-header">
      <h3 class="font-semibold text-gray-800">Usuários por Plano</h3>
    </div>
    <div class="p-5">
      <% if @usuarios_por_plano.sum { |h| h[:count] } > 0 %>
        <%= pie_chart @usuarios_por_plano.map { |h| [h[:plano].nome, h[:count]] }, height: "220px" %>
      <% else %>
        <p class="text-gray-400 text-sm text-center py-4">Nenhum dado ainda.</p>
      <% end %>
    </div>
  </div>

  <%# Top autores %>
  <div class="card">
    <div class="card-header">
      <h3 class="font-semibold text-gray-800">Top Autores</h3>
    </div>
    <table class="table-admin">
      <thead>
        <tr><th>Autor</th><th>Artigos</th><th>Leituras</th></tr>
      </thead>
      <tbody>
        <% @top_autores.each do |autor| %>
          <tr>
            <td>
              <div class="flex items-center gap-2">
                <%= render "shared/user_avatar", user: autor, size: "sm" %>
                <%= link_to autor.nome, autor_path(autor.slug), class: "text-sm text-gray-900 hover:text-blue-600" %>
              </div>
            </td>
            <td class="font-semibold tabular-nums"><%= autor.total_artigos %></td>
            <td class="tabular-nums text-gray-500"><%= number_with_delimiter(autor.total_views.to_i) %></td>
          </tr>
        <% end %>
        <% if @top_autores.empty? %>
          <tr><td colspan="3" class="text-center text-gray-400 py-8">Nenhum dado ainda.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Comentários por mês %>
  <div class="card lg:col-span-2">
    <div class="card-header">
      <h3 class="font-semibold text-gray-800">Comentários por Mês</h3>
    </div>
    <div class="p-5">
      <% if @comentarios_por_mes.any? %>
        <%= line_chart @comentarios_por_mes, colors: ["#2563eb"], height: "220px" %>
      <% else %>
        <p class="text-center text-gray-400 py-8 text-sm">Nenhum comentário ainda.</p>
      <% end %>
    </div>
  </div>

  <%# Leituras diárias (30d) %>
  <div class="card">
    <div class="card-header">
      <h3 class="font-semibold text-gray-800">Leituras Diárias (30d)</h3>
    </div>
    <div class="p-5">
      <% if @leituras_diarias.any? %>
        <%= line_chart @leituras_diarias, colors: ["#16a34a"], height: "220px" %>
      <% else %>
        <p class="text-center text-gray-400 py-8 text-sm">Nenhuma leitura registrada nos últimos 30 dias.</p>
      <% end %>
    </div>
  </div>

  <%# Top categorias por visualizações %>
  <div class="card">
    <div class="card-header">
      <h3 class="font-semibold text-gray-800">Top Categorias por Visualizações</h3>
    </div>
    <div class="p-5">
      <% if @top_categorias.any? %>
        <%= pie_chart @top_categorias, height: "220px" %>
      <% else %>
        <p class="text-center text-gray-400 py-8 text-sm">Nenhum dado ainda.</p>
      <% end %>
    </div>
  </div>

  <%# Receita mensal (MRR) %>
  <div class="card lg:col-span-2">
    <div class="card-header">
      <h3 class="font-semibold text-gray-800">Receita Mensal (MRR)</h3>
    </div>
    <div class="p-5">
      <% if @receita_por_mes.any? %>
        <%= line_chart @receita_por_mes, colors: ["#d97706"], height: "220px", prefix: "R$ " %>
      <% else %>
        <p class="text-center text-gray-400 py-8 text-sm">Nenhuma receita registrada ainda.</p>
      <% end %>
    </div>
  </div>
</div>
