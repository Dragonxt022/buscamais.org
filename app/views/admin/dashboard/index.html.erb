<% content_for :page_title, "Dashboard" %>
<% content_for :page_subtitle, "Visão geral do portal" %>

<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
  <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Total de Artigos</p>
    <p class="text-3xl font-bold text-gray-900"><%= number_with_delimiter(@total_artigos) %></p>
  </div>
  <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Total de Leituras</p>
    <p class="text-3xl font-bold text-gray-900"><%= number_with_delimiter(@total_leituras) %></p>
  </div>
  <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Usuários</p>
    <p class="text-3xl font-bold text-gray-900"><%= number_with_delimiter(@total_usuarios) %></p>
  </div>
  <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-1">Aguardando Revisão</p>
    <p class="text-3xl font-bold <%= @pendentes_revisao > 0 ? 'text-red-600' : 'text-gray-900' %>">
      <%= @pendentes_revisao %>
    </p>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm border border-gray-100">
  <div class="p-5 border-b border-gray-100 flex items-center justify-between">
    <h2 class="font-semibold text-gray-900">Artigos Recentes</h2>
    <%= link_to "Ver todos →", admin_artigos_path, class: "text-sm text-blue-600 hover:underline" %>
  </div>
  <table class="w-full text-sm">
    <thead class="bg-gray-50">
      <tr>
        <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase">Título</th>
        <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase">Autor</th>
        <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase">Categoria</th>
        <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase">Status</th>
        <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase">Data</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @artigos_recentes.each do |artigo| %>
        <tr class="hover:bg-gray-50">
          <td class="px-5 py-4">
            <p class="font-medium text-gray-900 line-clamp-1"><%= artigo.titulo %></p>
            <p class="text-xs text-gray-400">#ART-<%= artigo.id %></p>
          </td>
          <td class="px-5 py-4 text-gray-600"><%= artigo.author.nome %></td>
          <td class="px-5 py-4">
            <% if artigo.category %>
              <span class="text-xs border border-gray-300 px-2 py-0.5 rounded"><%= artigo.category.nome %></span>
            <% end %>
          </td>
          <td class="px-5 py-4">
            <%= render "shared/status_badge", status: artigo.status %>
          </td>
          <td class="px-5 py-4 text-gray-500"><%= l artigo.created_at, format: :short %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
