<% content_for :page_title, "Planos de Assinatura" %>
<% content_for :page_subtitle, "Configure os planos e benefícios disponíveis para os usuários." %>

<div class="space-y-6">
  <%# Header actions %>
  <div class="flex items-center justify-between">
    <p class="text-sm text-gray-500">
      <%= pluralize(@planos.count, "plano cadastrado", "planos cadastrados") %>
    </p>
    <%= link_to new_admin_plano_path,
        class: "btn-primary flex items-center gap-2" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Novo Plano
    <% end %>
  </div>

  <% if @planos.empty? %>
    <div class="card text-center py-16 text-gray-400">
      <svg class="w-14 h-14 mx-auto mb-4 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
      </svg>
      <p class="font-medium text-gray-500">Nenhum plano cadastrado</p>
      <p class="text-sm mt-1">Crie os planos de assinatura disponíveis para os usuários.</p>
      <%= link_to "Criar primeiro plano", new_admin_plano_path, class: "mt-4 inline-block btn-primary" %>
    </div>
  <% else %>
    <%# Plan cards grid %>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
      <% @planos.each do |plano| %>
        <% cores = plano.cor_classes %>
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm flex flex-col overflow-hidden
                    <%= plano.destaque? ? "ring-2 #{cores[:ring] || 'ring-blue-200'}" : '' %>
                    <%= plano.ativo? ? '' : 'opacity-60' %>">

          <%# Destaque badge %>
          <% if plano.destaque? %>
            <div class="<%= cores[:badge] || 'bg-blue-600' %> text-white text-xs font-bold text-center py-1.5 tracking-wide uppercase">
              ★ Mais Popular
            </div>
          <% end %>

          <div class="p-6 flex-1 flex flex-col">
            <%# Header %>
            <div class="flex items-start justify-between mb-4">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <h3 class="text-lg font-bold text-gray-900"><%= plano.nome %></h3>
                  <% unless plano.ativo? %>
                    <span class="text-xs font-semibold text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">Inativo</span>
                  <% end %>
                </div>
                <p class="text-sm text-gray-500"><%= plano.descricao %></p>
              </div>
              <div class="text-right shrink-0 ml-3">
                <p class="text-2xl font-black <%= cores[:text] || 'text-blue-700' %>">
                  <%= plano.gratuito? ? "Grátis" : "R$ #{format('%.2f', plano.preco).gsub('.', ',')}" %>
                </p>
                <% unless plano.gratuito? %>
                  <p class="text-xs text-gray-400">/mês</p>
                <% end %>
              </div>
            </div>

            <%# Benefícios %>
            <% if plano.beneficios.present? %>
              <ul class="space-y-1.5 flex-1 mb-5">
                <% plano.beneficios.each do |b| %>
                  <li class="flex items-start gap-2 text-sm text-gray-700">
                    <svg class="w-4 h-4 <%= cores[:text] || 'text-blue-600' %> mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                    <%= b %>
                  </li>
                <% end %>
              </ul>
            <% else %>
              <p class="text-sm text-gray-400 italic flex-1 mb-5">Nenhum benefício cadastrado.</p>
            <% end %>

            <%# Actions %>
            <div class="flex items-center gap-2 pt-4 border-t border-gray-100">
              <%= link_to edit_admin_plano_path(plano),
                  class: "flex-1 text-center text-sm font-medium text-blue-600 hover:text-blue-700 bg-blue-50 hover:bg-blue-100 py-2 rounded-lg transition-colors" do %>
                Editar plano
              <% end %>
              <%= button_to admin_plano_path(plano), method: :delete,
                  data: { turbo_confirm: "Remover o plano \"#{plano.nome}\"? Assinantes existentes não serão afetados." },
                  class: "p-2 text-gray-300 hover:text-red-500 rounded-lg hover:bg-red-50 transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
