<%= form_with model: categoria,
              url: categoria.new_record? ? admin_categorias_path : admin_categoria_path(categoria),
              class: "space-y-5 max-w-lg" do |f| %>
  <% if categoria.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% categoria.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :nome, "Nome", class: "label" %>
    <%= f.text_field :nome, class: "input", placeholder: "Nome da categoria..." %>
  </div>

  <div>
    <%= f.label :descricao, "Descrição", class: "label" %>
    <%= f.text_area :descricao, rows: 3, class: "input resize-none", placeholder: "Descrição curta..." %>
  </div>

  <div>
    <%= f.label :cor, "Cor (hex)", class: "label" %>
    <div class="flex items-center gap-3">
      <%= f.color_field :cor, class: "h-10 w-16 rounded cursor-pointer border border-gray-300 p-1" %>
      <%= f.text_field :cor, class: "input max-w-xs", placeholder: "#2563eb" %>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :ativo, class: "w-4 h-4 text-blue-600 border-gray-300 rounded" %>
    <%= f.label :ativo, "Categoria ativa (visível no site)", class: "text-sm text-gray-700" %>
  </div>

  <div class="flex gap-3 pt-2">
    <%= f.submit categoria.new_record? ? "Criar Categoria" : "Salvar Alterações",
        class: "btn-primary cursor-pointer" %>
    <%= link_to "Cancelar", admin_categorias_path, class: "btn-secondary" %>
  </div>
<% end %>
