<div class="card max-w-3xl mx-auto">
  <div class="card-header">
    <h2 class="text-lg font-bold text-gray-900">Configurações do Site</h2>
    <p class="text-sm text-gray-500 mt-0.5">Personalize as informações e aparência do portal.</p>
  </div>

  <%= form_with url: admin_configuracoes_path, method: :patch,
      multipart: true, class: "divide-y divide-gray-100" do |f| %>

    <%# Site info %>
    <div class="p-6 space-y-5">
      <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Informações do Site</h3>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">
          Título do Site <span class="text-red-500">*</span>
        </label>
        <input type="text" name="site_setting[site_titulo]"
               value="<%= @configuracoes['site_titulo'] %>"
               placeholder="Ex: Busca Mais"
               class="input text-sm">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Descrição / SEO</label>
        <textarea name="site_setting[site_descricao]" rows="3"
                  placeholder="Descrição curta para SEO e redes sociais..."
                  class="input text-sm resize-none"><%= @configuracoes['site_descricao'] %></textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">URL do Site</label>
        <input type="url" name="site_setting[site_url]"
               value="<%= @configuracoes['site_url'] %>"
               placeholder="https://buscamais.org"
               class="input text-sm">
      </div>
    </div>

    <%# Branding — upload real de arquivos %>
    <div class="p-6 space-y-6">
      <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Identidade Visual</h3>

      <%# Logo %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Logotipo do Site</label>
        <div class="flex items-center gap-4">
          <%# Preview %>
          <div class="w-24 h-14 rounded-lg border border-gray-200 bg-gray-50 flex items-center justify-center overflow-hidden shrink-0">
            <% if @branding.logo.attached? %>
              <img src="<%= @branding.logo_url %>" alt="Logo atual" class="max-w-full max-h-full object-contain p-1">
            <% else %>
              <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            <% end %>
          </div>

          <%# Upload %>
          <div class="flex-1">
            <label class="relative cursor-pointer inline-flex items-center gap-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium px-4 py-2 rounded-lg transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
              </svg>
              <%= @branding.logo.attached? ? "Trocar Logo" : "Enviar Logo" %>
              <input type="file" name="branding_logo" accept="image/*" class="sr-only"
                     onchange="this.closest('label').querySelector('span.fn') && (this.closest('label').querySelector('span.fn').textContent = this.files[0]?.name || '')">
            </label>
            <p class="text-xs text-gray-400 mt-1.5">PNG, SVG ou WebP — recomendado 300×80px</p>
            <% if @branding.logo.attached? %>
              <label class="inline-flex items-center gap-1 mt-1.5 text-xs text-red-500 hover:text-red-700 cursor-pointer">
                <input type="checkbox" name="remover_logo" value="1" class="w-3.5 h-3.5">
                Remover logo atual
              </label>
            <% end %>
          </div>
        </div>
      </div>

      <%# Favicon %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Favicon (aba do navegador)</label>
        <div class="flex items-center gap-4">
          <%# Preview %>
          <div class="w-12 h-12 rounded-lg border border-gray-200 bg-gray-50 flex items-center justify-center overflow-hidden shrink-0">
            <% if @branding.favicon.attached? %>
              <img src="<%= @branding.favicon_url %>" alt="Favicon atual" class="max-w-full max-h-full object-contain">
            <% else %>
              <svg class="w-6 h-6 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            <% end %>
          </div>

          <%# Upload %>
          <div class="flex-1">
            <label class="relative cursor-pointer inline-flex items-center gap-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium px-4 py-2 rounded-lg transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
              </svg>
              <%= @branding.favicon.attached? ? "Trocar Favicon" : "Enviar Favicon" %>
              <input type="file" name="branding_favicon" accept="image/png,image/x-icon,image/svg+xml" class="sr-only">
            </label>
            <p class="text-xs text-gray-400 mt-1.5">PNG ou ICO — 32×32px ou 64×64px</p>
            <% if @branding.favicon.attached? %>
              <label class="inline-flex items-center gap-1 mt-1.5 text-xs text-red-500 hover:text-red-700 cursor-pointer">
                <input type="checkbox" name="remover_favicon" value="1" class="w-3.5 h-3.5">
                Remover favicon atual
              </label>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%# Email %>
    <div class="p-6 space-y-5">
      <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Configurações de E-mail</h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">
            E-mail Remetente <span class="text-red-500">*</span>
          </label>
          <input type="email" name="site_setting[email_remetente]"
                 value="<%= @configuracoes['email_remetente'] %>"
                 placeholder="noreply@seusite.com"
                 class="input text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Nome do Remetente</label>
          <input type="text" name="site_setting[email_nome]"
                 value="<%= @configuracoes['email_nome'] %>"
                 placeholder="Busca Mais"
                 class="input text-sm">
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Rodapé do E-mail</label>
        <textarea name="site_setting[email_rodape]" rows="2"
                  placeholder="Texto exibido no rodapé de todos os e-mails..."
                  class="input text-sm resize-none"><%= @configuracoes['email_rodape'] %></textarea>
      </div>
    </div>

    <%# Google OAuth %>
    <div class="p-6 space-y-5">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Login com Google</h3>
          <% if @configuracoes["google_client_id"].present? && @configuracoes["google_client_secret"].present? %>
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-green-700 bg-green-50 px-2 py-0.5 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Ativo
            </span>
          <% else %>
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">
              Não configurado
            </span>
          <% end %>
        </div>
        <p class="text-xs text-gray-500 mb-4">
          Permite que usuários criem conta ou entrem usando a conta Google.
          Obtenha as credenciais em
          <strong>console.cloud.google.com</strong> → APIs &amp; Serviços → Credenciais → Criar ID do cliente OAuth.
          Na tela de configuração do Google, adicione a URI de redirecionamento autorizada:
          <code class="bg-gray-100 text-gray-700 px-1.5 py-0.5 rounded text-xs font-mono select-all"><%= "#{SiteSetting['site_url'].presence || request.base_url}/conta/auth/google_oauth2/callback" %></code>
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Client ID</label>
          <input type="text" name="site_setting[google_client_id]"
                 value="<%= @configuracoes['google_client_id'] %>"
                 placeholder="123456789-abc...apps.googleusercontent.com"
                 autocomplete="off"
                 class="input text-sm font-mono">
          <p class="text-xs text-gray-400 mt-1">Identificador público do aplicativo Google.</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Client Secret</label>
          <input type="password" name="site_setting[google_client_secret]"
                 value="<%= @configuracoes['google_client_secret'] %>"
                 placeholder="GOCSPX-..."
                 autocomplete="new-password"
                 class="input text-sm font-mono">
          <p class="text-xs text-gray-400 mt-1">Chave secreta — nunca compartilhe publicamente.</p>
        </div>
      </div>

      <% if @configuracoes["google_client_id"].present? %>
        <p class="text-xs text-amber-600 bg-amber-50 border border-amber-100 rounded-lg px-3 py-2">
          Após salvar novas credenciais, o login com Google começa a funcionar imediatamente na próxima tentativa — sem reiniciar o servidor.
        </p>
      <% end %>
    </div>

    <%# Stripe %>
    <div class="p-6 space-y-5">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <svg class="w-5 h-5 text-indigo-600" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13.479 9.883c-1.626-.604-2.512-1.067-2.512-1.803 0-.604.559-1.24 1.716-1.24a5.63 5.63 0 012.34.572l.415-2.516A6.78 6.78 0 0013.04 4.4c-2.977 0-5.043 1.582-5.043 3.86 0 2.037 1.44 3.096 3.796 3.838 1.538.528 2.017 1.052 2.017 1.79 0 .72-.624 1.24-1.765 1.24a6.39 6.39 0 01-2.857-.72l-.44 2.543a7.38 7.38 0 003.21.72c3.13 0 5.27-1.516 5.27-3.94-.006-2.215-1.494-3.226-3.75-3.848zM2 4.4l-.96 5.568.937-4.696A1.2 1.2 0 013.168 4.4H2zm3.528 0l-1.8 10.8h2.04l.408-2.4h2.04l-.408 2.4h2.04l1.8-10.8H9.6l-.48 2.8H7.08l.48-2.8H5.528zm13.352 7.56l-.48-2.4H16.8l.504-2.88-.48-1.32-.864 4.2h-1.68L12.84 4.4h2.04l1.8 10.8h-2.04l-.36-2.16"/>
          </svg>
          <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Pagamentos — Stripe</h3>
          <% if @configuracoes["stripe_secret_key"].present? %>
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-green-700 bg-green-50 px-2 py-0.5 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Configurado
            </span>
          <% else %>
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">Não configurado</span>
          <% end %>
        </div>
        <p class="text-xs text-gray-500 mb-4">
          Configure as chaves Stripe para habilitar cobranças de assinatura.
          Obtenha em <strong>dashboard.stripe.com</strong> → Developers → API Keys.
          O webhook deve apontar para:
          <code class="bg-gray-100 text-gray-700 px-1.5 py-0.5 rounded text-xs font-mono select-all"><%= "#{SiteSetting['site_url'].presence || request.base_url}/stripe/webhook" %></code>
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Publishable Key</label>
          <input type="text" name="site_setting[stripe_publishable_key]"
                 value="<%= @configuracoes['stripe_publishable_key'] %>"
                 placeholder="pk_live_..."
                 autocomplete="off"
                 class="input text-sm font-mono">
          <p class="text-xs text-gray-400 mt-1">Chave pública — usada no frontend.</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Secret Key</label>
          <input type="password" name="site_setting[stripe_secret_key]"
                 value="<%= @configuracoes['stripe_secret_key'] %>"
                 placeholder="sk_live_..."
                 autocomplete="new-password"
                 class="input text-sm font-mono">
          <p class="text-xs text-gray-400 mt-1">Chave secreta — nunca exponha publicamente.</p>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Webhook Secret</label>
        <input type="password" name="site_setting[stripe_webhook_secret]"
               value="<%= @configuracoes['stripe_webhook_secret'] %>"
               placeholder="whsec_..."
               autocomplete="new-password"
               class="input text-sm font-mono max-w-sm">
        <p class="text-xs text-gray-400 mt-1">Encontrado em Dashboard → Webhooks → seu endpoint.</p>
      </div>
    </div>

    <%# Actions %>
    <div class="px-6 py-4 bg-gray-50 flex items-center justify-end gap-3">
      <button type="submit" class="btn-primary">
        Salvar Configurações
      </button>
    </div>

  <% end %>
</div>
