<div class="max-w-6xl mx-auto space-y-6">
  <div>
    <h2 class="text-lg font-bold text-gray-900">Configurações do Site</h2>
    <p class="text-sm text-gray-500 mt-0.5">Personalize as informações e aparência do portal.</p>
  </div>

  <%= form_with url: admin_configuracoes_path, method: :patch, multipart: true do |f| %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <%# Site info %>
    <div class="card">
      <div class="card-header">
        <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Informações do Site</h3>
      </div>
      <div class="card-body space-y-5">

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">
          Título do Site <span class="text-red-500">*</span>
        </label>
        <input type="text" name="site_setting[site_titulo]"
               value="<%= @configuracoes['site_titulo'] %>"
               placeholder="Ex: Busca Mais"
               class="input text-sm">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Descrição / SEO</label>
        <textarea name="site_setting[site_descricao]" rows="3"
                  placeholder="Descrição curta para SEO e redes sociais..."
                  class="input text-sm resize-none"><%= @configuracoes['site_descricao'] %></textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">URL do Site</label>
        <input type="url" name="site_setting[site_url]"
               value="<%= @configuracoes['site_url'] %>"
               placeholder="https://buscamais.org"
               class="input text-sm">
      </div>
      </div>
    </div>

    <%# Branding — upload real de arquivos %>
    <div class="card">
      <div class="card-header">
        <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Identidade Visual</h3>
      </div>
      <div class="card-body space-y-6">

      <%# Logo %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Logotipo do Site</label>
        <div class="flex items-center gap-4">
          <%# Preview %>
          <div class="w-24 h-14 rounded-lg border border-gray-200 bg-gray-50 flex items-center justify-center overflow-hidden shrink-0">
            <% if @branding.logo.attached? %>
              <img src="<%= @branding.logo_url %>" alt="Logo atual" class="max-w-full max-h-full object-contain p-1">
            <% else %>
              <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            <% end %>
          </div>

          <%# Upload %>
          <div class="flex-1">
            <label class="relative cursor-pointer inline-flex items-center gap-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium px-4 py-2 rounded-lg transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
              </svg>
              <%= @branding.logo.attached? ? "Trocar Logo" : "Enviar Logo" %>
              <input type="file" name="branding_logo" accept="image/*" class="sr-only"
                     onchange="this.closest('label').querySelector('span.fn') && (this.closest('label').querySelector('span.fn').textContent = this.files[0]?.name || '')">
            </label>
            <p class="text-xs text-gray-400 mt-1.5">PNG, SVG ou WebP — recomendado 300×80px</p>
            <% if @branding.logo.attached? %>
              <label class="inline-flex items-center gap-1 mt-1.5 text-xs text-red-500 hover:text-red-700 cursor-pointer">
                <input type="checkbox" name="remover_logo" value="1" class="w-3.5 h-3.5">
                Remover logo atual
              </label>
            <% end %>
          </div>
        </div>
      </div>

      <%# Favicon %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Favicon (aba do navegador)</label>
        <div class="flex items-center gap-4">
          <%# Preview %>
          <div class="w-12 h-12 rounded-lg border border-gray-200 bg-gray-50 flex items-center justify-center overflow-hidden shrink-0">
            <% if @branding.favicon.attached? %>
              <img src="<%= @branding.favicon_url %>" alt="Favicon atual" class="max-w-full max-h-full object-contain">
            <% else %>
              <svg class="w-6 h-6 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            <% end %>
          </div>

          <%# Upload %>
          <div class="flex-1">
            <label class="relative cursor-pointer inline-flex items-center gap-2 bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium px-4 py-2 rounded-lg transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
              </svg>
              <%= @branding.favicon.attached? ? "Trocar Favicon" : "Enviar Favicon" %>
              <input type="file" name="branding_favicon" accept="image/png,image/x-icon,image/svg+xml" class="sr-only">
            </label>
            <p class="text-xs text-gray-400 mt-1.5">PNG ou ICO — 32×32px ou 64×64px</p>
            <% if @branding.favicon.attached? %>
              <label class="inline-flex items-center gap-1 mt-1.5 text-xs text-red-500 hover:text-red-700 cursor-pointer">
                <input type="checkbox" name="remover_favicon" value="1" class="w-3.5 h-3.5">
                Remover favicon atual
              </label>
            <% end %>
          </div>
        </div>
      </div>
      </div>
    </div>

    <%# Email %>
    <div class="card">
      <div class="card-header">
        <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Configurações de E-mail</h3>
      </div>
      <div class="card-body space-y-5">

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">
            E-mail Remetente <span class="text-red-500">*</span>
          </label>
          <input type="email" name="site_setting[email_remetente]"
                 value="<%= @configuracoes['email_remetente'] %>"
                 placeholder="noreply@seusite.com"
                 class="input text-sm">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Nome do Remetente</label>
          <input type="text" name="site_setting[email_nome]"
                 value="<%= @configuracoes['email_nome'] %>"
                 placeholder="Busca Mais"
                 class="input text-sm">
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Rodapé do E-mail</label>
        <textarea name="site_setting[email_rodape]" rows="2"
                  placeholder="Texto exibido no rodapé de todos os e-mails..."
                  class="input text-sm resize-none"><%= @configuracoes['email_rodape'] %></textarea>
      </div>
      </div>
    </div>

    <%# Google OAuth %>
    <div class="card">
      <div class="card-body space-y-5">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Login com Google</h3>
          <% if @configuracoes["google_client_id"].present? && @configuracoes["google_client_secret"].present? %>
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-green-700 bg-green-50 px-2 py-0.5 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Ativo
            </span>
          <% else %>
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">
              Não configurado
            </span>
          <% end %>
        </div>
        <p class="text-xs text-gray-500 mb-4">
          Permite que usuários criem conta ou entrem usando a conta Google.
          Obtenha as credenciais em
          <strong>console.cloud.google.com</strong> → APIs &amp; Serviços → Credenciais → Criar ID do cliente OAuth.
          Na tela de configuração do Google, adicione a URI de redirecionamento autorizada:
          <code class="bg-gray-100 text-gray-700 px-1.5 py-0.5 rounded text-xs font-mono select-all"><%= "#{SiteSetting['site_url'].presence || request.base_url}/conta/auth/google_oauth2/callback" %></code>
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Client ID</label>
          <input type="text" name="site_setting[google_client_id]"
                 value="<%= @configuracoes['google_client_id'] %>"
                 placeholder="123456789-abc...apps.googleusercontent.com"
                 autocomplete="off"
                 class="input text-sm font-mono">
          <p class="text-xs text-gray-400 mt-1">Identificador público do aplicativo Google.</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Client Secret</label>
          <input type="password" name="site_setting[google_client_secret]"
                 value="<%= @configuracoes['google_client_secret'] %>"
                 placeholder="GOCSPX-..."
                 autocomplete="new-password"
                 class="input text-sm font-mono">
          <p class="text-xs text-gray-400 mt-1">Chave secreta — nunca compartilhe publicamente.</p>
        </div>
      </div>

      <% if @configuracoes["google_client_id"].present? %>
        <p class="text-xs text-amber-600 bg-amber-50 border border-amber-100 rounded-lg px-3 py-2">
          Após salvar novas credenciais, o login com Google começa a funcionar imediatamente na próxima tentativa — sem reiniciar o servidor.
        </p>
      <% end %>
      </div>
    </div>

    <%# Stripe %>
    <div class="card lg:col-span-2">
      <div class="card-body space-y-5">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <svg class="w-5 h-5 text-indigo-600" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13.479 9.883c-1.626-.604-2.512-1.067-2.512-1.803 0-.604.559-1.24 1.716-1.24a5.63 5.63 0 012.34.572l.415-2.516A6.78 6.78 0 0013.04 4.4c-2.977 0-5.043 1.582-5.043 3.86 0 2.037 1.44 3.096 3.796 3.838 1.538.528 2.017 1.052 2.017 1.79 0 .72-.624 1.24-1.765 1.24a6.39 6.39 0 01-2.857-.72l-.44 2.543a7.38 7.38 0 003.21.72c3.13 0 5.27-1.516 5.27-3.94-.006-2.215-1.494-3.226-3.75-3.848zM2 4.4l-.96 5.568.937-4.696A1.2 1.2 0 013.168 4.4H2zm3.528 0l-1.8 10.8h2.04l.408-2.4h2.04l-.408 2.4h2.04l1.8-10.8H9.6l-.48 2.8H7.08l.48-2.8H5.528zm13.352 7.56l-.48-2.4H16.8l.504-2.88-.48-1.32-.864 4.2h-1.68L12.84 4.4h2.04l1.8 10.8h-2.04l-.36-2.16"/>
          </svg>
          <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Pagamentos — Stripe</h3>
          <% stripe_test_mode = @configuracoes["stripe_publishable_key"]&.start_with?("pk_test_") %>
          <% if @configuracoes["stripe_secret_key"].present? %>
            <% if stripe_test_mode %>
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Modo Teste
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-green-700 bg-green-50 px-2 py-0.5 rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Configurado
              </span>
            <% end %>
          <% else %>
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">Não configurado</span>
          <% end %>
          <%# Ícone de ajuda %>
          <button type="button"
                  onclick="document.getElementById('stripe-help-modal').showModal()"
                  title="Como configurar o Stripe"
                  class="ml-auto flex items-center gap-1.5 text-xs font-medium text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-2.5 py-1 rounded-full transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Como configurar
          </button>
        </div>
        <p class="text-xs text-gray-500 mb-4">
          Configure as chaves Stripe para habilitar cobranças de assinatura.
          O webhook deve apontar para:
          <code class="bg-gray-100 text-gray-700 px-1.5 py-0.5 rounded text-xs font-mono select-all"><%= "#{SiteSetting['site_url'].presence || request.base_url}/stripe/webhook" %></code>
        </p>
      </div>

      <%# Modal de ajuda passo a passo %>
      <dialog id="stripe-help-modal"
              class="rounded-2xl shadow-2xl w-full max-w-2xl p-0 backdrop:bg-black/50"
              onclick="if(event.target===this)this.close()">
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <h2 class="text-base font-bold text-gray-900">Como configurar o Stripe</h2>
          </div>
          <button type="button" onclick="document.getElementById('stripe-help-modal').close()"
                  class="p-1.5 rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <div class="px-6 py-5 space-y-6 max-h-[70vh] overflow-y-auto">

          <%# Passo 1 %>
          <div class="flex gap-4">
            <div class="flex-none w-7 h-7 rounded-full bg-indigo-600 text-white text-xs font-bold flex items-center justify-center mt-0.5">1</div>
            <div>
              <h3 class="text-sm font-semibold text-gray-900 mb-1">Crie uma conta ou acesse o Dashboard Stripe</h3>
              <p class="text-sm text-gray-600">
                Acesse
                <a href="https://dashboard.stripe.com" target="_blank" rel="noopener"
                   class="text-indigo-600 hover:underline font-medium">dashboard.stripe.com</a>
                e faça login. Se ainda não tem conta, clique em <strong>Start now</strong> e siga o cadastro.
              </p>
              <p class="text-xs text-amber-600 bg-amber-50 border border-amber-100 rounded-lg px-3 py-2 mt-2">
                Use o modo <strong>Test</strong> (chaves <code class="font-mono">pk_test_</code> / <code class="font-mono">sk_test_</code>) durante os testes, e <strong>Live</strong> somente em produção.
              </p>
            </div>
          </div>

          <%# Passo 2 %>
          <div class="flex gap-4">
            <div class="flex-none w-7 h-7 rounded-full bg-indigo-600 text-white text-xs font-bold flex items-center justify-center mt-0.5">2</div>
            <div>
              <h3 class="text-sm font-semibold text-gray-900 mb-1">Copie as chaves de API</h3>
              <p class="text-sm text-gray-600 mb-2">
                No menu lateral, clique em <strong>Developers</strong> → <strong>API Keys</strong>.
              </p>
              <ul class="space-y-1.5 text-sm text-gray-600">
                <li class="flex items-start gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 mt-2 shrink-0"></span>
                  Copie a <strong>Publishable key</strong> (<code class="font-mono text-xs bg-gray-100 px-1 rounded">pk_live_…</code>) → campo <em>Publishable Key</em> acima.
                </li>
                <li class="flex items-start gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 mt-2 shrink-0"></span>
                  Clique em <strong>Reveal test key</strong> para ver a <strong>Secret key</strong> (<code class="font-mono text-xs bg-gray-100 px-1 rounded">sk_live_…</code>) → campo <em>Secret Key</em> acima.
                </li>
              </ul>
            </div>
          </div>

          <%# Passo 3 %>
          <div class="flex gap-4">
            <div class="flex-none w-7 h-7 rounded-full bg-indigo-600 text-white text-xs font-bold flex items-center justify-center mt-0.5">3</div>
            <div>
              <h3 class="text-sm font-semibold text-gray-900 mb-1">Crie o endpoint de Webhook</h3>
              <p class="text-sm text-gray-600 mb-2">
                Vá em <strong>Developers</strong> → <strong>Webhooks</strong> → <strong>Add endpoint</strong>.
              </p>
              <div class="bg-gray-50 border border-gray-200 rounded-lg p-3 mb-2">
                <p class="text-xs font-medium text-gray-500 mb-1">URL do endpoint:</p>
                <code class="text-xs font-mono text-indigo-700 select-all break-all">
                  <%= "#{SiteSetting['site_url'].presence || request.base_url}/stripe/webhook" %>
                </code>
              </div>
              <p class="text-sm text-gray-600 mb-2">Em <strong>Select events</strong>, adicione exatamente estes eventos:</p>
              <div class="bg-gray-50 border border-gray-200 rounded-lg divide-y divide-gray-100 text-xs font-mono">
                <% [
                  ["checkout.session.completed",      "Pagamento no checkout concluído"],
                  ["customer.subscription.updated",   "Assinatura alterada ou renovada"],
                  ["customer.subscription.deleted",   "Assinatura cancelada"],
                  ["invoice.payment_failed",          "Falha no pagamento da fatura"],
                ].each do |evento, descricao| %>
                  <div class="flex items-center gap-3 px-3 py-2">
                    <svg class="w-3.5 h-3.5 text-green-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-gray-800"><%= evento %></span>
                    <span class="text-gray-400 font-sans normal-case ml-auto hidden sm:inline"><%= descricao %></span>
                  </div>
                <% end %>
              </div>
              <p class="text-xs text-gray-500 mt-2">Clique em <strong>Add endpoint</strong> para salvar.</p>
            </div>
          </div>

          <%# Passo 4 %>
          <div class="flex gap-4">
            <div class="flex-none w-7 h-7 rounded-full bg-indigo-600 text-white text-xs font-bold flex items-center justify-center mt-0.5">4</div>
            <div>
              <h3 class="text-sm font-semibold text-gray-900 mb-1">Copie o Webhook Secret</h3>
              <p class="text-sm text-gray-600">
                Após criar o endpoint, clique nele na lista. Procure por <strong>Signing secret</strong> e clique em <strong>Reveal</strong>. Copie o valor (começa com <code class="font-mono text-xs bg-gray-100 px-1 rounded">whsec_…</code>) e cole no campo <em>Webhook Secret</em> acima.
              </p>
            </div>
          </div>

          <%# Passo 5 — modo teste %>
          <div class="flex gap-4">
            <div class="flex-none w-7 h-7 rounded-full bg-amber-500 text-white text-xs font-bold flex items-center justify-center mt-0.5">5</div>
            <div>
              <h3 class="text-sm font-semibold text-gray-900 mb-1">Quer testar sem gastar dinheiro? Use o Modo Teste</h3>
              <p class="text-sm text-gray-600 mb-2">
                No Dashboard Stripe, ative o <strong>modo Test</strong> (toggle no topo da página). As chaves de teste começam com <code class="font-mono text-xs bg-gray-100 px-1 rounded">pk_test_</code> e <code class="font-mono text-xs bg-gray-100 px-1 rounded">sk_test_</code> — nenhuma cobrança real acontece.
              </p>
              <p class="text-sm text-gray-600 mb-2">Use estes cartões fictícios para simular pagamentos:</p>
              <div class="bg-amber-50 border border-amber-200 rounded-lg divide-y divide-amber-100 text-xs">
                <% [
                  ["4242 4242 4242 4242", "Aprovado"],
                  ["4000 0025 0000 3155", "Aprovado c/ 3D Secure"],
                  ["4000 0000 0000 9995", "Recusado"],
                ].each do |numero, resultado| %>
                  <div class="flex items-center gap-3 px-3 py-2">
                    <code class="font-mono tracking-wider text-amber-900 select-all"><%= numero %></code>
                    <span class="ml-auto text-amber-700"><%= resultado %></span>
                  </div>
                <% end %>
              </div>
              <p class="text-xs text-gray-500 mt-2">Validade: qualquer data futura · CVC: qualquer número</p>
            </div>
          </div>

          <%# Passo 6 %>
          <div class="flex gap-4">
            <div class="flex-none w-7 h-7 rounded-full bg-green-500 text-white text-xs font-bold flex items-center justify-center mt-0.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-gray-900 mb-1">Salve as configurações</h3>
              <p class="text-sm text-gray-600">
                Volte a esta página, cole as chaves nos campos correspondentes e clique em <strong>Salvar Configurações</strong>. Os pagamentos já estarão ativos na próxima tentativa de assinatura.
              </p>
            </div>
          </div>

        </div>

        <div class="px-6 py-4 border-t border-gray-100 bg-gray-50 flex justify-end rounded-b-2xl">
          <button type="button" onclick="document.getElementById('stripe-help-modal').close()"
                  class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors">
            Entendido
          </button>
        </div>
      </dialog>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Publishable Key</label>
          <input type="text" name="site_setting[stripe_publishable_key]"
                 value="<%= @configuracoes['stripe_publishable_key'] %>"
                 placeholder="pk_live_..."
                 autocomplete="off"
                 class="input text-sm font-mono">
          <p class="text-xs text-gray-400 mt-1">Chave pública — usada no frontend.</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Secret Key</label>
          <input type="password" name="site_setting[stripe_secret_key]"
                 value="<%= @configuracoes['stripe_secret_key'] %>"
                 placeholder="sk_live_..."
                 autocomplete="new-password"
                 class="input text-sm font-mono">
          <p class="text-xs text-gray-400 mt-1">Chave secreta — nunca exponha publicamente.</p>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Webhook Secret</label>
        <input type="password" name="site_setting[stripe_webhook_secret]"
               value="<%= @configuracoes['stripe_webhook_secret'] %>"
               placeholder="whsec_..."
               autocomplete="new-password"
               class="input text-sm font-mono max-w-sm">
        <p class="text-xs text-gray-400 mt-1">Encontrado em Dashboard → Webhooks → seu endpoint.</p>
      </div>

      <%# Banner e cartões de teste — exibidos quando chaves pk_test_ estão ativas %>
      <% if stripe_test_mode %>
        <div class="rounded-xl border border-amber-200 bg-amber-50 p-4">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-4 h-4 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
            <p class="text-sm font-semibold text-amber-800">Modo Teste Ativo — nenhuma cobrança real será feita</p>
          </div>
          <p class="text-xs text-amber-700 mb-3">Use os cartões abaixo para simular transações. O dinheiro é fictício e não há cobrança real.</p>
          <div class="overflow-x-auto">
            <table class="w-full text-xs">
              <thead>
                <tr class="text-left text-amber-800 font-semibold border-b border-amber-200">
                  <th class="pb-2 pr-4">Número do Cartão</th>
                  <th class="pb-2 pr-4">Validade</th>
                  <th class="pb-2 pr-4">CVC</th>
                  <th class="pb-2">Resultado</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-amber-100">
                <% [
                  ["4242 4242 4242 4242", "Qualquer data futura", "Qualquer", "✅ Pagamento aprovado"],
                  ["4000 0025 0000 3155", "Qualquer data futura", "Qualquer", "🔐 Requer autenticação 3D Secure"],
                  ["4000 0000 0000 9995", "Qualquer data futura", "Qualquer", "❌ Cartão recusado"],
                  ["4000 0000 0000 0069", "Qualquer data futura", "Qualquer", "❌ Cartão expirado"],
                ].each do |numero, validade, cvc, resultado| %>
                  <tr class="text-amber-900">
                    <td class="py-1.5 pr-4 font-mono tracking-wider select-all"><%= numero %></td>
                    <td class="py-1.5 pr-4"><%= validade %></td>
                    <td class="py-1.5 pr-4"><%= cvc %></td>
                    <td class="py-1.5"><%= resultado %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <p class="text-xs text-amber-600 mt-3">
            Para ir à produção, substitua pelas chaves <code class="font-mono bg-amber-100 px-1 rounded">pk_live_</code> / <code class="font-mono bg-amber-100 px-1 rounded">sk_live_</code> no Dashboard Stripe.
          </p>
        </div>
      <% end %>
      </div>
    </div>

    <%# Google AdSense %>
    <div class="card lg:col-span-2">
      <div class="card-body space-y-5">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <svg class="w-5 h-5 text-blue-500" viewBox="0 0 24 24" fill="currentColor">
            <path d="M21 3H3a2 2 0 00-2 2v14a2 2 0 002 2h18a2 2 0 002-2V5a2 2 0 00-2-2zm-1 14H4V6h16v11zM6 10h2v4H6zm3.5 0h2v4h-2zm3.5 0h2v4h-2z"/>
          </svg>
          <h3 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Google AdSense</h3>
          <% if @configuracoes["ads_ativo"] == "true" && @configuracoes["ads_publisher_id"].present? %>
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-green-700 bg-green-50 px-2 py-0.5 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Ativo
            </span>
          <% else %>
            <span class="inline-flex items-center gap-1 text-xs font-semibold text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">
              Desativado
            </span>
          <% end %>
        </div>
        <p class="text-xs text-gray-500 mb-4">
          Anúncios são exibidos apenas para usuários <strong>sem assinatura paga</strong> (visitantes e plano gratuito).
          Assinantes ativos nunca veem anúncios. Obtenha as credenciais em
          <strong>adsense.google.com</strong> → Conta → Informações da conta.
        </p>
      </div>

      <%# Toggle ativar/desativar %>
      <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-200">
        <div>
          <p class="text-sm font-semibold text-gray-800">Ativar anúncios no site</p>
          <p class="text-xs text-gray-500 mt-0.5">Exige Publisher ID e pelo menos um Slot ID configurado abaixo.</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="hidden" name="site_setting[ads_ativo]" value="false">
          <input type="checkbox" name="site_setting[ads_ativo]" value="true"
                 class="sr-only peer"
                 <%= "checked" if @configuracoes["ads_ativo"] == "true" %>>
          <div class="w-11 h-6 bg-gray-200 peer-focus:ring-2 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
        </label>
      </div>

      <%# Publisher ID %>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1.5">Publisher ID</label>
        <input type="text" name="site_setting[ads_publisher_id]"
               value="<%= @configuracoes['ads_publisher_id'] %>"
               placeholder="ca-pub-XXXXXXXXXXXXXXXX"
               autocomplete="off"
               class="input text-sm font-mono">
        <p class="text-xs text-gray-400 mt-1">Encontrado em AdSense → Conta → Informações da conta.</p>
      </div>

      <%# Slots %>
      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Slot — Faixa horizontal</label>
          <input type="text" name="site_setting[ads_slot_horizontal]"
                 value="<%= @configuracoes['ads_slot_horizontal'] %>"
                 placeholder="XXXXXXXXXX"
                 autocomplete="off"
                 class="input text-sm font-mono">
          <p class="text-xs text-gray-400 mt-1">Entre seções da homepage.</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Slot — Quadrado 300×250</label>
          <input type="text" name="site_setting[ads_slot_quadrado]"
                 value="<%= @configuracoes['ads_slot_quadrado'] %>"
                 placeholder="XXXXXXXXXX"
                 autocomplete="off"
                 class="input text-sm font-mono">
          <p class="text-xs text-gray-400 mt-1">Sidebar e posições compactas.</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Slot — In-content (fluido)</label>
          <input type="text" name="site_setting[ads_slot_in_content]"
                 value="<%= @configuracoes['ads_slot_in_content'] %>"
                 placeholder="XXXXXXXXXX"
                 autocomplete="off"
                 class="input text-sm font-mono">
          <p class="text-xs text-gray-400 mt-1">Dentro dos artigos, após o conteúdo.</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5">Slot — Vertical (sidebar)</label>
          <input type="text" name="site_setting[ads_slot_vertical]"
                 value="<%= @configuracoes['ads_slot_vertical'] %>"
                 placeholder="XXXXXXXXXX"
                 autocomplete="off"
                 class="input text-sm font-mono">
          <p class="text-xs text-gray-400 mt-1">Usado quando não há anúncio direto ativo nesse slot.</p>
        </div>
      </div>

      <div class="rounded-lg bg-blue-50 border border-blue-100 px-4 py-3 text-xs text-blue-700">
        <strong>Como obter os Slot IDs:</strong> no painel do AdSense, vá em
        <strong>Anúncios → Por anúncio → Criar novo anúncio</strong>, escolha o formato
        e copie o número do campo <code class="font-mono bg-blue-100 px-1 rounded">data-ad-slot</code>
        gerado pelo AdSense.
      </div>
      </div>
    </div>

    </div>

    <%# Actions %>
    <div class="flex items-center justify-end gap-3 mt-6">
      <button type="submit" class="btn-primary">
        Salvar Configurações
      </button>
    </div>

  <% end %>
</div>
