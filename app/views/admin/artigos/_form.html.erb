<%= form_with model: artigo,
              url: artigo.new_record? ? admin_artigos_path : admin_artigo_path(artigo),
              class: "space-y-6" do |f| %>
  <% if artigo.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% artigo.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <%# ── Coluna principal ── %>
    <div class="lg:col-span-2 space-y-5">

      <%# Título %>
      <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
        <%= f.label :titulo, "Título *", class: "block text-sm font-semibold text-gray-700 mb-1.5" %>
        <%= f.text_field :titulo,
            class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-lg font-medium focus:outline-none focus:ring-2 focus:ring-blue-500",
            placeholder: "Título do artigo..." %>
      </div>

      <%# Conteúdo — editor Quill com galeria integrada %>
      <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100"
           data-controller="rich-editor"
           data-rich-editor-url-value="<%= admin_midias_path %>">

        <%= f.label :conteudo, "Conteúdo *", class: "block text-sm font-semibold text-gray-700 mb-2" %>

        <%# Hidden textarea — valor enviado no form %>
        <textarea name="article[conteudo]" id="article_conteudo"
                  data-rich-editor-target="input"
                  class="hidden"><%= artigo.conteudo.body&.to_html %></textarea>

        <%# Área visual do Quill %>
        <div data-rich-editor-target="editor"></div>

        <%# Galeria picker para inserir imagens no corpo %>
        <div data-rich-editor-target="panel"
             class="hidden fixed inset-0 z-50 flex items-center justify-center p-4"
             style="background:rgba(0,0,0,0.55)"
             data-action="click->rich-editor#closeBackdrop">
          <div class="bg-white rounded-2xl w-full max-w-3xl shadow-2xl flex flex-col" style="max-height:85vh"
               onclick="event.stopPropagation()">
            <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100 shrink-0">
              <h3 class="text-base font-bold text-gray-900">Inserir imagem da galeria</h3>
              <button type="button" data-action="click->rich-editor#close"
                      class="p-1.5 rounded-lg text-gray-400 hover:bg-gray-100 hover:text-gray-700 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
              </button>
            </div>
            <div class="px-5 pt-4 shrink-0 flex items-center gap-3">
              <label class="relative flex items-center gap-1.5 cursor-pointer bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-3 py-2 rounded-lg transition-colors shrink-0 select-none">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
                </svg>
                Upload
                <input type="file" accept="image/jpeg,image/png,image/webp,image/gif" multiple class="sr-only"
                       data-rich-editor-target="uploadInput"
                       data-action="change->rich-editor#upload">
              </label>
              <span data-rich-editor-target="uploadStatus" class="hidden text-xs font-medium text-blue-600"></span>
              <div class="relative flex-1">
                <svg class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/>
                </svg>
                <input type="text" placeholder="Buscar imagem…"
                       data-rich-editor-target="search"
                       data-action="input->rich-editor#search"
                       class="w-full pl-9 pr-4 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              </div>
            </div>
            <div class="p-5 overflow-y-auto flex-1">
              <div data-rich-editor-target="spinner" class="hidden flex justify-center py-10">
                <svg class="animate-spin w-6 h-6 text-blue-500" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
                </svg>
              </div>
              <div data-rich-editor-target="grid"
                   class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-3"></div>
            </div>
          </div>
        </div>

      </div>

      <%# Resumo — opcional %>
      <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
        <div class="flex items-center justify-between mb-1.5">
          <%= f.label :resumo, "Resumo", class: "text-sm font-semibold text-gray-700" %>
          <span class="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full">Opcional</span>
        </div>
        <p class="text-xs text-gray-400 mb-2">Aparece nas listagens e em SEO. Se vazio, o início do conteúdo é usado automaticamente.</p>
        <%= f.text_area :resumo, rows: 3,
            class: "w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none",
            placeholder: "Resumo breve do artigo (máx. 500 caracteres)...",
            maxlength: 500 %>
        <p class="text-xs text-gray-400 mt-1 text-right"><span id="resumo_count">0</span>/500</p>
      </div>

    </div>

    <%# ── Barra lateral ── %>
    <div class="space-y-5">

      <%# Imagem de capa — com galeria %>
      <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100"
           data-controller="media-gallery"
           data-media-gallery-url-value="<%= admin_midias_path %>">

        <p class="text-sm font-semibold text-gray-700 mb-3">Imagem de Capa</p>

        <%# Preview %>
        <div class="mb-3">
          <% if artigo.imagem_capa_file.attached? %>
            <div class="relative group rounded-lg overflow-hidden">
              <img src="<%= url_for(artigo.imagem_capa_file) %>"
                   data-media-gallery-target="preview"
                   class="w-full aspect-video object-cover"
                   alt="Imagem de capa">
              <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity rounded-lg">
                <span class="text-white text-xs font-medium text-center px-2">Selecione outra para substituir</span>
              </div>
            </div>
          <% else %>
            <div data-media-gallery-target="placeholder"
                 class="aspect-video bg-gradient-to-br from-gray-100 to-gray-200 rounded-lg border-2 border-dashed border-gray-300 flex flex-col items-center justify-center gap-2 text-gray-400">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span class="text-xs">Nenhuma imagem</span>
            </div>
            <img data-media-gallery-target="preview"
                 src="" alt="Preview"
                 class="hidden w-full aspect-video object-cover rounded-lg">
          <% end %>
        </div>

        <%# Campo oculto para seleção da galeria %>
        <%= f.hidden_field :imagem_capa_sgid, data: { "media-gallery-target": "sgidField" } %>

        <%# Ações %>
        <div class="flex flex-col gap-2">
          <button type="button"
                  data-action="click->media-gallery#open"
                  class="w-full flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-3 py-2.5 rounded-lg transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Selecionar da Galeria
          </button>
          <p class="text-xs text-gray-400 text-center">Faça o upload na galeria e selecione aqui</p>
        </div>

        <%# Modal da galeria %>
        <%= render "shared/gallery_modal", gallery_url: admin_midias_path %>
      </div>

      <%# Publicação %>
      <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
        <p class="text-sm font-semibold text-gray-700 mb-4">Publicação</p>
        <div class="mb-4">
          <%= f.label :status, "Status", class: "block text-xs font-medium text-gray-500 mb-1" %>
          <%= f.select :status, Article.statuses.keys.map { |s| [s.humanize, s] },
              {}, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none" %>
        </div>
        <div class="mb-4">
          <%= f.label :agendado_em, "Agendar para", class: "block text-xs font-medium text-gray-500 mb-1" %>
          <%= f.datetime_local_field :agendado_em, class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none" %>
        </div>
        <div class="flex items-center gap-2">
          <%= f.check_box :destaque, class: "w-4 h-4 text-blue-600 border-gray-300 rounded" %>
          <%= f.label :destaque, "Marcar como destaque", class: "text-sm text-gray-700" %>
        </div>
        <div class="flex items-center gap-2 mt-2 pt-2 border-t border-gray-100">
          <%= f.check_box :premium, class: "w-4 h-4 text-amber-500 border-gray-300 rounded" %>
          <label class="text-sm text-gray-700 flex items-center gap-1.5 cursor-pointer">
            <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            Artigo Premium <span class="text-xs text-gray-400">(requer assinatura)</span>
          </label>
        </div>
      </div>

      <%# Botão de publicação rápida %>
      <% unless artigo.new_record? %>
        <% if artigo.publicado? %>
          <%= button_to arquivar_admin_artigo_path(artigo), method: :patch,
              data: { turbo_confirm: "Arquivar este artigo? Ele ficará invisível para leitores." },
              class: "w-full flex items-center justify-center gap-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-semibold py-2.5 rounded-xl transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8l1 12a2 2 0 002 2h8a2 2 0 002-2L19 8m-9 4v4m4-4v4"/>
            </svg>
            Arquivar artigo
          <% end %>
        <% else %>
          <%= button_to publicar_admin_artigo_path(artigo), method: :patch,
              class: "w-full flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold py-2.5 rounded-xl transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Publicar agora
          <% end %>
        <% end %>
      <% else %>
        <%# Novo artigo: botão que seta status=publicado via JS e submete %>
        <button type="button"
                onclick="document.getElementById('article_status').value='publicado'; this.closest('form').requestSubmit()"
                class="w-full flex items-center justify-center gap-2 bg-green-600 hover:bg-green-700 text-white text-sm font-semibold py-2.5 rounded-xl transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          Criar e publicar
        </button>
      <% end %>

      <%# Categoria & Tags %>
      <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
        <p class="text-sm font-semibold text-gray-700 mb-4">Categoria & Tags</p>
        <div class="mb-4">
          <%= f.label :category_id, "Categoria", class: "block text-xs font-medium text-gray-500 mb-1" %>
          <%= f.collection_select :category_id, @categorias, :id, :nome, { include_blank: "Selecione..." },
              class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none" %>
        </div>
        <div data-controller="tag-input">
          <label class="block text-xs font-medium text-gray-500 mb-1">Tags</label>

          <%# Chips das tags selecionadas %>
          <div data-tag-input-target="chips" class="flex flex-wrap gap-1.5 mb-2 empty:hidden"></div>

          <%# Input de texto %>
          <input type="text"
                 name="article[tag_names]"
                 id="article_tag_names"
                 data-tag-input-target="input"
                 data-action="keydown->tag-input#keydown blur->tag-input#blur"
                 value="<%= artigo.tags.map(&:nome).join(', ') %>"
                 placeholder="Digite tags separadas por vírgula..."
                 autocomplete="off"
                 class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <p class="text-xs text-gray-400 mt-1 mb-2">Pressione vírgula ou Enter para confirmar. Novas tags são criadas automaticamente.</p>

          <%# Sugestões clicáveis %>
          <% if @tags.any? %>
            <div class="flex flex-wrap gap-1.5">
              <% @tags.each do |tag| %>
                <button type="button"
                        data-tag-input-target="suggestion"
                        data-action="click->tag-input#toggle"
                        data-tag-name="<%= tag.nome %>"
                        class="text-xs border border-gray-200 text-gray-600 bg-white px-2.5 py-1 rounded-full hover:border-blue-400 transition-colors cursor-pointer">
                  #<%= tag.nome %>
                </button>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Botões %>
      <div class="flex gap-3">
        <%= f.submit artigo.new_record? ? "Criar Artigo" : "Salvar Alterações",
            class: "flex-1 bg-blue-600 text-white py-2.5 rounded-lg text-sm font-semibold hover:bg-blue-700 cursor-pointer text-center" %>
        <%= link_to "Cancelar", admin_artigos_path,
            class: "flex-1 text-center border border-gray-300 text-gray-700 py-2.5 rounded-lg text-sm hover:bg-gray-50" %>
      </div>

    </div>
  </div>
<% end %>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const textarea = document.querySelector("textarea[name='article[resumo]']");
    const counter  = document.getElementById("resumo_count");
    if (textarea && counter) {
      counter.textContent = textarea.value.length;
      textarea.addEventListener("input", () => counter.textContent = textarea.value.length);
    }
  });
</script>
