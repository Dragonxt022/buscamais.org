<% content_for :page_title, "Gerenciamento de Notícias" %>
<% content_for :page_subtitle, "Supervisione e edite seu feed de publicação global." %>

<div class="bg-white rounded-xl shadow-sm border border-gray-100"
     data-controller="table-select"
     data-table-select-confirm-message-value="Remover {count} artigo(s) selecionado(s)?\nEsta ação não pode ser desfeita.">

  <%# Header com filtros + botão novo artigo %>
  <div class="p-5 border-b border-gray-100 flex flex-wrap gap-3 items-end">
    <%= form_with url: admin_artigos_path, method: :get, class: "flex gap-3 flex-wrap flex-1" do |f| %>
      <div class="relative flex-1 min-w-52">
        <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <%= f.search_field :q, value: params[:q], placeholder: "Buscar por título…",
            class: "w-full pl-9 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
      <%= f.select :categoria_id,
          options_from_collection_for_select(@categorias, :id, :nome, params[:categoria_id]),
          { include_blank: "Todas as categorias" },
          class: "input text-sm w-auto" %>
      <%= f.select :status,
          Article.statuses.keys.map { |s| [s.humanize, s] },
          { include_blank: "Todos os status" },
          class: "input text-sm w-auto" %>
      <%= f.submit "Filtrar", class: "btn-primary text-sm" %>
      <% if params[:q].present? || params[:categoria_id].present? || params[:status].present? %>
        <%= link_to "Limpar", admin_artigos_path, class: "text-sm text-gray-400 hover:text-gray-700 self-center" %>
      <% end %>
    <% end %>
    <%= link_to new_admin_artigo_path,
        class: "btn-primary text-sm flex items-center gap-1.5 shrink-0" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Novo Artigo
    <% end %>
  </div>

  <%# Bulk actions bar %>
  <div data-table-select-target="bulkBar"
       class="hidden bg-blue-50 border-b border-blue-100 px-5 py-2.5 flex items-center gap-4">
    <span class="text-sm font-semibold text-blue-700" data-table-select-target="selectedCount"></span>
    <button type="button" data-action="click->table-select#deleteSelected"
            class="flex items-center gap-1.5 text-sm font-semibold text-red-600 hover:text-red-700 bg-white border border-red-200 px-3 py-1.5 rounded-lg hover:bg-red-50 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
      </svg>
      Excluir selecionados
    </button>
    <button type="button" data-action="click->table-select#cancelSelection"
            class="text-sm text-gray-500 hover:text-gray-700">Cancelar</button>
  </div>
  <form data-table-select-target="bulkForm" action="<%= bulk_destroy_admin_artigos_path %>" method="post" class="hidden">
    <%= hidden_field_tag :_method, :delete %>
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  </form>

  <table class="w-full text-sm">
    <thead class="bg-gray-50">
      <tr>
        <th class="w-10 px-4 py-3">
          <input type="checkbox" data-select-all data-action="change->table-select#onSelectAll"
                 class="w-4 h-4 rounded border-gray-300 text-blue-600 cursor-pointer">
        </th>
        <th class="w-14 px-2 py-3"></th>
        <th class="text-left px-3 py-3 text-xs font-semibold text-gray-500 uppercase">Título</th>
        <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase">Autor</th>
        <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase">Categoria</th>
        <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase">Status</th>
        <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase">Data</th>
        <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase">Ações</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% @artigos.each do |artigo| %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3">
            <input type="checkbox"
                   value="<%= artigo.id %>"
                   data-table-select-target="checkbox"
                   data-action="change->table-select#onSelect"
                   class="w-4 h-4 rounded border-gray-300 text-blue-600 cursor-pointer">
          </td>
          <td class="px-2 py-3">
            <div class="w-12 h-9 rounded-lg overflow-hidden shrink-0 <%= artigo.imagem_capa_file.attached? ? 'shimmer' : 'bg-gray-100' %>"
                 <%= "data-controller=shimmer" if artigo.imagem_capa_file.attached? %>>
              <% if artigo.imagem_capa_file.attached? %>
                <%= image_tag url_for(artigo.imagem_capa_file), class: "w-full h-full object-cover", alt: "" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                </div>
              <% end %>
            </div>
          </td>
          <td class="px-3 py-3">
            <p class="font-medium text-gray-900 line-clamp-1 max-w-xs"><%= artigo.titulo %></p>
            <p class="text-xs text-gray-400">#ART-<%= artigo.id %></p>
          </td>
          <td class="px-5 py-3">
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-full bg-blue-600 flex items-center justify-center text-white text-xs font-bold">
                <%= artigo.author&.nome&.first&.upcase || "?" %>
              </div>
              <span class="text-gray-700"><%= artigo.author&.nome || "—" %></span>
            </div>
          </td>
          <td class="px-5 py-3">
            <% if artigo.category %>
              <span class="text-xs border border-gray-300 px-2 py-0.5 rounded uppercase font-medium">
                <%= artigo.category.nome %>
              </span>
            <% end %>
          </td>
          <td class="px-5 py-3"><%= render "shared/status_badge", status: artigo.status %></td>
          <td class="px-5 py-3 text-gray-500">
            <%= l(artigo.publicado_em || artigo.created_at, format: :short) %>
          </td>
          <td class="px-5 py-3">
            <div class="flex items-center gap-2">
              <%= link_to edit_admin_artigo_path(artigo), title: "Editar" do %>
                <svg class="w-4 h-4 text-gray-400 hover:text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
              <% end %>
              <% if artigo.slug.present? %>
                <%= link_to noticia_path(artigo.slug), target: "_blank", title: "Visualizar" do %>
                  <svg class="w-4 h-4 text-gray-400 hover:text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                <% end %>
              <% end %>
              <%= button_to admin_artigo_path(artigo), method: :delete,
                  data: { turbo_confirm: "Remover artigo '#{artigo.titulo}'?" },
                  title: "Remover", class: "inline" do %>
                <svg class="w-4 h-4 text-gray-400 hover:text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      <% if @artigos.empty? %>
        <tr><td colspan="8" class="px-5 py-12 text-center text-gray-400">Nenhum artigo encontrado.</td></tr>
      <% end %>
    </tbody>
  </table>

  <div class="px-5 py-4 border-t border-gray-100 flex items-center justify-between">
    <p class="text-sm text-gray-500">
      Mostrando <%= @pagy.from %> a <%= @pagy.to %> de <%= @pagy.count %> artigos
    </p>
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>
