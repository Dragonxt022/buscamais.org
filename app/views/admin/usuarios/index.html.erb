<% content_for :page_title, "Usuários" %>
<% content_for :page_subtitle, "Gerencie os usuários e permissões do portal." %>

<div class="card"
     data-controller="table-select"
     data-table-select-confirm-message-value="Remover {count} usuário(s) selecionado(s)?\nEsta ação não pode ser desfeita.">

  <div class="card-header">
    <%= form_with url: admin_usuarios_path, method: :get, class: "flex gap-3 flex-wrap flex-1" do |f| %>
      <%= f.search_field :q, value: params[:q], placeholder: "Buscar por nome ou e-mail...",
          class: "input max-w-xs" %>
      <%= f.select :role, User.roles.keys.map { |r| [r.humanize, r] },
          { include_blank: "Todos os Papéis" },
          class: "px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none" %>
      <%= f.select :status, [["Todos", ""], ["Ativos", "ativo"], ["Inativos", "inativo"]],
          { selected: params[:status] },
          class: "px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none" %>
      <%= f.submit "Filtrar", class: "btn-primary" %>
      <%= link_to "Resetar", admin_usuarios_path, class: "text-sm text-blue-600 hover:underline self-center" %>
    <% end %>
  </div>

  <%# Bulk actions bar %>
  <div data-table-select-target="bulkBar"
       class="hidden bg-blue-50 border-b border-blue-100 px-5 py-2.5 flex items-center gap-4">
    <span class="text-sm font-semibold text-blue-700" data-table-select-target="selectedCount"></span>
    <button type="button" data-action="click->table-select#deleteSelected"
            class="flex items-center gap-1.5 text-sm font-semibold text-red-600 hover:text-red-700 bg-white border border-red-200 px-3 py-1.5 rounded-lg hover:bg-red-50 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
      </svg>
      Excluir selecionados
    </button>
    <button type="button" data-action="click->table-select#cancelSelection"
            class="text-sm text-gray-500 hover:text-gray-700">Cancelar</button>
  </div>
  <form data-table-select-target="bulkForm" action="<%= bulk_destroy_admin_usuarios_path %>" method="post" class="hidden">
    <%= hidden_field_tag :_method, :delete %>
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  </form>

  <table class="table-admin">
    <thead>
      <tr>
        <th class="w-10">
          <input type="checkbox" data-select-all data-action="change->table-select#onSelectAll"
                 class="w-4 h-4 rounded border-gray-300 text-blue-600 cursor-pointer">
        </th>
        <th>Usuário</th>
        <th>E-mail</th>
        <th>Papel</th>
        <th>Status</th>
        <th>Desde</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      <% @usuarios.each do |usuario| %>
        <tr class="<%= usuario.ativo? ? '' : 'opacity-60 bg-gray-50' %>">
          <td>
            <% unless usuario == current_user %>
              <input type="checkbox"
                     value="<%= usuario.id %>"
                     data-table-select-target="checkbox"
                     data-action="change->table-select#onSelect"
                     class="w-4 h-4 rounded border-gray-300 text-blue-600 cursor-pointer">
            <% end %>
          </td>
          <td>
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full <%= usuario.ativo? ? 'bg-blue-600' : 'bg-gray-400' %> flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
                <%= usuario.nome.first.upcase %>
              </div>
              <span class="font-medium text-gray-900"><%= usuario.nome %></span>
            </div>
          </td>
          <td class="text-gray-600"><%= usuario.email %></td>
          <td>
            <% badge_class = { "administrador" => "bg-purple-100 text-purple-700", "editor" => "bg-blue-100 text-blue-700", "usuario" => "bg-gray-100 text-gray-600" } %>
            <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full <%= badge_class[usuario.role] || 'bg-gray-100 text-gray-600' %>">
              <%= usuario.role.humanize %>
            </span>
          </td>
          <td>
            <% if usuario.ativo? %>
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-green-700 bg-green-50 px-2.5 py-0.5 rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Ativo
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-red-600 bg-red-50 px-2.5 py-0.5 rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span> Inativo
              </span>
            <% end %>
          </td>
          <td class="text-gray-500"><%= l usuario.created_at, format: :short %></td>
          <td>
            <div class="flex items-center gap-1">
              <%= link_to edit_admin_usuario_path(usuario), title: "Editar" do %>
                <svg class="w-4 h-4 text-gray-400 hover:text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
              <% end %>
              <% unless usuario == current_user %>
                <%= button_to toggle_ativo_admin_usuario_path(usuario), method: :patch,
                    title: usuario.ativo? ? "Desativar" : "Ativar",
                    data: { turbo_confirm: usuario.ativo? ? "Desativar #{usuario.nome}?" : "Ativar #{usuario.nome}?" },
                    class: "inline" do %>
                  <% if usuario.ativo? %>
                    <svg class="w-4 h-4 text-gray-400 hover:text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                    </svg>
                  <% else %>
                    <svg class="w-4 h-4 text-gray-400 hover:text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                  <% end %>
                <% end %>
                <%= button_to admin_usuario_path(usuario), method: :delete,
                    title: "Excluir",
                    data: { turbo_confirm: "Excluir permanentemente #{usuario.nome}? Esta ação não pode ser desfeita." },
                    class: "inline" do %>
                  <svg class="w-4 h-4 text-gray-400 hover:text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                <% end %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="px-5 py-4 border-t border-gray-100 flex items-center justify-between">
    <p class="text-sm text-gray-500">
      Mostrando <%= @pagy.from %> a <%= @pagy.to %> de <%= @pagy.count %> usuários
    </p>
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>
