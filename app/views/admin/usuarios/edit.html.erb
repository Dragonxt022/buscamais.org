<% content_for :page_title, "Editar: #{@usuario.nome}" %>
<% content_for :page_subtitle, "Atualize os dados do usuário." %>

<div class="card max-w-lg">
  <div class="card-body">
    <%= form_with model: @usuario, url: admin_usuario_path(@usuario), method: :patch, class: "space-y-5" do |f| %>
      <% if @usuario.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4">
          <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
            <% @usuario.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :nome, "Nome", class: "label" %>
        <%= f.text_field :nome, class: "input" %>
      </div>
      <div>
        <%= f.label :email, "E-mail", class: "label" %>
        <%= f.email_field :email, class: "input" %>
      </div>
      <div>
        <%= f.label :bio, "Bio", class: "label" %>
        <%= f.text_area :bio, rows: 4, class: "input resize-none", placeholder: "Biografia do usuário..." %>
      </div>
      <div>
        <%= f.label :role, "Papel", class: "label" %>
        <%= f.select :role, User.roles.keys.map { |r| [r.humanize, r] }, {},
            class: "input" %>
      </div>

      <div class="flex gap-3 pt-2">
        <%= f.submit "Salvar Alterações", class: "btn-primary cursor-pointer" %>
        <%= link_to "Cancelar", admin_usuario_path(@usuario), class: "btn-secondary" %>
      </div>
    <% end %>
  </div>
</div>
