<% content_for :page_title, "Editar usuário" %>
<% content_for :page_subtitle, @usuario.email %>

<%= form_with model: @usuario, url: admin_usuario_path(@usuario), method: :patch do |f| %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <%# ── Coluna principal ── %>
    <div class="lg:col-span-2 space-y-5">

      <% if @usuario.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded-xl p-4">
          <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
            <% @usuario.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
          </ul>
        </div>
      <% end %>

      <%# Dados pessoais %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 divide-y divide-gray-50">
        <div class="px-6 py-4">
          <h3 class="text-sm font-semibold text-gray-800">Dados Pessoais</h3>
        </div>
        <div class="px-6 py-5 space-y-4">
          <div>
            <%= f.label :nome, "Nome completo", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= f.text_field :nome, class: "w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "Nome do usuário" %>
          </div>
          <div>
            <%= f.label :email, "E-mail", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= f.email_field :email, class: "w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
            <p class="text-xs text-gray-400 mt-1">Alterar o e-mail exige que o usuário confirme novamente.</p>
          </div>
          <div>
            <%= f.label :bio, "Biografia", class: "block text-sm font-medium text-gray-700 mb-1.5" %>
            <%= f.text_area :bio, rows: 4,
                class: "w-full px-3.5 py-2.5 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none",
                placeholder: "Uma breve apresentação do usuário..." %>
          </div>
        </div>
      </div>

      <%# Acesso e permissões %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 divide-y divide-gray-50">
        <div class="px-6 py-4">
          <h3 class="text-sm font-semibold text-gray-800">Acesso & Permissões</h3>
        </div>
        <div class="px-6 py-5 space-y-5">

          <%# Role %>
          <div>
            <p class="text-sm font-medium text-gray-700 mb-3">Papel do usuário</p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <% [
                ["usuario",       "Usuário",       "Acesso básico ao portal.", "bg-gray-100 text-gray-700"],
                ["editor",        "Editor",        "Pode criar e publicar artigos.", "bg-blue-100 text-blue-700"],
                ["administrador", "Administrador", "Acesso total ao painel.", "bg-purple-100 text-purple-700"],
              ].each do |value, label, desc, badge_cls| %>
                <label class="cursor-pointer">
                  <%= f.radio_button :role, value, class: "peer sr-only" %>
                  <div class="border-2 border-gray-200 rounded-xl p-4 transition-all peer-checked:border-blue-500 peer-checked:bg-blue-50 hover:border-gray-300 h-full">
                    <span class="inline-block text-xs font-bold px-2 py-0.5 rounded-full mb-2 <%= badge_cls %>"><%= label %></span>
                    <p class="text-xs text-gray-500 leading-snug"><%= desc %></p>
                  </div>
                </label>
              <% end %>
            </div>
          </div>

          <%# Status da conta %>
          <div class="flex items-center justify-between py-1">
            <div>
              <p class="text-sm font-medium text-gray-700">Conta ativa</p>
              <p class="text-xs text-gray-500 mt-0.5">Usuários inativos não conseguem fazer login.</p>
            </div>
            <% if @usuario == current_user %>
              <span class="text-xs text-gray-400 italic">Sua própria conta</span>
            <% else %>
              <label class="relative inline-flex items-center cursor-pointer">
                <%= f.check_box :ativo, class: "sr-only peer", id: "usuario_ativo" %>
                <div class="w-10 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-500"></div>
              </label>
            <% end %>
          </div>

        </div>
      </div>

      <%# Botões %>
      <div class="flex gap-3">
        <%= f.submit "Salvar Alterações",
            class: "flex-1 sm:flex-none bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-6 py-2.5 rounded-lg cursor-pointer transition-colors text-center" %>
        <%= link_to "Cancelar", admin_usuarios_path,
            class: "flex-1 sm:flex-none text-center border border-gray-300 text-gray-700 text-sm py-2.5 px-5 rounded-lg hover:bg-gray-50 transition-colors" %>
      </div>

    </div>

    <%# ── Barra lateral ── %>
    <div class="space-y-5">

      <%# Card do usuário %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
        <div class="flex flex-col items-center text-center mb-4">
          <div class="w-16 h-16 rounded-full bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white text-2xl font-bold mb-3">
            <%= @usuario.nome.first.upcase %>
          </div>
          <p class="font-semibold text-gray-900"><%= @usuario.nome %></p>
          <p class="text-xs text-gray-500 mt-0.5"><%= @usuario.email %></p>
          <% badge = { "administrador" => "bg-purple-100 text-purple-700", "editor" => "bg-blue-100 text-blue-700", "usuario" => "bg-gray-100 text-gray-600" } %>
          <span class="mt-2 text-xs font-semibold px-2.5 py-0.5 rounded-full <%= badge[@usuario.role] %>">
            <%= @usuario.role.humanize %>
          </span>
        </div>

        <div class="border-t border-gray-100 pt-4 space-y-2.5 text-sm">
          <div class="flex justify-between">
            <span class="text-gray-500">Cadastrado em</span>
            <span class="font-medium text-gray-700"><%= l @usuario.created_at, format: :short %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Artigos</span>
            <span class="font-medium text-gray-700"><%= @usuario.articles.count %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Comentários</span>
            <span class="font-medium text-gray-700"><%= @usuario.comments.count %></span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-500">Status</span>
            <% if @usuario.ativo? %>
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-green-700 bg-green-50 px-2 py-0.5 rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Ativo
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-red-600 bg-red-50 px-2 py-0.5 rounded-full">
                <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Inativo
              </span>
            <% end %>
          </div>
          <% if @usuario.subscription.present? %>
            <div class="flex justify-between">
              <span class="text-gray-500">Assinatura</span>
              <span class="font-medium text-gray-700"><%= @usuario.subscription.status.humanize %></span>
            </div>
          <% end %>
          <% if @usuario.provider.present? %>
            <div class="flex justify-between">
              <span class="text-gray-500">Login via</span>
              <span class="font-medium text-gray-700 capitalize"><%= @usuario.provider %></span>
            </div>
          <% end %>
        </div>
      </div>

      <%# Ações rápidas %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 space-y-2">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-3">Ações</p>

        <%= link_to admin_usuario_path(@usuario), class: "flex items-center gap-2.5 text-sm text-gray-700 hover:bg-gray-50 px-3 py-2.5 rounded-lg transition-colors" do %>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          Ver perfil público
        <% end %>

        <% unless @usuario == current_user %>
          <%= button_to toggle_ativo_admin_usuario_path(@usuario), method: :patch,
              class: "w-full flex items-center gap-2.5 text-sm #{@usuario.ativo? ? 'text-red-600 hover:bg-red-50' : 'text-green-700 hover:bg-green-50'} px-3 py-2.5 rounded-lg transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <% if @usuario.ativo? %>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
              <% else %>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              <% end %>
            </svg>
            <%= @usuario.ativo? ? "Desativar conta" : "Reativar conta" %>
          <% end %>

          <%= button_to admin_usuario_path(@usuario), method: :delete,
              data: { confirm: "Tem certeza? Esta ação não pode ser desfeita." },
              class: "w-full flex items-center gap-2.5 text-sm text-red-600 hover:bg-red-50 px-3 py-2.5 rounded-lg transition-colors" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
            Excluir usuário
          <% end %>
        <% end %>
      </div>

    </div>
  </div>
<% end %>
