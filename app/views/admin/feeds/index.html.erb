<% content_for :page_title, "Feeds RSS" %>
<% content_for :page_subtitle, "Importe notícias de outros sites automaticamente." %>

<div class="space-y-5">

  <%# Resumo %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-gray-400 font-semibold">Fontes ativas</p>
      <p class="text-2xl font-black text-gray-800"><%= @feeds.count(&:ativo?) %></p>
      <p class="text-xs text-gray-400"><%= @feeds.size %> cadastrada(s)</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-gray-400 font-semibold">Matérias importadas</p>
      <p class="text-2xl font-black text-gray-800"><%= @total_importados %></p>
      <p class="text-xs text-gray-400">de feeds RSS</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-100 shadow-sm px-4 py-3">
      <p class="text-[11px] uppercase tracking-wide text-gray-400 font-semibold">Última sincronização</p>
      <p class="text-sm font-bold text-gray-800 mt-1">
        <%= @ultima_sincronizacao ? "#{time_ago_in_words(@ultima_sincronizacao)} atrás" : "Nenhuma ainda" %>
      </p>
      <p class="text-xs text-gray-400">verificação automática a cada minuto</p>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-gray-500">
      O site verifica as fontes ativas a cada minuto e busca somente as que já venceram o intervalo configurado.
    </p>
    <%= link_to new_admin_feed_path, class: "btn-primary text-sm flex items-center gap-1.5 shrink-0" do %>
      <%= lucide_icon "plus", css: "w-4 h-4" %>
      Novo Feed
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
    <div class="flex items-start gap-4">
      <div class="w-10 h-10 rounded-lg bg-violet-50 text-violet-600 flex items-center justify-center shrink-0">
        <%= lucide_icon "sparkles", css: "w-5 h-5" %>
      </div>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-bold text-gray-800">Reprocessar matérias com IA</p>
        <p class="text-xs text-gray-500 mt-0.5">
          Reescreve matérias já importadas que ainda estão com o texto original. As que já foram reescritas e as arquivadas
          ficam de fora, então você pode repetir o processo para continuar do ponto anterior.
          <strong class="text-gray-700"><%= @pendencias_ia %></strong> matéria(s) pendente(s).
        </p>
        <%= form_with url: reprocessar_admin_feeds_path, method: :post, class: "flex flex-wrap items-end gap-3 mt-3" do %>
          <div class="w-full sm:w-56">
            <label class="block text-xs font-medium text-gray-500 mb-1">Fonte</label>
            <%= select_tag :feed_id, options_from_collection_for_select(@feeds, :id, :nome),
                include_blank: "Todas as fontes",
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none" %>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-500 mb-1">Quantidade</label>
            <%= number_field_tag :limite, ReescritaArtigosJob::LIMITE_PADRAO,
                min: 1, max: ReescritaArtigosJob::LIMITE_MAXIMO,
                class: "w-28 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none" %>
          </div>
          <%= submit_tag "Reprocessar com IA",
              data: { turbo_confirm: "Isso vai substituir o texto original das matérias selecionadas pela versão da IA. Continuar?" },
              class: "bg-violet-600 text-white py-2 px-4 rounded-lg text-sm font-semibold hover:bg-violet-700 cursor-pointer" %>
        <% end %>
        <p class="text-[11px] text-gray-400 mt-2">
          Cada matéria leva alguns minutos. O status aparece no badge de cada artigo (Reescrevendo… / Reescrita por IA / IA falhou — revisar).
        </p>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
    <% if @feeds.empty? %>
      <div class="py-14 px-6 text-center">
        <div class="w-12 h-12 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center mx-auto mb-3">
          <%= lucide_icon "rss", css: "w-5 h-5" %>
        </div>
        <p class="text-sm font-semibold text-gray-700">Nenhum feed cadastrado</p>
        <p class="text-xs text-gray-400 mt-1 max-w-md mx-auto">
          Cadastre o endereço do RSS de um site parceiro. Ex.: <span class="font-mono">https://midiaextra.com/feed/</span>
        </p>
        <%= link_to "Cadastrar o primeiro feed", new_admin_feed_path, class: "btn-primary text-sm inline-block mt-4" %>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="text-left px-5 py-3 text-xs font-semibold text-gray-500 uppercase">Fonte</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Categoria</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Intervalo</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Última sincronização</th>
              <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Importados</th>
              <th class="text-right px-5 py-3 text-xs font-semibold text-gray-500 uppercase">Ações</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @feeds.each do |feed| %>
              <% status_classe, status_label =
                   case feed.ultimo_status
                   when "ok"      then [ "bg-green-100 text-green-700", "OK" ]
                   when "parcial" then [ "bg-amber-100 text-amber-700", "Parcial" ]
                   when "erro"    then [ "bg-red-100 text-red-700", "Erro" ]
                   else                [ "bg-gray-100 text-gray-500", "Aguardando" ]
                   end %>
              <tr class="hover:bg-gray-50 align-top">
                <td class="px-5 py-4">
                  <div class="flex items-start gap-2">
                    <span class="mt-0.5 <%= feed.ativo? ? 'text-blue-600' : 'text-gray-300' %>">
                      <%= lucide_icon "rss", css: "w-4 h-4" %>
                    </span>
                    <div class="min-w-0">
                      <p class="font-semibold text-gray-800 flex items-center gap-1.5">
                        <%= feed.nome %>
                        <% unless feed.ativo? %>
                          <span class="text-[10px] font-bold uppercase tracking-wide bg-gray-100 text-gray-500 px-1.5 py-0.5 rounded">pausado</span>
                        <% end %>
                        <% if feed.reescrita_automatica? %>
                          <span class="text-[10px] font-bold uppercase tracking-wide bg-violet-100 text-violet-700 px-1.5 py-0.5 rounded" title="Este feed está configurado para reescrever as matérias com a IA local (quando a reescrita estiver ativa nas configurações)">IA</span>
                        <% end %>
                      </p>
                      <a href="<%= feed.url %>" target="_blank" rel="noopener"
                         class="text-xs text-gray-400 hover:text-blue-600 truncate block max-w-xs"
                         title="<%= feed.url %>"><%= feed.url %></a>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-4 text-gray-600"><%= feed.category&.nome || "—" %></td>
                <td class="px-4 py-4 text-gray-600 whitespace-nowrap"><%= feed.intervalo_label %></td>
                <td class="px-4 py-4">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold px-1.5 py-0.5 rounded <%= status_classe %>"><%= status_label %></span>
                    <span class="text-xs text-gray-500">
                      <%= feed.ultima_sincronizacao_em ? "#{time_ago_in_words(feed.ultima_sincronizacao_em)} atrás" : "nunca" %>
                    </span>
                  </div>
                  <% if feed.ultima_mensagem.present? %>
                    <p class="text-[11px] text-gray-400 mt-1 max-w-56 truncate" title="<%= feed.ultima_mensagem %>">
                      <%= feed.ultima_mensagem %>
                    </p>
                  <% end %>
                </td>
                <td class="px-4 py-4 text-right font-semibold text-gray-700"><%= feed.total_importados %></td>
                <td class="px-5 py-4">
                  <div class="flex items-center justify-end gap-1.5 flex-wrap">
                    <%= button_to "Sincronizar", sincronizar_admin_feed_path(feed), method: :post,
                        class: "text-xs font-semibold text-blue-600 hover:bg-blue-50 border border-blue-200 px-2.5 py-1.5 rounded-lg transition-colors" %>
                    <%= link_to "Editar", edit_admin_feed_path(feed),
                        class: "text-xs font-semibold text-gray-600 hover:bg-gray-100 border border-gray-200 px-2.5 py-1.5 rounded-lg transition-colors" %>
                    <%= button_to feed.ativo? ? "Pausar" : "Ativar", toggle_ativo_admin_feed_path(feed), method: :patch,
                        class: "text-xs font-semibold #{feed.ativo? ? 'text-amber-600 hover:bg-amber-50 border-amber-200' : 'text-green-600 hover:bg-green-50 border-green-200'} border px-2.5 py-1.5 rounded-lg transition-colors" %>
                    <%= button_to "Excluir", admin_feed_path(feed), method: :delete,
                        data: { turbo_confirm: "Remover o feed #{feed.nome}? As matérias já importadas continuam no site." },
                        class: "text-xs font-semibold text-red-600 hover:bg-red-50 border border-red-200 px-2.5 py-1.5 rounded-lg transition-colors" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

</div>
