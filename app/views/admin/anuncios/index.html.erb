<% content_for :page_title, "Anúncios" %>
<% content_for :page_subtitle, "Banners de anúncio direto exibidos no site público." %>

<div class="space-y-6">
  <div class="flex items-center justify-between">
    <p class="text-sm text-gray-500">
      <%= pluralize(@anuncios.count, "anúncio cadastrado", "anúncios cadastrados") %>
    </p>
    <%= link_to new_admin_anuncio_path, class: "btn-primary flex items-center gap-2" do %>
      <%= lucide_icon "plus", css: "w-4 h-4" %>
      Novo Anúncio
    <% end %>
  </div>

  <% if @anuncios.empty? %>
    <div class="card text-center py-16 text-gray-400">
      <%= lucide_icon "megaphone", css: "w-14 h-14 mx-auto mb-4 text-gray-200" %>
      <p class="font-medium text-gray-500">Nenhum anúncio cadastrado</p>
      <p class="text-sm mt-1">Cadastre banners próprios para exibir no site, com prioridade sobre o Google AdSense.</p>
      <%= link_to "Criar primeiro anúncio", new_admin_anuncio_path, class: "mt-4 inline-block btn-primary" %>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
      <% @anuncios.each do |anuncio| %>
        <div class="card overflow-hidden <%= anuncio.ativo? ? '' : 'opacity-60' %>">
          <div class="aspect-video bg-gray-100 flex items-center justify-center overflow-hidden">
            <% if anuncio.imagem.attached? %>
              <%= image_tag url_for(anuncio.imagem), class: "w-full h-full object-contain", alt: anuncio.titulo %>
            <% else %>
              <%= lucide_icon "image", css: "w-10 h-10 text-gray-300" %>
            <% end %>
          </div>
          <div class="p-5">
            <div class="flex items-center gap-2 mb-1">
              <h3 class="text-base font-bold text-gray-900 truncate"><%= anuncio.titulo %></h3>
              <% unless anuncio.ativo? %>
                <span class="text-xs font-semibold text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full shrink-0">Inativo</span>
              <% end %>
            </div>
            <p class="text-xs text-gray-500">
              <span class="font-medium"><%= anuncio.formato.capitalize %></span>
              · <%= anuncio.dimensoes_exigidas %>px
            </p>
            <p class="text-xs text-gray-400 mt-1 truncate"><%= anuncio.url_destino %></p>
            <p class="text-xs text-gray-400 mt-1">
              <%= pluralize(anuncio.cliques, "clique", "cliques") %>
              <% if anuncio.inicio_em || anuncio.fim_em %>
                · <%= anuncio.inicio_em ? l(anuncio.inicio_em, format: :short) : "início imediato" %>
                até <%= anuncio.fim_em ? l(anuncio.fim_em, format: :short) : "sem data final" %>
              <% end %>
            </p>

            <div class="flex items-center gap-2 mt-4">
              <%= link_to edit_admin_anuncio_path(anuncio),
                  class: "flex-1 text-center text-sm font-medium text-blue-700 bg-blue-50 hover:bg-blue-100 px-3 py-1.5 rounded-lg transition-colors" do %>
                Editar
              <% end %>
              <%= button_to admin_anuncio_path(anuncio), method: :delete,
                  form: { data: { turbo_confirm: "Remover o anúncio \"#{anuncio.titulo}\"?" } },
                  class: "p-1.5 rounded-lg text-gray-400 hover:text-red-600 hover:bg-red-50 transition-colors", title: "Excluir" do %>
                <%= lucide_icon "x", css: "w-4 h-4" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
